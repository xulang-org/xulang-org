@main
#ui
#ui/draw
#ui/layout
#ui/widgets

fn contract() int {
    owner := ui.CanvasEvent{window_id: 1,canvas_id: 1,generation: 1}
    bounds := layout.Rect{x: 10.0,y: 20.0,width: 180.0,height: 100.0}
    $event := ui.InputEvent{kind: ui.EV_KEY_DOWN,window_id: 1,canvas_id: 1,generation: 1,x: 30.0,y: 30.0,dx: 0.0,dy: 0.0,button: ui.BUTTON_LEFT,buttons: 0,modifiers: 0,key: ui.KEY_ENTER,scan: 0,repeat: 0,click_count: 0,time_ns: 0}
    $radio := widgets.radio(&owner,1,&bounds,7,false) or >>
    radio.set_focus(true)
    assert(radio.input(&event).kind == widgets.ACTION_NONE)
    event.kind = ui.EV_KEY_UP
    assert(radio.input(&event).kind == widgets.ACTION_CHANGE)
    assert(radio.value() && radio.option() == 7)
    event.kind = ui.EV_KEY_DOWN
    _ := radio.input(&event)
    event.kind = ui.EV_KEY_UP
    assert(radio.input(&event).kind == widgets.ACTION_NONE)
    assert(radio.value())
    $tabs := widgets.tabs(&owner,2,&bounds,3,0) or >>
    tabs.set_focus(true)
    event.kind = ui.EV_KEY_DOWN
    event.key = ui.KEY_RIGHT
    assert(tabs.input(&event).kind == widgets.ACTION_CHANGE)
    assert(tabs.selected() == 1)
    tabs.set_read_only(true)
    _ := tabs.input(&event)
    assert(tabs.selected() == 1)
    tabs.set_read_only(false)
    event.generation = 2
    _ := tabs.input(&event)
    assert(tabs.selected() == 1)
    event.generation = 1
    $list := widgets.list_box(&owner,3,&bounds,12,0) or >>
    list.set_focus(true)
    event.key = ui.KEY_END
    assert(list.input(&event).kind == widgets.ACTION_CHANGE)
    assert(list.selected() == 11 && list.scroll_offset() > 0.0)
    list.set_read_only(true)
    event.key = ui.KEY_HOME
    _ := list.input(&event) or >>
    assert(list.selected() == 11)
    list.set_read_only(false)
    list.set_selected(0) or >>
    event.kind = ui.EV_POINTER_SCROLL
    event.dy = 45.5
    assert(list.input(&event).kind == widgets.ACTION_SCROLL)
    assert(list.scroll_offset() == 45.5)
    event.x = 250.0
    _ := list.input(&event) or >>
    assert(list.scroll_offset() == 45.5)
    event.x = 30.0
    $scroll := widgets.scroll(&owner,4,&bounds,widgets.AXIS_VERTICAL,300.0) or >>
    assert(scroll.input(&event).kind == widgets.ACTION_SCROLL)
    assert(scroll.offset() == 45.5)
    scroll.set_offset(999.0) or >>
    assert(scroll.offset() == 200.0)
    scroll.set_focus(true)
    event.kind = ui.EV_KEY_DOWN
    event.key = ui.KEY_HOME
    _ := scroll.input(&event) or >>
    assert(scroll.offset() == 0.0)
    event.kind = ui.EV_POINTER_CANCEL
    _ := scroll.input(&event) or >>
    event.kind = ui.EV_KEY_DOWN
    event.key = ui.KEY_END
    _ := scroll.input(&event) or >>
    assert(scroll.offset() == 0.0)
    $focus := widgets.focus_group(&owner,[1,2,3]) or >>
    event.key = ui.KEY_TAB
    assert(focus.input(&event).id == 1)
    event.modifiers = ui.MOD_SHIFT
    assert(focus.input(&event).id == 3)
    focus.set_items([1,2]) or >>
    assert(focus.current() == 0)
    $progress := widgets.progress(&bounds,0.0) or >>
    progress.set_value(1.0) or >>
    assert(progress.value() == 1.0)
    progress.set_invalid(true)
    progress.set_focus(true)
    assert(progress.is_invalid() && progress.is_focused())
    progress.set_enabled(false)
    assert(!progress.is_enabled() && !progress.is_focused())
    $card := widgets.card(&bounds) or >>
    card.set_selected(true)
    assert(card.is_selected())
    $badge := widgets.badge(&bounds) or >>
    badge.set_selected(true)
    assert(badge.is_selected())
    context := draw.default_context()
    title := widgets.styled_label(&context,&"Shared label")
    assert(title.text() == "Shared label")
    println("gallery contract passed")
    << 0
}
fn main() int { << contract() or (err) { eprintln(err.msg())
    << 1 } }
