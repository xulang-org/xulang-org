@main

#html
#html/template
#strings

fn esc_text(s string) string {
    t := template.new("{{.}}")
    << template.execute_str(&t, s)
}

fn nav_item(href string, icon string, label string, path &string) string {
    mut cls := "nav-tab-btn"
    p := path + ""
    if p == href {
        cls = "nav-tab-btn active"
    } else {
        if href != "/" && href != "/en" && strings.has_prefix(path, href) {
            cls = "nav-tab-btn active"
        }
    }
    << "<a class=\"" + cls + "\" href=\"" + href + "\"><i class=\"xi " + icon + "\"></i> " + label + "</a>"
}

fn top_nav(path &string, en bool) string {
    mut home := "/"
    mut dl := "/download"
    mut docs := "/docs/start"
    mut api := "/api"
    mut blog := "/blog"
    mut st := "/docs/status"
    mut lab_home := "首页"
    mut lab_dl := "下载"
    mut lab_docs := "文档"
    mut lab_api := "API"
    mut lab_blog := "博客"
    mut lab_st := "现状"
    if en {
        home = "/en"
        dl = "/en/download"
        docs = "/en/docs/start"
        api = "/en/api"
        blog = "/en/blog"
        st = "/en/docs/status"
        lab_home = "Home"
        lab_dl = "Download"
        lab_docs = "Docs"
        lab_blog = "Blog"
        lab_st = "Status"
    }
    mut s := "<nav class=\"nav-tabs\">"
    s = s + nav_item(home, "xi-home", lab_home, path)
    s = s + nav_item(dl, "xi-download", lab_dl, path)
    s = s + nav_item(docs, "xi-book", lab_docs, path)
    s = s + nav_item(api, "xi-api", lab_api, path)
    s = s + nav_item(blog, "xi-chat", lab_blog, path)
    s = s + nav_item(st, "xi-benchmark", lab_st, path)
    s = s + "</nav>"
    << s
}

fn header_html(path &string, en bool) string {
    mut home := "/"
    mut lang_lab := "EN"
    mut lang_title := "English"
    if en {
        home = "/en"
        lang_lab = "中"
        lang_title = "中文"
    }
    mut s := "<header class=\"header-bar\">"
    s = s + "<a class=\"brand-wrapper\" href=\"" + home + "\">"
    s = s + "<img src=\"/xu_classic.svg\" width=\"34\" height=\"34\" alt=\"XU\" class=\"brand-logo-img\">"
    s = s + "<span class=\"brand-title\">XU<span class=\"badge\">v0.1.0</span></span>"
    s = s + "</a>"
    s = s + top_nav(path, en)
    s = s + "<div class=\"header-controls\">"
    s = s + "<a class=\"icon-btn\" href=\"" + other_lang_href(path + "") + "\" title=\"" + lang_title + "\">" + lang_lab + "</a>"
    s = s + "<button type=\"button\" class=\"icon-btn\" id=\"theme-toggle-btn\" title=\"Theme\"><i class=\"xi xi-moon\"></i> <span>Dark</span></button>"
    s = s + "</div>"
    s = s + "</header>"
    << s
}

fn footer_html(en bool) string {
    if en {
        << "<footer class=\"site\"><p><i class=\"xi xi-logo xi-brand\"></i> XU v0.1.0 · MIT License · Zero GC · Supersonic AOT · <a href=\"http://127.0.0.1:8088/\" target=\"_blank\"><i class=\"xi xi-palette\"></i> Design System</a> · <a href=\"http://127.0.0.1:8088/xu_icons.html\" target=\"_blank\"><i class=\"xi xi-code\"></i> XuIcons (145+)</a></p></footer>"
    }
    << "<footer class=\"site\"><p><i class=\"xi xi-logo xi-brand\"></i> XU v0.1.0 · MIT 开源协议 · 坚若磐石 · 零 GC 内存安全 · 超音速 AOT · <a href=\"http://127.0.0.1:8088/\" target=\"_blank\"><i class=\"xi xi-palette\"></i> VI/UI 设计系统</a> · <a href=\"http://127.0.0.1:8088/xu_icons.html\" target=\"_blank\"><i class=\"xi xi-code\"></i> XuIcons 字体图标库 (145+)</a></p></footer>"
}

fn side_link(href string, label string, path &string) string {
    mut cls := ""
    p := path + ""
    if p == href {
        cls = " class=\"on\""
    }
    << "<li><a" + cls + " href=\"" + href + "\">" + label + "</a></li>"
}

fn side_h(icon string, label string) string {
    << "<p class=\"side-h\"><i class=\"xi " + icon + "\"></i> <span>" + label + "</span></p>"
}

