    s = s + side_link(p + "/api/ui/draw", "#ui/draw", path)
    s = s + "</ul></aside>"
    << s
}

fn sidebar_for(path &string, en bool) string {
    r := rest_path(path + "")
    if r == "/api" || strings.has_prefix(&r, "/api/") {
        << sidebar_api(path, en)
    }
    if r == "/docs" || strings.has_prefix(&r, "/docs/") {
        << sidebar_docs(path, en)
    }
    if r == "/blog" || strings.has_prefix(&r, "/blog/") {
        mut p := ""
        if en {
            p = "/en"
        }
        mut s := "<aside class=\"side\"><p class=\"side-h\">Blog</p><ul>"
        s = s + side_link(p + "/blog", "Index", path)
        s = s + side_link(p + "/blog/xu-0-1-0", "Xu 0.1.0", path)
        s = s + "</ul></aside>"
        << s
    }
    << ""
}

fn theme_boot() string {
    << "<script>(function(){var t='';try{t=localStorage.getItem('xu-theme')||'';}catch(e){}if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);})();</script>"
}

fn theme_script() string {
    << "<script>(function(){var k='xu-theme';var b=document.getElementById('theme-toggle-btn');var moon='<i class=\"xi xi-moon\"></i> <span>Dark</span>';var sun='<i class=\"xi xi-sun xi-gold\"></i> <span>Light</span>';function sync(){var t=document.documentElement.getAttribute('data-theme');if(b){if(t==='light'){b.innerHTML=sun;}else{b.innerHTML=moon;}}}if(b){b.onclick=function(){var n='light';if(document.documentElement.getAttribute('data-theme')==='light'){n='dark';}document.documentElement.setAttribute('data-theme',n);try{localStorage.setItem(k,n);}catch(e){}sync();};}sync();})();</script>"
}

fn shell_start(title string, path &string, en bool) string {
    mut lang := "zh-CN"
    if en {
        lang = "en"
    }
    et := esc_text(title)
    mut s := "<!doctype html><html lang=\"" + lang + "\" data-theme=\"dark\"><head>"
    s = s + "<meta charset=\"utf-8\">"
    s = s + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
    s = s + "<title>" + et + "</title>"
    s = s + "<link rel=\"icon\" href=\"/xu_classic.svg\" type=\"image/svg+xml\">"
    s = s + "<link rel=\"stylesheet\" href=\"/fonts/xu-icons.css\">"
    s = s + "<link rel=\"stylesheet\" href=\"/site.css\">"
    s = s + theme_boot()
    s = s + "</head><body>"
    s = s + header_html(path, en)
    << s
}

fn render_home(title string, path string, body string) string {
    en := is_en_path(path + "")
    mut s := shell_start(title, &path, en)
    s = s + "<main class=\"home\">" + body + "</main>"
    s = s + footer_html(en)
    s = s + theme_script()
    s = s + "</body></html>"
    << s
}

fn render_doc(title string, path string, body string) string {
    en := is_en_path(path + "")
    mut s := shell_start(title, &path, en)
    s = s + "<div class=\"page\">"
    s = s + sidebar_for(&path, en)
    mut main_cls := "doc"
    r := rest_path(path + "")
    if r == "/download" {
        main_cls = "doc download"
    }
    s = s + "<main class=\"" + main_cls + "\">" + body + "</main>"
    s = s + "</div>"
    s = s + footer_html(en)
    s = s + theme_script()
    s = s + "</body></html>"
    << s
}
