@main

redis #github.com/xulang-org/packages/redis
memcached #github.com/xulang-org/packages/memcached
nats #github.com/xulang-org/packages/nats
mqtt #github.com/xulang-org/packages/mqtt
elasticsearch #github.com/xulang-org/packages/elasticsearch
s3 #github.com/xulang-org/packages/s3
sqlite #github.com/xulang-org/packages/sqlite
postgres #github.com/xulang-org/packages/postgres
#database/sql
#time

fn verify_redis_pool() {
    println("1. Testing Redis Connection Pool...")
    p := redis.new_pool("127.0.0.1:6379", 5)
    mut c := p.get() or (err) {
        println("   [FAIL] Redis get error: " + err.msg())
        <<
    }
    res := c.ping() or (err) {
        println("   [FAIL] Redis ping error: " + err.msg())
        <<
    }
    println("   Redis PING response: " + res)
    p.put(c)
    p.close()
    println("   [PASS] Redis Pool get/put/close verified.")
}

fn verify_memcached_pool() {
    println("2. Testing Memcached Connection Pool...")
    p := memcached.new_pool("127.0.0.1:11211", 5)
    mut c := p.get() or (err) {
        println("   [FAIL] Memcached get error: " + err.msg())
        <<
    }
    ver := c.version() or (err) {
        println("   [FAIL] Memcached version error: " + err.msg())
        <<
    }
    println("   Memcached VERSION: " + ver)
    p.put(c)
    p.close()
    println("   [PASS] Memcached Pool get/put/close verified.")
}

fn verify_nats_pool() {
    println("3. Testing NATS Connection Pool...")
    p := nats.open_pool("127.0.0.1:4222", 5)
    p.publish("pool.events", "hello from nats pool") or (err) {
        println("   [FAIL] NATS pool publish error: " + err.msg())
        <<
    }
    println("   NATS pool published message successfully.")
    mut c := p.get() or (err) {
        println("   [FAIL] NATS get error: " + err.msg())
        <<
    }
    ok := c.ping() or (err) {
        println("   [FAIL] NATS ping error: " + err.msg())
        <<
    }
    println("   NATS borrowed client ping ok: " + str(ok))
    p.put(c)
    p.close()
    println("   [PASS] NATS Pool get/put/publish/close verified.")
}

fn verify_mqtt_pool() {
    println("4. Testing MQTT Connection Pool...")
    p := mqtt.open_pool("127.0.0.1:1883", "xu_pool_test", 5)
    p.publish("sensors/pool", "temp=28C", 0) or (err) {
        println("   [FAIL] MQTT pool publish error: " + err.msg())
        <<
    }
    println("   MQTT pool published message successfully.")
    mut c := p.get() or (err) {
        println("   [FAIL] MQTT get error: " + err.msg())
        <<
    }
    println("   MQTT borrowed client ID: " + c.client_id)
    p.put(c)
    p.close()
    println("   [PASS] MQTT Pool get/put/publish/close verified.")
}

fn verify_es_pool() {
    println("5. Testing Elasticsearch Connection Pool...")
    p := elasticsearch.open_pool("http://127.0.0.1:9200", 5)
    fd := p.get_conn()
    println("   ES borrowed connection fd: " + str(fd))
    p.put_conn(fd)
    p.close()
    println("   [PASS] Elasticsearch Pool get_conn/put_conn/close verified.")
}

fn verify_s3_pool() {
    println("6. Testing S3 Connection Pool...")
    p := s3.open_pool("http://127.0.0.1:9000", "minioadmin", "minioadmin", "us-east-1", 5)
    fd := p.get_conn()
    println("   S3 borrowed connection fd: " + str(fd))
    p.put_conn(fd)
    p.close()
    println("   [PASS] S3 Pool get_conn/put_conn/close verified.")
}

fn verify_sqlite_pool() {
    println("7. Testing SQLite Connection Pool...")
    mut db := sqlite.open_pool(":memory:", 1, 1)
    db.ping() or (err) {
        println("   [FAIL] SQLite ping error: " + err.msg())
        <<
    }
    db.close() or (err) {
        <<
    }
    println("   [PASS] SQLite Pool ping/close verified.")
}

fn verify_postgres_pool() {
    println("8. Testing PostgreSQL Connection Pool...")
    dsn := "postgres://postgres:secret@127.0.0.1:5432/postgres?sslmode=disable"
    mut db := postgres.open_pool(dsn, 5, 2)
    db.ping() or (err) {
        println("   [FAIL] PostgreSQL ping error: " + err.msg())
        <<
    }
    db.close() or (err) {
        <<
    }
    println("   [PASS] PostgreSQL Pool ping/close verified.")
}

fn main() {
    println("=== Xu All Driver Connection Pools Comprehensive Verification ===\n")
    verify_redis_pool()
    verify_memcached_pool()
    verify_nats_pool()
    verify_mqtt_pool()
    verify_es_pool()
    verify_s3_pool()
    verify_sqlite_pool()
    verify_postgres_pool()
    println("\n[ALL 8 DRIVER CONNECTION POOLS 100% VERIFIED!]")
}
