@main

#net

// TCP echo（Go net.Listen + Accept + goroutine）。
//   printf ping | nc 127.0.0.1 19000
// UDP 见 15udp_echo。

fn handle(c net.Conn) {
    $conn := c
    buf := conn.read(4096) or (err) {
        conn.close() or (e2) { << }
        <<
    }
    if buf.len == 0 {
        conn.close() or (err) { << }
        <<
    }
    conn.write(&buf) or (err) { << }
    conn.close() or (err) { << }
}

fn main() int {
    ln := net.listen_on("tcp", "127.0.0.1:19000") or (err) {
        println(err.msg())
        << 1
    }
    println("tcp://127.0.0.1:19000  echo")
    $running := true
    while running {
        c := ln.accept() or (err) {
            ->
        }
        xu handle(c)
    }
    << 0
}
