@main

#ui
#ui/widgets

fn apply_appearance(m $&Model, screen $&widgets.Screen) int {
    if !m.appearance_dirty{ << 0}
    $styles := widgets.preset_styles(m.theme_index) or >>
    if m.compact{styles.density = 0.85}
    appearance := widgets.screen_appearance(&styles, m.reduced) or >>
    screen.apply_appearance(&appearance) or >>
    primary := styles.button_variant(widgets.BUTTON_PRIMARY) or >>
    screen.set_control_style(m.task, &primary) or >>
    $tree := widgets.tree_appearance()
    tree.guides = m.guided
    screen.set_tree_appearance(m.tree, &tree) or >>
    m.appearance_dirty = false
    << 0
}
