@main

#ui
#ui/widgets
#ui/layout
#time
#math
#errors
demo #"github.com/xulang-org/examples/ui_demo"

struct Model{
    tree int
    name int
    search int
    task int
    cancel int
    table int
    theme int
    guides int
    density int
    effects int
    failure int
    message int
    headings []int
    controls_page int
    work_group int
    basic_group int
    extras []int
    show_controls bool
    theme_index int
    guided bool
    compact bool
    reduced bool
    fail_next bool
    appearance_dirty bool
    task_id int
    completed int
    running bool
    checksum int
    next_work time.Instant
}
fn make_model(screen $&widgets.Screen) Model{
    $name_decoration := widgets.field_decoration(&"Output name")
    name_decoration.helper = "A persistent label, native text selection and IME"
    name_decoration.error = "Enter an output name before building."
    name_decoration.clearable = true
    name := screen.field("", &name_decoration) >>>
    $search_decoration := widgets.field_decoration(&"Find a component")
    search_decoration.helper = "Matching nodes keep their ancestor path"
    search_decoration.clearable = true
    search := screen.field("", &search_decoration) >>>
    tree := screen.tree() >>>
    root := screen.tree_add(tree, - 1, "xu-workbench") >>>
    src := screen.tree_add(tree, root, "src") >>>
    entry := screen.tree_add(tree, src, "main.xu") >>>
    controls := screen.tree_add(tree, src, "widgets") >>>
    for label in["tree_view.xu", "task_button.xu", "field.xu", "table.xu"] {
        node := screen.tree_add(tree, controls, label) >>>
        screen.set_tree_action(tree, node, true) >>>
    }
    manifest := screen.tree_add(tree, root, "xu.xun") >>>
    screen.set_tree_metadata(tree, entry, "entry") >>>
    screen.set_tree_metadata(tree, manifest, "module") >>>
    for node in[root, src, controls] {screen.set_expanded(tree, node, true) >>> }
    task := screen.task_button("Build project") >>>
    screen.set_task_labels(task, "Building", "Built · run again", "Retry build", "Build again") >>>
    table := screen.table(&["Component", "Experience", "Status"], 18, 0) >>>
    screen.set_table_column(table, 0, 144.0, 0.0) >>>
    screen.set_table_column(table, 1, 340.0, 0.0) >>>
    screen.set_table_column(table, 2, 128.0, 0.0) >>>
    names :=["TreeView", "TaskButton", "Field", "Table", "Select", "Popover"]
    details :=["Find and reveal", "Real task progress", "Floating label / native IME", "Resizable columns", "Keyboard choices", "Anchored feedback"]
    for row in 0:18 {
        index := row % 6
        screen.set_cell(table, row, 0, names[index]) >>>
        screen.set_cell(table, row, 1, details[index]) >>>
        screen.set_cell(table, row, 2, "Ready") >>>
    }
    headings :=[screen.label("XUUI / INTERACTION LAB", 12.0, true) >>>,
    screen.label("Precision in every interaction.", 25.0, false) >>>,
    screen.label("WORKSPACE", 12.0, true) >>>, screen.label("BUILD CONFIGURATION", 12.0, true) >>>,
    screen.label("COMPONENTS / scroll, select and sort", 12.0, true) >>>]
    work_group := screen.group() >>>
    basic_group := screen.group() >>>
    for id in[tree, name, search, task, table, headings[2], headings[3], headings[4]] {screen.set_parent(id, work_group) >>> }
    extras := extra_controls(screen) >>>
    for id in extras{screen.set_parent(id, basic_group) >>> }
    cancel := screen.button("Cancel task") >>>
    screen.set_parent(cancel, work_group) >>>
    controls_page := screen.button("All controls") >>>
    styles := screen.styles()
    primary_style := styles.button_variant(widgets.BUTTON_PRIMARY) >>>
    screen.set_control_style(task, &primary_style) >>>
    << Model{tree: tree, name: name, search: search, task: task, cancel: cancel,
        table: table, theme: screen.button("Theme") >>>, guides: screen.button("Tree guides") >>>,
        density: screen.button("Density") >>>, effects: screen.button("Motion") >>>, failure: screen.button("Fail next build") >>>,
        message: screen.label("Local work batches report completed items. No simulated percentage clock.", 13.0, true) >>>,
        headings: headings, controls_page: controls_page, work_group: work_group, basic_group: basic_group, extras: extras, show_controls: false, theme_index: 1, guided: false, compact: false, reduced: false, fail_next: false, appearance_dirty: true,
        task_id: 0, completed: 0, running: false, checksum: 0, next_work: time.zero_instant()}
}
fn (m &Model) layout(screen $&widgets.Screen) int {
    width := screen.width()
    height := screen.height()
    left := 310.0
    screen.place(m.headings[0], 28.0, 24.0, width - 56.0, 22.0) >>>
    screen.place(m.headings[1], 28.0, 54.0, width - 56.0, 36.0) >>>
    buttons :=[m.theme, m.guides, m.density, m.effects, m.failure, m.controls_page]
    for i in 0:buttons.len{screen.place(buttons[i], 28.0 + f64(i) * 144.0, 111.0, 132.0, 36.0) >>> }
    screen.set_visible(m.work_group, !m.show_controls) >>>
    screen.set_visible(m.basic_group, m.show_controls) >>>
    screen.set_selected_button(m.controls_page, m.show_controls) >>>
    extra_layout(screen, &m.extras) >>>
    screen.set_selected_button(m.guides, m.guided) >>>
    screen.set_selected_button(m.effects, m.reduced) >>>
    screen.set_selected_button(m.failure, m.fail_next) >>>
    screen.place(m.headings[2], 28.0, 173.0, left - 24.0, 24.0) >>>
    screen.place(m.search, 28.0, 208.0, left - 24.0, 80.0) >>>
    screen.place(m.tree, 28.0, 302.0, left - 24.0, height - 352.0) >>>
    x := left + 36.0
    right_width := width - x - 28.0
    screen.place(m.headings[3], x, 173.0, right_width, 24.0) >>>
    screen.place(m.name, x, 208.0, right_width, 86.0) >>>
    screen.place(m.task, x, 307.0, 230.0, 40.0) >>>
    screen.place(m.cancel, x + 246.0, 307.0, 136.0, 40.0) >>>
    screen.set_enabled(m.cancel, m.running) >>>
    screen.place(m.headings[4], x, 377.0, right_width, 24.0) >>>
    screen.place(m.table, x, 413.0, right_width, height - 493.0) >>>
    screen.place(m.message, 28.0, height - 41.0, width - 56.0, 24.0) >>>
    << 0
}
fn (m $&Model) work(screen $&widgets.Screen, now time.Instant) int {
    if !m.running || now.before(m.next_work) { << 0}
    // Each progress update follows an actual bounded work batch. The pause
    // represents an application work queue and never changes the percentage.
    for i in 0:5000 {m.checksum =(m.checksum + i *(m.completed + 1)) % 1000003}
    m.completed = m.completed + 1
    _ := screen.set_task_progress(m.task, m.task_id, f64(m.completed) / 48.0) >>>
    m.next_work = now.add(time.milliseconds(35) >>>) >>>
    if m.fail_next && m.completed == 18 {
        _ := screen.complete_task(m.task, m.task_id, widgets.TASK_ERROR) >>>
        m.running = false
        m.fail_next = false
        screen.set_text(m.message, "Example failure. Retry starts a new task; stale progress is rejected.") >>>
    } else if m.completed == 48 {
        _ := screen.complete_task(m.task, m.task_id, widgets.TASK_SUCCESS) >>>
        m.running = false
        screen.set_text(m.message, "48/48 work batches completed · checksum " + str(m.checksum)) >>>
    }
    << 0
}
fn extra_controls(screen $&widgets.Screen)[]int {
    $ids :=[]int {}
    ids.push(screen.card() >>>)
    ids.push(screen.label("CONTROLS / keyboard, pointer and state", 12.0, true) >>>)
    ids.push(screen.checkbox("Keep generated files", true) >>>)
    ids.push(screen.switch_control("Live preview", true) >>>)
    ids.push(screen.radio("Use workspace settings", 1, true) >>>)
    ids.push(screen.slider(0.0, 100.0, 40.0) >>>)
    ids.push(screen.stepper(1.0, 16.0, 1.0, 4.0) >>>)
    ids.push(screen.tabs(&["Files", "History", "Output"], 0) >>>)
    ids.push(screen.segmented(&["Desktop", "Tablet", "Phone"], 0) >>>)
    ids.push(screen.select_box(&["Xu source", "Configuration", "Plain text"], 0) >>>)
    ids.push(screen.list_box(&["Compiler", "Widgets", "Runtime", "Desktop", "Examples", "Tooling"], 0) >>>)
    ids.push(screen.progress(0.62) >>>)
    ids.push(screen.badge("Ready") >>>)
    ids.push(screen.divider(widgets.AXIS_HORIZONTAL) >>>)
    ids.push(screen.radio_group(&["Use local build", "Use cached build", "Build dependencies"], 0) >>>)
    ids.push(screen.input("Native input · 中文") >>>)
    ids.push(screen.text_area("A multi-line editor.\nSelection, clipboard and native IME remain available.") >>>)
    ids.push(screen.date_picker(time.date(2026, 10, 25, 10, 30, 0, 0)) >>>)
    ids.push(screen.time_picker(time.date(2026, 10, 25, 10, 30, 0, 0)) >>>)
    ids.push(screen.button("Queue notification") >>>)
    _ := screen.tooltip(ids[19], "Repeated notifications queue; hover or focus pauses expiry.") >>>
    screen.set_slider_commit_only(ids[5], true) >>>
    screen.set_checkbox_indeterminate(ids[2], true) >>>
    screen.set_select_option_enabled(ids[9], 2, false) >>>
    screen.set_badge_tone(ids[12], widgets.BADGE_SUCCESS) >>>
    screen.set_progress_buffer(ids[11], 0.84) >>>
    screen.set_date_options(ids[17], time.date(2026, 10, 25, 0, 0, 0, 0), true) >>>
    screen.set_clock_format(ids[18], true, true) >>>
    << ids
}
fn extra_layout(screen $&widgets.Screen, ids &[]int) int {
    gap := 28.0
    width :=(screen.width() - 84.0) * 0.5
    right := 56.0 + width
    screen.place(ids[0], gap, 628.0, width, 112.0) >>>
    screen.place(ids[1], gap, 173.0, screen.width() - 56.0, 24.0) >>>
    for i in 2:5 {screen.place(ids[i], gap, 211.0 + f64(i - 2) * 46.0, width, 36.0) >>> }
    screen.place(ids[5], gap, 357.0, width - 136.0, 36.0) >>>
    screen.place(ids[6], gap + width - 124.0, 357.0, 124.0, 36.0) >>>
    screen.place(ids[7], gap, 412.0, width, 36.0) >>>
    screen.place(ids[8], gap, 466.0, width, 36.0) >>>
    screen.place(ids[11], gap, 522.0, width - 120.0, 12.0) >>>
    screen.place(ids[12], gap + width - 100.0, 510.0, 100.0, 32.0) >>>
    screen.place(ids[13], gap, 607.0, width, 1.0) >>>
    screen.place(ids[14], right, 211.0, width, 126.0) >>>
    screen.place(ids[9], right, 357.0, width, 36.0) >>>
    screen.place(ids[10], right, 412.0, width, 158.0) >>>
    screen.place(ids[15], right, 590.0, width, 36.0) >>>
    screen.place(ids[16], right, 644.0, width, 96.0) >>>
    screen.place(ids[17], gap, 560.0,(width - 16.0) * 0.5, 36.0) >>>
    screen.place(ids[18], gap +(width + 16.0) * 0.5, 560.0,(width - 16.0) * 0.5, 36.0) >>>
    screen.place(ids[19], gap + 16.0, 665.0, width - 32.0, 38.0) >>>
    << 0
}
fn next_event(events chan ui.Event, deadline time.Instant) ui.Event{
    if deadline.is_zero() { << <- events}
    delay := deadline.since(time.instant())
    if delay.nanoseconds() <= 0 { << ui.Event{kind: ui.EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}}
    timer := delay.timer()
    select {
        event := <- events{timer.stop()
            << event}
        _ := <- timer.c{timer.stop()}
    }
    << ui.Event{kind: ui.EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
}
fn scene(events chan ui.Event) int {
    ready := demo.ready(events) >>>
    if ready.kind == ui.EV_EXIT{ << 0}
    $screen := widgets.screen(&ready) >>>
    screen.resize(1000.0, 820.0) >>>
    screen.set_min_size(900, 720) >>>
    $model := make_model($&screen) >>> (err) {screen.dispose()
        >> err}
    apply_appearance($&model, $&screen) >>>
    model.layout($&screen) >>>
    _ := screen.render() >>>
    $dispatcher := register_actions(&model, &screen) >>>
    while screen.is_open() {
        now := time.instant()
        apply_appearance($&model, $&screen) >>>
        register_notices(&screen, $&dispatcher) >>>
        model.work($&screen, now) >>>
        model.layout($&screen) >>>
        $deadline := screen.advance(now) >>> (err) { >> errors.new("gallery animation: " + err.msg())}
        for action in screen.take_actions() {_ := dispatcher.dispatch(&action, $&model, $&screen) >>> }
        apply_appearance($&model, $&screen) >>>
        _ := screen.render() >>> (err) { >> errors.new("gallery render: " + err.msg())}
        if model.running &&(deadline.is_zero() || model.next_work.before(deadline)) {deadline = model.next_work}
        event := next_event(events, deadline) >>>
        $actions := screen.event(&event) >>>
        $count := 0
        while screen.is_open() && count < 128 {
            pending := ui.poll_chan(events)
            if pending.kind == ui.EV_NONE{ <- }
            more := screen.event(&pending) >>>
            for action in more{actions.push(action)}
            count += 1
        }
        for action in actions{_ := dispatcher.dispatch(&action, $&model, $&screen) >>> }
    }
    screen.dispose()
    << 0
}
fn worker(events chan ui.Event) {scene(events) >>> (err) {demo.fail(err.msg())
        << }}
fn launch() int {
    $app := demo.app("XUUI / Interaction Lab", 1000, 820) >>>
    xu worker(app.event_ch)
    << app.run() >>>
}
fn main() int { << launch() >>> (err) {eprintln(err.msg())
        << 1}}
