@main

#ui
#ui/webview

fn route(name string, payload string) string {
    if name == "ping" {
        << "pong:" + payload
    }
    if name == "greet" {
        << "hello, " + payload
    }
    if name == "menu" {
        << "menu:" + payload
    }
    if name == "tray" {
        << "tray:" + payload
    }
    if name == "shell" {
        << "shell:" + payload
    }
    if name == "win" {
        if payload == "hide" {
            _ := ui.native_hide() or (err) { << "err" }
            << "hidden"
        }
        if payload == "show" {
            _ := ui.native_show() or (err) { << "err" }
            << "shown"
        }
        if payload == "minimize" {
            _ := ui.native_minimize() or (err) { << "err" }
            << "minimized"
        }
        if payload == "reload" {
            _ := webview.native_reload() or (err) { << "err" }
            << "reloaded"
        }
        if payload == "float" {
            _ := ui.native_set_floating(1) or (err) { << "err" }
            << "floating"
        }
        if payload == "unfloat" {
            _ := ui.native_set_floating(0) or (err) { << "err" }
            << "unfloated"
        }
        if payload == "fullscreen" {
            _ := ui.native_set_fullscreen(1) or (err) { << "err" }
            << "fullscreen"
        }
        if payload == "unfullscreen" {
            _ := ui.native_set_fullscreen(0) or (err) { << "err" }
            << "unfullscreen"
        }
        if payload == "center" {
            _ := ui.native_center() or (err) { << "err" }
            << "centered"
        }
        if payload == "devtools" {
            _ := webview.native_open_devtools() or (err) { << "err" }
            << "devtools"
        }
        if payload == "zoom_in" {
            _ := webview.native_set_zoom(125) or (err) { << "err" }
            << "zoom 125%"
        }
        if payload == "zoom_out" {
            _ := webview.native_set_zoom(80) or (err) { << "err" }
            << "zoom 80%"
        }
        if payload == "zoom_100" {
            _ := webview.native_set_zoom(100) or (err) { << "err" }
            << "zoom 100%"
        }
        if payload == "open_ext" {
            _ := ui.native_open_external("https://example.com") or (err) { << "err" }
            << "opened browser"
        }
        if payload == "clip_set" {
            _ := ui.native_clipboard_set("hello from Xu") or (err) { << "err" }
            << "clipboard set"
        }
        if payload == "clip_get" {
            _ := ui.native_clipboard_get()
            << "clipboard:posted"
        }
        if payload == "back" {
            _ := webview.native_go_back() or (err) { << "err" }
            << "back"
        }
        if payload == "forward" {
            _ := webview.native_go_forward() or (err) { << "err" }
            << "forward"
        }
        if payload == "stop" {
            _ := webview.native_stop() or (err) { << "err" }
            << "stop"
        }
        if payload == "maximize" {
            _ := ui.native_set_maximized(1) or (err) { << "err" }
            << "maximized"
        }
        if payload == "unmaximize" {
            _ := ui.native_set_maximized(0) or (err) { << "err" }
            << "unmaximized"
        }
        if payload == "bounce" {
            _ := ui.native_bounce() or (err) { << "err" }
            << "bounce"
        }
        if payload == "pick" {
            _ := ui.native_pick_file()
            << "pick:posted"
        }
        if payload == "save" {
            _ := ui.native_save_file("xu-note.txt")
            << "save:posted"
        }
        if payload == "print" {
            _ := webview.native_print() or (err) { << "err" }
            << "print"
        }
        if payload == "opacity_low" {
            _ := ui.native_set_opacity(70) or (err) { << "err" }
            << "opacity 70%"
        }
        if payload == "opacity_full" {
            _ := ui.native_set_opacity(100) or (err) { << "err" }
            << "opacity 100%"
        }
        if payload == "shot" {
            _ := ui.native_screenshot()
            << "shot:posted"
        }
        if payload == "alert" {
            _ := ui.native_alert("Xu", "Hello from alert")
            << "alert:posted"
        }
        if payload == "confirm" {
            _ := ui.native_confirm("Xu", "Continue?")
            << "confirm:posted"
        }
        if payload == "notify" {
            _ := ui.native_notify("Xu", "Desktop notification")
            << "notified"
        }
        if payload == "folder" {
            _ := ui.native_pick_folder()
            << "folder:posted"
        }
        if payload == "minsize" {
            _ := ui.native_set_min_size(480, 320) or (err) { << "err" }
            << "minsize 480x320"
        }
        if payload == "lock_size" {
            _ := ui.native_set_resizable(0) or (err) { << "err" }
            << "not resizable"
        }
        if payload == "unlock_size" {
            _ := ui.native_set_resizable(1) or (err) { << "err" }
            << "resizable"
        }
        if payload == "eval_result" {
            r := webview.native_eval_result("1+2+3")
            << "eval:" + r
        }
        if payload == "find" {
            r := webview.native_find("WebView")
            << "find:" + str(r)
        }
        if payload == "find_clear" {
            _ := webview.native_find_clear()
            << "find cleared"
        }
        if payload == "bounds" {
            _ := ui.native_get_bounds()
            << "bounds:posted"
        }
        if payload == "ua" {
            _ := webview.native_set_user_agent("XuWebView/1.0")
            << "ua set"
        }
        if payload == "css" {
            _ := webview.native_inject_css("body{outline:3px solid #e11d48 !important}")
            << "css injected"
        }
        if payload == "titlebar_hide" {
            _ := ui.native_set_titlebar_visible(0)
            << "titlebar hidden"
        }
        if payload == "titlebar_show" {
            _ := ui.native_set_titlebar_visible(1)
            << "titlebar shown"
        }
        if payload == "guard_on" {
            _ := ui.native_set_close_guard(1)
            << "close guard on — try red close / Quit (dialog)"
        }
        if payload == "guard_off" {
            _ := ui.native_set_close_guard(0)
            << "close guard off"
        }
        if payload == "accept_close" {
            _ := ui.native_accept_close()
            << "accepting close"
        }
        if payload == "reject_close" {
            _ := ui.native_reject_close()
            << "close rejected"
        }
        if payload == "clear_cache" {
            _ := webview.native_clear_cache()
            << "clearing cache"
        }
        if payload == "state" {
            _ := ui.native_get_state()
            << "state:posted"
        }
        if payload == "all_spaces" {
            _ := ui.native_set_visible_on_all_spaces(1)
            << "all spaces on"
        }
        if payload == "mute" {
            _ := webview.native_set_muted(1)
            << "muted"
        }
        if payload == "unmute" {
            _ := webview.native_set_muted(0)
            << "unmuted"
        }
        if payload == "bg" {
            _ := webview.native_set_background("#dc2626")
            << "bg #dc2626"
        }
        if payload == "bg2" {
            _ := webview.native_set_background("#2563eb")
            << "bg #2563eb"
        }
        if payload == "reveal_shot" {
            _ := write_file(ui.host_tmp() + "/xu_ui_shot_follow.txt", "reveal") or (err) {
                << "err"
            }
            _ := ui.native_screenshot()
            << "reveal_shot:posted"
        }
        if payload == "open_shot" {
            _ := write_file(ui.host_tmp() + "/xu_ui_shot_follow.txt", "open") or (err) {
                << "err"
            }
            _ := ui.native_screenshot()
            << "open_shot:posted"
        }
        if payload == "dark" {
            _ := ui.native_set_appearance("dark")
            << "appearance dark"
        }
        if payload == "light" {
            _ := ui.native_set_appearance("light")
            << "appearance light"
        }
        if payload == "ctx_off" {
            _ := webview.native_set_context_menu(0)
            << "context menu off"
        }
        if payload == "ctx_on" {
            _ := webview.native_set_context_menu(1)
            << "context menu on"
        }
        if payload == "badge" {
            _ := ui.native_set_dock_badge("3")
            << "dock badge 3"
        }
        if payload == "badge_clear" {
            _ := ui.native_set_dock_badge("")
            << "dock badge cleared"
        }
        if payload == "shot_clip" {
            _ := ui.native_screenshot_to_clipboard()
            << "shot_clip:posted"
        }
        if payload == "shadow_off" {
            _ := ui.native_set_shadow(0)
            << "shadow off"
        }
        if payload == "shadow_on" {
            _ := ui.native_set_shadow(1)
            << "shadow on"
        }
        if payload == "magnify_off" {
            _ := webview.native_set_magnification(0)
            << "magnify off"
        }
        if payload == "magnify_on" {
            _ := webview.native_set_magnification(1)
            << "magnify on"
        }
        if payload == "cookie_set" {
            _ := webview.native_cookie_set("xu_demo", "1", "127.0.0.1")
            << "cookie set"
        }
        if payload == "cookies_get" {
            c := webview.native_cookies_get()
            << "cookies:\n" + c
        }
        if payload == "cookies_clear" {
            _ := webview.native_cookies_clear()
            << "cookies clearing"
        }
        << "win:" + payload
    }
    << "unknown:" + name
}

fn demo_www() string {
    // Pack oneexe: force in-PE www (never stage developer/... or TEMP/www).
    if env_get("XU_UI_WWW") == ":mem:" || env_get("XU_UI_PACK") == "1" {
        << ":mem:"
    }
    << "www"
}

fn pack_trace(step string) {
    // Pack has no xu_ui TMP dir; skip disk breadcrumbs (console / XU_UI_LOG still work).
    d := env_get("XU_UI_TMP")
    if d.len == 0 || d == ":xu:" {
        <<
    }
    _ := write_file(d + "/xu_main_trace.txt", step + "\n") or (err) {
        <<
    }
}

fn ipc_boot(emit_ch chan string, shell_ch chan ui.Event) {
    webview.bind_ipc_www(demo_www(), route, emit_ch, shell_ch) or (err) {
        eprintln(err.msg())
        <<
    }
}

fn tick_loop(emit_ch chan string) {
    $n := 0
    while true {
        // Short sleeps so a blocked/mis-scheduled task cannot sit on a 2s nanosleep
        // that starves sibling work if threading is ever wrong. Emit only — no
        // native_eval/title on this loop (those jam the AppKit main thread).
        sleep_ns(200000000)
        n = n + 1
        if n % 10 == 0 {
            webview.bus_emit(emit_ch, "tick", str(n / 10))
        }
    }
}

// Native app.run blocks main; shell events arrive on event_ch from #ui's host pump.
fn watch_shell(shell_ch chan ui.Event, emit_ch chan string) {
    while true {
        ev := <-shell_ch
        if ev.kind == ui.EV_PROGRESS {
            ->
        }
        // Result-bearing shell ops → XUN emit (same post protocol as invoke).
        if ev.kind == ui.EV_CLIPBOARD {
            webview.bus_emit(emit_ch, "clipboard", ev.menu_id + "")
        } else if ev.kind == ui.EV_FILE_PICKED {
            webview.bus_emit(emit_ch, "file_picked", ev.menu_id + "")
        } else if ev.kind == ui.EV_FILE_SAVED {
            webview.bus_emit(emit_ch, "file_saved", ev.menu_id + "")
        } else if ev.kind == ui.EV_FOLDER_PICKED {
            webview.bus_emit(emit_ch, "folder_picked", ev.menu_id + "")
        } else if ev.kind == ui.EV_SCREENSHOT {
            p := ev.menu_id + ""
            webview.bus_emit(emit_ch, "screenshot", p + "")
            // reveal_shot / open_shot: follow-up after shell event (post protocol).
            follow := shot_follow_take()
            if follow == "reveal" && p.len > 0 {
                _ := ui.native_reveal_path(p + "")
            } else if follow == "open" && p.len > 0 {
                _ := ui.native_open_path(p + "")
            }
        } else if ev.kind == ui.EV_ALERT {
            webview.bus_emit(emit_ch, "alert", ev.menu_id + "")
        } else if ev.kind == ui.EV_CONFIRM {
            webview.bus_emit(emit_ch, "confirm", ev.menu_id + "")
        } else if ev.kind == ui.EV_BOUNDS {
            webview.bus_emit(emit_ch, "bounds", ev.menu_id + "")
        } else if ev.kind == ui.EV_STATE {
            webview.bus_emit(emit_ch, "state", ev.menu_id + "")
        } else if ev.kind == ui.EV_NOTIFY {
            webview.bus_emit(emit_ch, "notify", ev.menu_id + "")
        }
        if ev.kind == ui.EV_MENU_CLICKED {
            println("shell event menu_clicked id=" + ev.menu_id)
        } else if ev.kind == ui.EV_TRAY_MENU_CLICKED {
            println("shell event tray_menu_clicked id=" + ev.menu_id)
        } else if ev.kind == ui.EV_CLOSED {
            println("shell event closed")
        } else if ev.kind == ui.EV_EXIT {
            println("shell event exit")
        } else if ev.kind == ui.EV_CLOSE_REQUESTED {
            println("shell event close_requested")
        } else if ev.kind == ui.EV_FILE_PICKED {
            println("shell event file_picked " + ev.menu_id)
        } else if ev.kind == ui.EV_CLIPBOARD {
            println("shell event clipboard")
        } else if ev.kind == ui.EV_BOUNDS {
            println("shell event bounds " + ev.menu_id)
        } else if ev.kind == ui.EV_STATE {
            println("shell event state " + ev.menu_id)
        }
    }
}

fn shot_follow_take() string {
    path := ui.host_tmp() + "/xu_ui_shot_follow.txt"
    body := read_file(path) or (err) {
        << ""
    }
    _ := write_file(path, "") or (err) {
        << body
    }
    << body
}

fn soft_install_tray() int {
    $tray_items := []ui.MenuItem{}
    tray_items.push(ui.menu_item("show", "Show"))
    tray_items.push(ui.menu_item("hide", "Hide"))
    tray_items.push(ui.menu_item("quit", "Quit"))
    a := ui.install_tray("Xu", ui.menu(tray_items)) or (err) {
        pack_trace("install_tray soft-fail: " + err.msg())
        << 0
    }
    b := ui.install_tray_icon("brand/xu_app_logo.png") or (err) {
        pack_trace("install_tray_icon soft-fail: " + err.msg())
        << 0
    }
    << a + b
}

fn main() int {
    emit_ch := chan string{cap: 64}
    // Large cap: host floods progress/moved/focus during load; a full channel
    // blocks the IPC worker on `shell_ch <-` and delays invoke by ~1s.
    shell_ch := chan ui.Event{cap: 4096}
    $app := ui.new_app_events(shell_ch)
    pack_trace("main begin")
    app.set_icon(ui.icon_from_file("brand/xu_app_logo.png"))
    // Stage www before the window so host xu://app/ load is not empty.
    webview.stage_www_root(demo_www()) or (err) {
        pack_trace("stage_www_root fail: " + err.msg())
        println(err.msg())
        << 1
    }
    pack_trace("stage_www_root ok")
    xu watch_shell(shell_ch, emit_ch)
    xu ipc_boot(emit_ch, shell_ch)
    xu tick_loop(emit_ch)
    pack_trace("xu tasks spawned")
    sleep_ns(50000000)
    $win := app.new_window(ui.WindowOpts{title: "Xu WebView IPC", width: 800, height: 560})
    $menu_items := []ui.MenuItem{}
    menu_items.push(ui.menu_item("about", "About"))
    menu_items.push(ui.menu_item("quit", "Quit"))
    win.set_menu(ui.menu(menu_items))
    soft_install_tray()
    app.new_tray(ui.TrayOpts{tip: "Xu", icon: ui.icon_default(), menu: ui.menu([]ui.MenuItem{})})
    r := $&win
    $wv := webview.attach(r)
    pack_trace("webview.attach ok")
    wv.on("ping")
    wv.on("greet")
    wv.load_url(webview.app_scheme_url()) or (err) {
        pack_trace("load_url fail: " + err.msg())
        println(err.msg())
        << 1
    }
    pack_trace("before app.run")
    println("shell events on App.event_ch / xu://app/ (XUN IPC)")
    app.run() or (err) {
        pack_trace("app.run fail: " + err.msg())
        println(err.msg())
        << 1
    }
    pack_trace("window closed")
    println("window closed")
    << 0
}
