@main
#ui
#ui/draw
#ui/widgets
#ui/layout
demo #"github.com/xulang-org/examples/ui_demo"

// IDs follow the stable topology created below. All control bounds are local;
// Editor.place receives the separate canvas rectangle for native IME geometry.
struct Model {
    theme widgets.Button
    scale widgets.Button
    density widgets.Button
    brand widgets.Button
    disabled widgets.Button
    check widgets.Checkbox
    toggle widgets.Switch
    radio_a widgets.Radio
    radio_b widgets.Radio
    slider widgets.Slider
    stepper widgets.Stepper
    tabs widgets.Tabs
    select_ctrl widgets.Select
    badge widgets.Badge
    divider widgets.Divider
    card widgets.Card
    list widgets.ListBox
    input widgets.Editor
    invalid widgets.Editor
    read_only widgets.Editor
    area widgets.Editor
    progress widgets.Progress
    scroll widgets.Scroll
    context draw.Context
    icon draw.Image
    switcher widgets.StyleSwitcher
    theme_label widgets.StyledLabel
    scale_label widgets.StyledLabel
    density_label widgets.StyledLabel
    brand_label widgets.StyledLabel
    disabled_label widgets.StyledLabel
    check_label widgets.StyledLabel
    toggle_label widgets.StyledLabel
    radio_a_label widgets.StyledLabel
    radio_b_label widgets.StyledLabel
    stepper_label widgets.StyledLabel
    badge_label widgets.StyledLabel
    divider_label widgets.StyledLabel
    card_label widgets.StyledLabel
    tab_label widgets.StyledLabel
    tab_2_label widgets.StyledLabel
    tab_3_label widgets.StyledLabel
    select_label widgets.StyledLabel
    list_label widgets.StyledLabel
    list_2_label widgets.StyledLabel
    list_3_label widgets.StyledLabel
    list_4_label widgets.StyledLabel
}
fn (m &mut Model) measure_node(id int,s &widgets.Styles) layout.Size {
    if id == 4 { control := m.theme
        label := mut &m.theme_label
        << control.measure_styled(label,s) or >> }
    if id == 5 { control := m.scale
        label := mut &m.scale_label
        << control.measure_styled(label,s) or >> }
    if id == 6 { control := m.density
        label := mut &m.density_label
        << control.measure_styled(label,s) or >> }
    if id == 8 { control := m.brand
        label := mut &m.brand_label
        << control.measure_icon_styled(label,s) or >> }
    if id == 9 { control := m.disabled
        label := mut &m.disabled_label
        << control.measure_styled(label,s) or >> }
    if id == 10 { control := m.check
        label := mut &m.check_label
        << control.measure_styled(label,s) or >> }
    if id == 11 { control := m.progress
        << control.measure_styled(s) or >> }
    if id == 12 { control := mut &m.input
        << control.measure_styled(s) or >> }
    if id == 13 { control := mut &m.invalid
        << control.measure_styled(s) or >> }
    if id == 14 { control := mut &m.read_only
        << control.measure_styled(s) or >> }
    if id == 15 { control := mut &m.area
        << control.measure_styled(s) or >> }
    if id == 32 { control := m.toggle
        label := mut &m.toggle_label
        << control.measure_styled(label,s) or >> }
    if id == 33 { control := m.radio_a
        label := mut &m.radio_a_label
        << control.measure_styled(label,s) or >> }
    if id == 34 { control := m.radio_b
        label := mut &m.radio_b_label
        << control.measure_styled(label,s) or >> }
    if id == 35 { control := m.slider
        << control.measure_styled(s) or >> }
    if id == 36 { control := m.stepper
        label := mut &m.stepper_label
        << control.measure_styled(label,s) or >> }
    if id == 37 { control := m.badge
        label := mut &m.badge_label
        << control.measure_styled(label,s) or >> }
    if id == 38 { control := m.divider
        label := mut &m.divider_label
        << control.measure_labeled_styled(label,s) or >> }
    if id == 40 { control := m.tabs
        label := mut &m.tab_label
        << control.measure_styled(label,s) or >> }
    if id == 41 { control := m.select_ctrl
        label := mut &m.select_label
        << control.measure_styled(label,s) or >> }
    if id == 42 { control := m.card
        label := mut &m.card_label
        << control.measure_header_styled(label,s) or >> }
    if id == 43 { control := m.list
        label := mut &m.list_label
        << control.measure_styled(label,s) or >> }
    << layout.Size{width: 0.0,height: 0.0}
}
fn (m &mut Model) measure_styled(id int,s &widgets.Styles) layout.Size {
    << m.measure_node(id,s) or (err) { eprintln(err.msg())
        << layout.Size{width: -1.0,height: -1.0} }
}
fn (m &mut Model) draw_node(id int,b &layout.Rect,s &widgets.Styles,f &mut draw.Frame) int {
    if id == 4 { target := mut &m.theme
        target.set_bounds(b) or >>
        control := m.theme
        label := mut &m.theme_label
        control.paint_styled(f,label,s) or >> }
    if id == 5 { target := mut &m.scale
        target.set_bounds(b) or >>
        control := m.scale
        label := mut &m.scale_label
        control.paint_styled(f,label,s) or >> }
    if id == 6 { target := mut &m.density
        target.set_bounds(b) or >>
        control := m.density
        label := mut &m.density_label
        control.paint_styled(f,label,s) or >> }
    if id == 8 { target := mut &m.brand
        target.set_bounds(b) or >>
        control := m.brand
        icon := m.icon
        label := mut &m.brand_label
        control.paint_icon_styled(f,label,&icon,s) or >> }
    if id == 9 { target := mut &m.disabled
        target.set_bounds(b) or >>
        control := m.disabled
        label := mut &m.disabled_label
        control.paint_styled(f,label,s) or >> }
    if id == 10 { target := mut &m.check
        target.set_bounds(b) or >>
        control := m.check
        label := mut &m.check_label
        control.paint_styled(f,label,s) or >> }
    if id == 12 { control := mut &m.input
        control.paint_styled(f,s) or >> }
    if id == 13 { control := mut &m.invalid
        control.paint_styled(f,s) or >> }
    if id == 14 { control := mut &m.read_only
        control.paint_styled(f,s) or >> }
    if id == 15 { control := mut &m.area
        control.paint_styled(f,s) or >> }
    if id == 11 { control := mut &m.progress
        control.set_bounds(b) or >>
        control.paint_styled(f,s) or >> }
    if id == 32 { target := mut &m.toggle
        target.set_bounds(b) or >>
        control := m.toggle
        label := mut &m.toggle_label
        control.paint_styled(f,label,s) or >> }
    if id == 33 { target := mut &m.radio_a
        target.set_bounds(b) or >>
        control := m.radio_a
        label := mut &m.radio_a_label
        control.paint_styled(f,label,s) or >> }
    if id == 34 { target := mut &m.radio_b
        target.set_bounds(b) or >>
        control := m.radio_b
        label := mut &m.radio_b_label
        control.paint_styled(f,label,s) or >> }
    if id == 35 { target := mut &m.slider
        target.set_bounds(b) or >>
        control := m.slider
        control.paint_styled(f,s) or >> }
    if id == 36 { target := mut &m.stepper
        target.set_bounds(b) or >>
        control := m.stepper
        label := mut &m.stepper_label
        control.paint_styled(f,label,s) or >> }
    if id == 37 { target := mut &m.badge
        target.set_bounds(b) or >>
        control := m.badge
        label := mut &m.badge_label
        control.paint_styled(f,label,s) or >> }
    if id == 38 { target := mut &m.divider
        target.set_bounds(b) or >>
        control := m.divider
        label := mut &m.divider_label
        control.paint_labeled_styled(f,label,s) or >> }
    if id == 40 { target := mut &m.tabs
        target.set_bounds(b) or >>
        control := m.tabs
        control.paint_box_styled(f,s) or >>
        l0 := mut &m.tab_label
        control.paint_tab_styled(f,0,l0,s) or >>
        l1 := mut &m.tab_2_label
        control.paint_tab_styled(f,1,l1,s) or >>
        l2 := mut &m.tab_3_label
        control.paint_tab_styled(f,2,l2,s) or >> }
    if id == 41 { target := mut &m.select_ctrl
        target.set_bounds(b) or >>
        control := m.select_ctrl
        label := mut &m.select_label
        control.paint_styled(f,label,s) or >> }
    if id == 42 { target := mut &m.card
        target.set_bounds(b) or >>
        control := m.card
        label := mut &m.card_label
        control.paint_header_styled(f,label,s) or >>
        demo.text(&m.context,f,14.0 * s.density,42.0 * s.density,11.0 * s.text_scale,s.button.palette.muted,"Card body") or >> }
    if id == 43 { target := mut &m.list
        target.set_bounds(b) or >>
        control := m.list
        control.paint_box_styled(f,s) or >>
        r0 := mut &m.list_label
        control.paint_item_styled(f,0,r0,s) or >>
        r1 := mut &m.list_2_label
        control.paint_item_styled(f,1,r1,s) or >>
        r2 := mut &m.list_3_label
        control.paint_item_styled(f,2,r2,s) or >>
        r3 := mut &m.list_4_label
        control.paint_item_styled(f,3,r3,s) or >> }
    if id == 2 {
        demo.text(&m.context,f,0.0,0.0,24.0,s.button.palette.foreground,"A theme that reaches every control") or >>
        demo.text(&m.context,f,0.0,33.0,13.0,s.button.palette.muted,"Light / dark / contrast · typography · density · local overrides · no idle redraw") or >>
    }
    if id >= 18 && id <= 29 {
        f.fill_rect(0.0,0.0,b.width,b.height,s.input.palette.normal) or >>
        demo.text(&m.context,f,12.0,5.0,14.0,s.input.palette.foreground,"Scrollable item " + str(id - 17) + "   —   wheel, drag the thumb, or Page Down") or >>
    }
    if id == 30 {
        demo.text(&m.context,f,0.0,0.0,12.0,s.button.palette.muted,"The green button keeps its own font and palette. Error and read-only fields are distinct states.") or >>
        demo.text(&m.context,f,0.0,21.0,12.0,s.button.palette.muted,"Tab / Shift+Tab to move focus · copy from read-only text · Escape to quit") or >>
    }
    << 0
}
fn (m &mut Model) paint_styled(id int,b &layout.Rect,s &widgets.Styles,f &mut draw.Frame) bool {
    m.draw_node(id,b,s,f) or (err) { eprintln(err.msg())
        << false }
    << true
}
fn (m &mut Model) overlay_styled(id int,b &layout.Rect,s &widgets.Styles,f &mut draw.Frame) bool {
    if id == 16 { control := mut &m.scroll
        control.paint_scrollbar(f,s) or (err) { eprintln(err.msg())
            << false } }
    << true
}
fn (m &mut Model) input(id int,kind int,event &ui.InputEvent) widgets.Action {
    if id == 4 { control := mut &m.theme
        << control.route(kind,event) or >> }
    if id == 5 { control := mut &m.scale
        << control.route(kind,event) or >> }
    if id == 6 { control := mut &m.density
        << control.route(kind,event) or >> }
    if id == 8 { control := mut &m.brand
        << control.route(kind,event) or >> }
    if id == 9 { control := mut &m.disabled
        << control.route(kind,event) or >> }
    if id == 10 { control := mut &m.check
        << control.route(kind,event) or >> }
    if id == 12 { control := mut &m.input
        << control.route(kind,event) or >> }
    if id == 13 { control := mut &m.invalid
        << control.route(kind,event) or >> }
    if id == 14 { control := mut &m.read_only
        << control.route(kind,event) or >> }
    if id == 15 { control := mut &m.area
        << control.route(kind,event) or >> }
    if id == 16 { control := mut &m.scroll
        << control.route(kind,event) or >> }
    if id == 32 { control := mut &m.toggle
        << control.route(kind,event) or >> }
    if id == 33 { control := mut &m.radio_a
        << control.route(kind,event) or >> }
    if id == 34 { control := mut &m.radio_b
        << control.route(kind,event) or >> }
    if id == 35 { control := mut &m.slider
        << control.route(kind,event) or >> }
    if id == 36 { control := mut &m.stepper
        << control.route(kind,event) or >> }
    if id == 40 { control := mut &m.tabs
        << control.route(kind,event) or >> }
    if id == 41 { control := mut &m.select_ctrl
        << control.route(kind,event) or >> }
    if id == 43 { control := mut &m.list
        << control.route(kind,event) or >> }
    << widgets.Action{kind: 0,id: id,needs_paint: false,request_focus: false,consumed: false,value: 0.0}
}
fn (m &mut Model) place(view &mut widgets.View) int {
    input := mut &m.input
    widgets.place_editor(view,input) or >>
    invalid := mut &m.invalid
    widgets.place_editor(view,invalid) or >>
    read_only := mut &m.read_only
    widgets.place_editor(view,read_only) or >>
    area := mut &m.area
    widgets.place_editor(view,area) or >>
    bounds := view.node_bounds(16) or >>
    styles := view.styles_for(16) or >>
    control := mut &m.scroll
    control.set_bounds(&layout.Rect{x: 0.0,y: 0.0,width: bounds.width,height: bounds.height}) or >>
    control.apply_styles(&styles) or >>
    view.set_scroll(16,0.0,control.offset()) or >>
    << 0
}
fn (m &mut Model) native_event(view &mut widgets.View,event &ui.Event) int {
    input := mut &m.input
    action_12 := input.event(event) or >>
    if action_12.needs_paint { view.mark_paint(12) or >> }
    invalid := mut &m.invalid
    action_13 := invalid.event(event) or >>
    if action_13.needs_paint { view.mark_paint(13) or >> }
    read_only := mut &m.read_only
    action_14 := read_only.event(event) or >>
    if action_14.needs_paint { view.mark_paint(14) or >> }
    area := mut &m.area
    action_15 := area.event(event) or >>
    if action_15.needs_paint { view.mark_paint(15) or >> }
    << 0
}
fn (m &mut Model) acknowledge() {
    theme := mut &m.theme
    theme.painted()
    scale := mut &m.scale
    scale.painted()
    density := mut &m.density
    density.painted()
    brand := mut &m.brand
    brand.painted()
    disabled := mut &m.disabled
    disabled.painted()
    check := mut &m.check
    check.painted()
    input := mut &m.input
    input.painted()
    invalid := mut &m.invalid
    invalid.painted()
    read_only := mut &m.read_only
    read_only.painted()
    area := mut &m.area
    area.painted()
    progress := mut &m.progress
    progress.painted()
    scroll := mut &m.scroll
    scroll.painted()
    toggle := mut &m.toggle
    toggle.painted()
    radio_a := mut &m.radio_a
    radio_a.painted()
    radio_b := mut &m.radio_b
    radio_b.painted()
    slider := mut &m.slider
    slider.painted()
    stepper := mut &m.stepper
    stepper.painted()
    tabs := mut &m.tabs
    tabs.painted()
    select_ctrl := mut &m.select_ctrl
    select_ctrl.painted()
    badge := mut &m.badge
    badge.painted()
    divider := mut &m.divider
    divider.painted()
    card := mut &m.card
    card.painted()
    list := mut &m.list
    list.painted()
}
fn (m &mut Model) cleanup() {
    icon := mut &m.icon
    icon.dispose() or (err) { eprintln(err.msg())
        << }
    theme_label := mut &m.theme_label
    theme_label.dispose()
    scale_label := mut &m.scale_label
    scale_label.dispose()
    density_label := mut &m.density_label
    density_label.dispose()
    brand_label := mut &m.brand_label
    brand_label.dispose()
    disabled_label := mut &m.disabled_label
    disabled_label.dispose()
    check_label := mut &m.check_label
    check_label.dispose()
    toggle_label := mut &m.toggle_label
    toggle_label.dispose()
    radio_a_label := mut &m.radio_a_label
    radio_a_label.dispose()
    radio_b_label := mut &m.radio_b_label
    radio_b_label.dispose()
    stepper_label := mut &m.stepper_label
    stepper_label.dispose()
    badge_label := mut &m.badge_label
    badge_label.dispose()
    divider_label := mut &m.divider_label
    divider_label.dispose()
    card_label := mut &m.card_label
    card_label.dispose()
    tab_label := mut &m.tab_label
    tab_label.dispose()
    tab_2_label := mut &m.tab_2_label
    tab_2_label.dispose()
    tab_3_label := mut &m.tab_3_label
    tab_3_label.dispose()
    select_label := mut &m.select_label
    select_label.dispose()
    list_label := mut &m.list_label
    list_label.dispose()
    list_2_label := mut &m.list_2_label
    list_2_label.dispose()
    list_3_label := mut &m.list_3_label
    list_3_label.dispose()
    list_4_label := mut &m.list_4_label
    list_4_label.dispose()
    input := mut &m.input
    input.dispose()
    invalid := mut &m.invalid
    invalid.dispose()
    read_only := mut &m.read_only
    read_only.dispose()
    area := mut &m.area
    area.dispose()
}
fn leaf(view &mut widgets.View,parent int,width f64,height f64) int {
    style := layout.box_style(layout.box_leaf)
    << view.add(parent,&style,&layout.Size{width: width,height: height}) or >>
}
fn brand_scope(view &mut widgets.View) int {
    mut brand := widgets.light_styles()
    brand.button.palette.normal = draw.rgb(10,91,69)
    brand.button.palette.hovered = draw.rgb(17,120,90)
    brand.button.palette.pressed = draw.rgb(7,65,49)
    brand.button.palette.foreground = draw.rgb(255,255,255)
    brand.button.font.size = 17.0
    brand.button.font.weight = 600
    brand.button.inherit_font = false
    brand.button.radius = 18.0
    brand.button.icon_size = 22.0
    brand.button.icon_placement = widgets.icon_trailing
    mut hover := widgets.state_paint(widgets.state_hovered)
    hover.unless = widgets.state_disabled
    hover.fields = widgets.paint_foreground | widgets.paint_border
    hover.foreground = draw.rgb(209,250,229)
    hover.border = draw.rgb(110,231,183)
    brand.button.states = [hover]
    brand.button.shadow = draw.rgba(0,0,0,90)
    brand.button.shadow_y = 2.0
    brand.button.shadow_blur = 3.0
    view.set_style_scope(8,&brand) or >>
    << 0
}
fn (m &mut Model) handle_action(view &mut widgets.View,action &widgets.Action) int {
    if action.kind == widgets.action_activate {
        if action.id == 4 {
            switcher := mut &m.switcher
            _ := switcher.cycle(view) or >>
        }
        if action.id == 5 {
            switcher := mut &m.switcher
            mut next_scale := 1.4
            if switcher.text_scale() != 1.0 { next_scale = 1.0 }
            switcher.set_text_scale(next_scale) or >>
            switcher.apply(view) or >>
        }
        if action.id == 6 {
            switcher := mut &m.switcher
            mut next_density := 0.8
            if switcher.density() != 1.0 { next_density = 1.0 }
            switcher.set_density(next_density) or >>
            switcher.apply(view) or >>
        }
        if action.id == 41 {
            sel := mut &m.select_ctrl
            next_opt := (sel.selected() + 1) % 3
            sel.set_selected(next_opt) or >>
            sel.set_open(false)
            lbl := mut &m.select_label
            if next_opt == 0 { lbl.set_text(&"Option: Auto") }
            if next_opt == 1 { lbl.set_text(&"Option: Manual") }
            if next_opt == 2 { lbl.set_text(&"Option: Locked") }
            view.mark_measure(41) or >>
            view.mark_paint(41) or >>
        }
    }
    if action.id == 16 && action.kind == widgets.action_scroll { view.set_scroll(16,0.0,action.value) or >> }
    if action.kind == widgets.action_change {
        if action.id == 32 {
            bdg := mut &m.badge
            bdg.set_selected(action.value > 0.5)
            blbl := mut &m.badge_label
            if action.value > 0.5 { blbl.set_text(&"Active") } else { blbl.set_text(&"Paused") }
            view.mark_measure(37) or >>
            view.mark_paint(37) or >>
        }
        if action.id == 33 {
            rb := mut &m.radio_b
            rb.set_value(false)
            view.mark_paint(34) or >>
        }
        if action.id == 34 {
            ra := mut &m.radio_a
            ra.set_value(false)
            view.mark_paint(33) or >>
        }
        if action.id == 35 {
            prog := mut &m.progress
            prog.set_value(action.value / 100.0) or >>
            view.mark_paint(11) or >>
        }
        if action.id == 36 {
            lbl := mut &m.stepper_label
            lbl.set_text(&str(int(action.value)))
            view.mark_measure(36) or >>
            prog := mut &m.progress
            prog.set_value(action.value / 100.0) or >>
            view.mark_paint(11) or >>
        }
        if action.id == 40 {
            clbl := mut &m.card_label
            if action.value == 0.0 { clbl.set_text(&"Card · Overview") }
            if action.value == 1.0 { clbl.set_text(&"Card · Tokens") }
            if action.value == 2.0 { clbl.set_text(&"Card · Segmented") }
            view.mark_measure(42) or >>
            view.mark_paint(42) or >>
        }
        if action.id == 41 {
            lbl := mut &m.select_label
            if action.value == 0.0 { lbl.set_text(&"Option: Auto") }
            if action.value == 1.0 { lbl.set_text(&"Option: Manual") }
            if action.value == 2.0 { lbl.set_text(&"Option: Locked") }
            view.mark_measure(41) or >>
            view.mark_paint(41) or >>
        }
        if action.id == 43 {
            clbl := mut &m.card_label
            clbl.set_text(&("Card · Row " + str(int(action.value) + 1)))
            view.mark_measure(42) or >>
            view.mark_paint(42) or >>
        }
    }
    << 0
}
fn scene(ech chan ui.Event) int {
    ready := demo.ready(ech) or >>
    if ready.kind == ui.ev_exit { << 0 }
    identity := ui.canvas_of(&ready) or >>
    context := draw.context_of(&ready) or >>
    host := widgets.Host{context: context,identity: identity}
    mut column := layout.box_style(layout.box_column)
    column.padding = layout.insets(22.0) or >>
    column.gap = 10.0
    column.cross_alignment = layout.cross_stretch
    mut view := host.view(&column,draw.rgb(20,25,34)) or >>
    _ := leaf(mut &view,1,400.0,56.0) or >> // 2 header
    mut row := layout.box_style(layout.box_row)
    row.gap = 12.0
    row.cross_alignment = layout.cross_center
    _ := view.add(1,&row,&layout.Size{width: 0.0,height: 0.0}) or >> // 3 toolbar
    for i in 0:3 { _ := leaf(mut &view,3,0.0,0.0) or >> } // 4..6
    _ := view.add(1,&row,&layout.Size{width: 0.0,height: 0.0}) or >> // 7 controls
    for i in 0:3 { _ := leaf(mut &view,7,0.0,0.0) or >> } // 8..10
    _ := leaf(mut &view,1,300.0,12.0) or >> // 11 progress
    for i in 0:4 { _ := leaf(mut &view,1,300.0,0.0) or >> } // 12..15 editors
    mut viewport := layout.box_style(layout.box_column)
    viewport.height = 84.0
    viewport.clip = true
    viewport.cross_alignment = layout.cross_stretch
    _ := view.add(1,&viewport,&layout.Size{width: 0.0,height: 0.0}) or >> // 16 scroll
    mut items := layout.box_style(layout.box_column)
    items.gap = 6.0
    items.cross_alignment = layout.cross_stretch
    _ := view.add(16,&items,&layout.Size{width: 0.0,height: 0.0}) or >> // 17 items
    for i in 0:12 { _ := leaf(mut &view,17,300.0,28.0) or >> } // 18..29
    _ := leaf(mut &view,1,400.0,42.0) or >> // 30 footer
    _ := view.add(1,&row,&layout.Size{width: 0.0,height: 0.0}) or >> // 31 extended controls row 1
    for i in 0:6 { _ := leaf(mut &view,31,0.0,0.0) or >> } // 32..37: switch, radio_a, radio_b, slider, stepper, badge
    _ := leaf(mut &view,1,300.0,0.0) or >> // 38 labeled divider
    _ := view.add(1,&row,&layout.Size{width: 0.0,height: 0.0}) or >> // 39 extended controls row 2
    for i in 0:4 { _ := leaf(mut &view,39,0.0,0.0) or >> } // 40..43: tabs, select, card, list_box
    for id in [2,4,5,6,8,9,10,11,12,13,14,15,16,30,32,33,34,35,36,37,38,40,41,42,43] { view.set_boundary(id,true) or >> }
    for id in [4,5,6,8,10,12,13,14,15,16,32,33,34,35,36,40,41,43] { view.set_input(id,true,true) or >> }
    view.set_capture_outside(16,true) or >>
    view.set_capture_outside(35,true) or >>
    for id in [4,5,6,8,9,10,11,12,13,14,15,32,33,34,35,36,37,38,40,41,42,43] { view.set_style_measure(id,true) or >> }
    empty := layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}
    mut m := Model{theme: widgets.button(&identity,4,&empty) or >>,scale: widgets.button(&identity,5,&empty) or >>,
        density: widgets.button(&identity,6,&empty) or >>,brand: widgets.button(&identity,8,&empty) or >>,
        disabled: widgets.button(&identity,9,&empty) or >>,check: widgets.checkbox(&identity,10,&empty,true) or >>,
        toggle: widgets.switch_control(&identity,32,&empty,true) or >>,
        radio_a: widgets.radio(&identity,33,&empty,0,true) or >>,
        radio_b: widgets.radio(&identity,34,&empty,1,false) or >>,
        slider: widgets.slider(&identity,35,&empty,0.0,100.0,64.0) or >>,
        stepper: widgets.stepper(&identity,36,&empty,0.0,100.0,5.0,65.0) or >>,
        tabs: widgets.tabs(&identity,40,&empty,3,0) or >>,
        select_ctrl: widgets.select_box(&identity,41,&empty,3,0) or >>,
        badge: widgets.badge(&empty) or >>,
        divider: widgets.divider(&empty,widgets.axis_horizontal) or >>,
        card: widgets.card(&empty) or >>,
        list: widgets.list_box(&identity,43,&empty,4,0) or >>,
        input: widgets.input(&context,&identity,12,&empty,&"Editable input · 你好 Xu") or >>,
        invalid: widgets.input(&context,&identity,13,&empty,&"Invalid value — custom error colors") or >>,
        read_only: widgets.input(&context,&identity,14,&empty,&"Read-only · select and copy, edits are ignored") or >>,
        area: widgets.text_area(&context,&identity,15,&empty,&"TextArea uses the same font, padding and selection theme.\nIME, preedit and caret geometry follow typography changes.") or >>,
        progress: widgets.progress(&empty,0.64) or >>,scroll: widgets.scroll(&identity,16,&empty,widgets.axis_vertical,402.0) or >>,
        context: context,icon: context.load_embedded_image(&"logo.png") or >>,switcher: widgets.style_switcher(),
        theme_label: widgets.styled_label(&context,&"Theme: dark / light / contrast"),
        scale_label: widgets.styled_label(&context,&"Text: 100% / 140%"),
        density_label: widgets.styled_label(&context,&"Density: normal / compact"),
        brand_label: widgets.styled_label(&context,&"Local green"),
        disabled_label: widgets.styled_label(&context,&"Disabled"),
        check_label: widgets.styled_label(&context,&"Checkbox"),
        toggle_label: widgets.styled_label(&context,&"Switch"),
        radio_a_label: widgets.styled_label(&context,&"Radio A"),
        radio_b_label: widgets.styled_label(&context,&"Radio B"),
        stepper_label: widgets.styled_label(&context,&"65"),
        badge_label: widgets.styled_label(&context,&"Active"),
        divider_label: widgets.styled_label(&context,&"Navigation & Data Components"),
        card_label: widgets.styled_label(&context,&"Card Panel"),
        tab_label: widgets.styled_label(&context,&"Overview"),
        tab_2_label: widgets.styled_label(&context,&"Tokens"),
        tab_3_label: widgets.styled_label(&context,&"Themes"),
        select_label: widgets.styled_label(&context,&"Option: Auto"),
        list_label: widgets.styled_label(&context,&"1 · Buttons"),
        list_2_label: widgets.styled_label(&context,&"2 · Editors"),
        list_3_label: widgets.styled_label(&context,&"3 · Surfaces"),
        list_4_label: widgets.styled_label(&context,&"4 · Controls")}
    badge_ref := mut &m.badge
    badge_ref.set_selected(true)
    disabled := mut &m.disabled
    disabled.set_enabled(false)
    invalid := mut &m.invalid
    invalid.set_invalid(true)
    read_only := mut &m.read_only
    read_only.set_read_only(true) or >>
    m.switcher.apply(mut &view) or >>
    brand_scope(mut &view) or >>
    mut width := 960.0
    mut height := 820.0
    mut event := ui.Event{kind: ui.ev_none,window_id: 0,menu_id: "",width: 0,height: 0}
    // Drain input bursts before painting. Native text snapshots already hold
    // the latest revision; rendering each queued key would fill the frame queue.
    while true {
        if event.kind == ui.ev_none {
            constraints := layout.tight(width,height) or >>
            _ := widgets.layout_styled(mut &view,&constraints,mut &m) or >>
            m.place(mut &view) or >>
            if widgets.present_styled(mut &view,&constraints,mut &m) or >> { m.acknowledge() }
            event = demo.next(ech)
        }
        if event.kind == ui.ev_exit { <- }
        if event.window_id == identity.window_id {
            if event.kind == ui.ev_canvas_closed || event.kind == ui.ev_closed { <- }
            if event.kind == ui.ev_canvas_metrics { metrics := ui.metrics_of(&event) or >>
                width = metrics.width
                height = metrics.height }
            actions := widgets.dispatch_event(mut &view,&event,mut &m) or >>
            m.native_event(mut &view,&event) or >>
            for action in actions { m.handle_action(mut &view,&action) or >> }
            if ui.is_input_event(event.kind) { input := ui.input_of(&event) or >>
                if input.kind == ui.ev_key_down && input.key == ui.key_escape {
                    view.dispose()
                    if demo.alive(&identity) { m.cleanup() }
                    demo.quit() or >>
                    << 0
                } }
        }
        event = ui.poll_chan(ech)
    }
    view.dispose()
    if demo.alive(&identity) { m.cleanup() }
    << 0
}
fn worker(ech chan ui.Event) { scene(ech) or (err) { demo.fail(err.msg())
    << } }
fn main() int {
    mut app := demo.app("Xu UI / Style Gallery",960,820) or (err) { eprintln(err.msg())
        << 1 }
    xu worker(app.event_ch)
    << app.run() or (err) { eprintln(err.msg())
        << 1 }
}
