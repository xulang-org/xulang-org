@main
#ui
#ui/draw
#ui/widgets
#ui/layout
#time
demo #"github.com/xulang-org/examples/ui_demo"

// IDs follow the stable topology created below. All control bounds are local;
// Editor.place receives the separate canvas rectangle for native IME geometry.
struct Model{
    theme widgets.Button
    scale widgets.Button
    density widgets.Button
    brand widgets.Button
    disabled widgets.Button
    check widgets.Checkbox
    toggle widgets.Switch
    radio_a widgets.Radio
    radio_b widgets.Radio
    slider widgets.Slider
    stepper widgets.Stepper
    tabs widgets.Tabs
    select_ctrl widgets.Select
    select_origin layout.Rect
    select_popup_armed bool
    transitions []widgets.PaintTransition
    switch_motion widgets.Tween
    popup_motion widgets.Tween
    clock time.Instant
    reduced_motion bool
    theme_index int
    text_scale f64
    density_scale f64
    appearance_dirty bool
    badge widgets.Badge
    divider widgets.Divider
    card widgets.Card
    list widgets.ListBox
    input widgets.Editor
    invalid widgets.Editor
    read_only widgets.Editor
    area widgets.Editor
    progress widgets.Progress
    scroll widgets.Scroll
    context draw.Context
    icon draw.Image
    switcher widgets.StyleSwitcher
    theme_label widgets.StyledLabel
    scale_label widgets.StyledLabel
    density_label widgets.StyledLabel
    brand_label widgets.StyledLabel
    disabled_label widgets.StyledLabel
    check_label widgets.StyledLabel
    toggle_label widgets.StyledLabel
    radio_a_label widgets.StyledLabel
    radio_b_label widgets.StyledLabel
    stepper_label widgets.StyledLabel
    badge_label widgets.StyledLabel
    divider_label widgets.StyledLabel
    card_label widgets.StyledLabel
    tab_label widgets.StyledLabel
    tab_2_label widgets.StyledLabel
    tab_3_label widgets.StyledLabel
    select_label widgets.StyledLabel
    option_auto widgets.StyledLabel
    option_manual widgets.StyledLabel
    option_locked widgets.StyledLabel
    list_label widgets.StyledLabel
    list_2_label widgets.StyledLabel
    list_3_label widgets.StyledLabel
    list_4_label widgets.StyledLabel
}
fn (m $&Model) motion_style(id int, base &widgets.ControlStyle, state int) widgets.ControlStyle{
    now := m.clock
    reduced := m.reduced_motion
    motion := $&m.transitions[id]
    << motion.style(base, state, now, reduced) >>>
}
fn (m $&Model) tick(view $&widgets.View, now time.Instant) int {
    m.clock = now
    reduced := m.reduced_motion
    for id in 1:m.transitions.len{
        motion := $&m.transitions[id]
        if reduced && motion.is_animating() {motion.finish()
            view.mark_paint(id) >>> }
        else if motion.advance(now) >>> {view.mark_paint(id) >>> }
    }
    $selected := 0.0
    if m.toggle.value() {selected = 1.0}
    switch_motion := $&m.switch_motion
    before_switch := switch_motion.value()
    switch_motion.retarget(selected, now, time.milliseconds(180) >>>, reduced) >>>
    if before_switch != switch_motion.value() {view.mark_paint(32) >>> }
    $opened := 0.0
    if m.select_ctrl.is_open() {opened = 1.0}
    popup_motion := $&m.popup_motion
    before_popup := popup_motion.value()
    $popup_duration := time.milliseconds(130) >>>
    if opened == 0.0 {popup_duration = time.milliseconds(95) >>> }
    popup_motion.retarget(opened, now, popup_duration, reduced) >>>
    if before_popup != popup_motion.value() {view.mark_paint(1) >>> }
    input := $&m.input
    if input.tick(now, reduced) >>> {view.mark_paint(12) >>> }
    invalid := $&m.invalid
    if invalid.tick(now, reduced) >>> {view.mark_paint(13) >>> }
    read_only := $&m.read_only
    if read_only.tick(now, reduced) >>> {view.mark_paint(14) >>> }
    area := $&m.area
    if area.tick(now, reduced) >>> {view.mark_paint(15) >>> }
    << 0
}
fn (m &Model) next_frame(now time.Instant) time.Instant{
    if m.switch_motion.is_animating() || m.popup_motion.is_animating() { << now.add(time.milliseconds(16) >>>) >>> }
    for motion in m.transitions{if motion.is_animating() { << now.add(time.milliseconds(16) >>>) >>> }}
    $deadline := time.zero_instant()
    for next in[m.input.next_caret_tick(now, m.reduced_motion) >>>, m.invalid.next_caret_tick(now, m.reduced_motion) >>>,
    m.read_only.next_caret_tick(now, m.reduced_motion) >>>, m.area.next_caret_tick(now, m.reduced_motion) >>>] {
        if !next.is_zero() &&(deadline.is_zero() || next.before(deadline)) {deadline = next}
    }
    << deadline
}
fn (m &Model) next_event(ech chan ui.Event) ui.Event{
    deadline := m.next_frame(time.instant()) >>>
    while true {
        event := ui.poll_chan(ech)
        if event.kind != ui.EV_NONE{ << event}
        if !deadline.is_zero() && !time.instant().before(deadline) { << event}
        pause := time.milliseconds(8) >>>
        pause.sleep()
    }
    << ui.Event{kind: ui.EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
}
fn (m $&Model) measure_node(id int, s &widgets.Styles) layout.Size{
    if id == 4 {control := m.theme.clone()
        label := $&m.theme_label
        << control.measure_styled(label, s) >>> }
    if id == 5 {control := m.scale.clone()
        label := $&m.scale_label
        << control.measure_styled(label, s) >>> }
    if id == 6 {control := m.density.clone()
        label := $&m.density_label
        << control.measure_styled(label, s) >>> }
    if id == 8 {control := m.brand.clone()
        label := $&m.brand_label
        << control.measure_icon_styled(label, s) >>> }
    if id == 9 {control := m.disabled.clone()
        label := $&m.disabled_label
        << control.measure_styled(label, s) >>> }
    if id == 10 {control := m.check.clone()
        label := $&m.check_label
        << control.measure_styled(label, s) >>> }
    if id == 11 {control := m.progress.clone()
        << control.measure_styled(s) >>> }
    if id == 12 {control := $&m.input
        << control.measure_styled(s) >>> }
    if id == 13 {control := $&m.invalid
        << control.measure_styled(s) >>> }
    if id == 14 {control := $&m.read_only
        << control.measure_styled(s) >>> }
    if id == 15 {control := $&m.area
        << control.measure_styled(s) >>> }
    if id == 32 {control := m.toggle.clone()
        label := $&m.toggle_label
        << control.measure_styled(label, s) >>> }
    if id == 33 {control := m.radio_a.clone()
        label := $&m.radio_a_label
        << control.measure_styled(label, s) >>> }
    if id == 34 {control := m.radio_b.clone()
        label := $&m.radio_b_label
        << control.measure_styled(label, s) >>> }
    if id == 35 {control := m.slider.clone()
        << control.measure_styled(s) >>> }
    if id == 36 {control := m.stepper.clone()
        label := $&m.stepper_label
        << control.measure_styled(label, s) >>> }
    if id == 37 {control := m.badge.clone()
        label := $&m.badge_label
        << control.measure_styled(label, s) >>> }
    if id == 38 {control := m.divider.clone()
        label := $&m.divider_label
        << control.measure_labeled_styled(label, s) >>> }
    if id == 40 {control := m.tabs.clone()
        label := $&m.tab_label
        << control.measure_styled(label, s) >>> }
    if id == 41 {control := m.select_ctrl.clone()
        label := $&m.select_label
        << control.measure_styled(label, s) >>> }
    if id == 42 {control := m.card.clone()
        label := $&m.card_label
        << control.measure_header_styled(label, s) >>> }
    if id == 43 {control := m.list.clone()
        label := $&m.list_label
        << control.measure_styled(label, s) >>> }
    << layout.Size{width: 0.0, height: 0.0}
}
fn (m $&Model) measure_styled(id int, s &widgets.Styles) layout.Size{
    << m.measure_node(id, s) >>> (err) {eprintln(err.msg())
        << layout.Size{width: - 1.0, height: - 1.0}}
}
fn (m $&Model) draw_node(id int, b &layout.Rect, s &widgets.Styles, f $&draw.Frame) int {
    if id == 4 {target := $&m.theme
        target.set_bounds(b) >>>
        $control := m.theme.clone()
        base := control.style_or(s)
        appearance := m.motion_style(4, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.theme_label
        control.paint_styled(f, label, s) >>> }
    if id == 5 {target := $&m.scale
        target.set_bounds(b) >>>
        $control := m.scale.clone()
        base := control.style_or(s)
        appearance := m.motion_style(5, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.scale_label
        control.paint_styled(f, label, s) >>> }
    if id == 6 {target := $&m.density
        target.set_bounds(b) >>>
        $control := m.density.clone()
        base := control.style_or(s)
        appearance := m.motion_style(6, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.density_label
        control.paint_styled(f, label, s) >>> }
    if id == 8 {target := $&m.brand
        target.set_bounds(b) >>>
        $control := m.brand.clone()
        base := control.style_or(s)
        appearance := m.motion_style(8, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        icon := m.icon
        label := $&m.brand_label
        control.paint_icon_styled(f, label, &icon, s) >>> }
    if id == 9 {target := $&m.disabled
        target.set_bounds(b) >>>
        $control := m.disabled.clone()
        base := control.style_or(s)
        appearance := m.motion_style(9, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.disabled_label
        control.paint_styled(f, label, s) >>> }
    if id == 10 {target := $&m.check
        target.set_bounds(b) >>>
        $control := m.check.clone()
        base := control.style_or(s)
        appearance := m.motion_style(10, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.check_label
        control.paint_styled(f, label, s) >>> }
    if id == 12 {
        now := m.clock
        reduced := m.reduced_motion
        $motion := m.transitions[12]
        control := $&m.input
        control.paint_motion_styled(f, s, $&motion, now, reduced) >>>
        m.transitions[12] = motion}
    if id == 13 {
        now := m.clock
        reduced := m.reduced_motion
        $motion := m.transitions[13]
        control := $&m.invalid
        control.paint_motion_styled(f, s, $&motion, now, reduced) >>>
        m.transitions[13] = motion}
    if id == 14 {
        now := m.clock
        reduced := m.reduced_motion
        $motion := m.transitions[14]
        control := $&m.read_only
        control.paint_motion_styled(f, s, $&motion, now, reduced) >>>
        m.transitions[14] = motion}
    if id == 15 {
        now := m.clock
        reduced := m.reduced_motion
        $motion := m.transitions[15]
        control := $&m.area
        control.paint_motion_styled(f, s, $&motion, now, reduced) >>>
        m.transitions[15] = motion}
    if id == 11 {control := $&m.progress
        control.set_bounds(b) >>>
        control.paint_styled(f, s) >>> }
    if id == 32 {target := $&m.toggle
        target.set_bounds(b) >>>
        $control := m.toggle.clone()
        base := control.style_or(s)
        appearance := m.motion_style(32, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        position := m.switch_motion.value()
        label := $&m.toggle_label
        control.paint_position_styled(f, label, s, position) >>> }
    if id == 33 {target := $&m.radio_a
        target.set_bounds(b) >>>
        $control := m.radio_a.clone()
        base := control.style_or(s)
        appearance := m.motion_style(33, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.radio_a_label
        control.paint_styled(f, label, s) >>> }
    if id == 34 {target := $&m.radio_b
        target.set_bounds(b) >>>
        $control := m.radio_b.clone()
        base := control.style_or(s)
        appearance := m.motion_style(34, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.radio_b_label
        control.paint_styled(f, label, s) >>> }
    if id == 35 {target := $&m.slider
        target.set_bounds(b) >>>
        $control := m.slider.clone()
        base := control.style_or(s)
        appearance := m.motion_style(35, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        control.paint_styled(f, s) >>> }
    if id == 36 {target := $&m.stepper
        target.set_bounds(b) >>>
        $control := m.stepper.clone()
        base := control.style_or(s)
        appearance := m.motion_style(36, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.stepper_label
        control.paint_styled(f, label, s) >>> }
    if id == 37 {target := $&m.badge
        target.set_bounds(b) >>>
        control := m.badge.clone()
        label := $&m.badge_label
        control.paint_styled(f, label, s) >>> }
    if id == 38 {target := $&m.divider
        target.set_bounds(b) >>>
        control := m.divider.clone()
        label := $&m.divider_label
        control.paint_labeled_styled(f, label, s) >>> }
    if id == 40 {target := $&m.tabs
        target.set_bounds(b) >>>
        control := m.tabs.clone()
        control.paint_box_styled(f, s) >>>
        l0 := $&m.tab_label
        control.paint_tab_styled(f, 0, l0, s) >>>
        l1 := $&m.tab_2_label
        control.paint_tab_styled(f, 1, l1, s) >>>
        l2 := $&m.tab_3_label
        control.paint_tab_styled(f, 2, l2, s) >>> }
    if id == 41 {target := $&m.select_ctrl
        target.set_bounds(b) >>>
        $control := m.select_ctrl.clone()
        base := control.style_or(s)
        appearance := m.motion_style(41, &base, control.visual_state()) >>>
        control.set_style(&appearance) >>>
        label := $&m.select_label
        control.paint_styled(f, label, s) >>> }
    if id == 42 {target := $&m.card
        target.set_bounds(b) >>>
        control := m.card.clone()
        label := $&m.card_label
        control.paint_header_styled(f, label, s) >>>
        demo.text(&m.context, f, 14.0 * s.density, 42.0 * s.density, 11.0 * s.text_scale, s.button.palette.muted, "Card body") >>> }
    if id == 43 {target := $&m.list
        target.set_bounds(b) >>>
        control := m.list.clone()
        control.paint_box_styled(f, s) >>>
        r0 := $&m.list_label
        control.paint_item_styled(f, 0, r0, s) >>>
        r1 := $&m.list_2_label
        control.paint_item_styled(f, 1, r1, s) >>>
        r2 := $&m.list_3_label
        control.paint_item_styled(f, 2, r2, s) >>>
        r3 := $&m.list_4_label
        control.paint_item_styled(f, 3, r3, s) >>> }
    if id == 2 {
        demo.text(&m.context, f, 0.0, 0.0, 24.0, s.button.palette.foreground, "A theme that reaches every control") >>>
        demo.text(&m.context, f, 0.0, 33.0, 13.0, s.button.palette.muted, "Light / dark / contrast · typography · density · local overrides · no idle redraw") >>>
    }
    if id >= 18 && id <= 29 {
        f.fill_rect(0.0, 0.0, b.width, b.height, s.input.palette.normal) >>>
        demo.text(&m.context, f, 12.0, 5.0, 14.0, s.input.palette.foreground, "Scrollable item " + str(id - 17) + "   —   wheel, drag the thumb, or Page Down") >>>
    }
    if id == 30 {
        demo.text(&m.context, f, 0.0, 0.0, 12.0, s.button.palette.muted, "The green button keeps its own font and palette. Error and read-only fields are distinct states.") >>>
        demo.text(&m.context, f, 0.0, 21.0, 12.0, s.button.palette.muted, "Tab / Shift+Tab to move focus · copy from read-only text · Escape to quit") >>>
    }
    << 0
}
fn (m $&Model) paint_styled(id int, b &layout.Rect, s &widgets.Styles, f $&draw.Frame) bool {
    m.draw_node(id, b, s, f) >>> (err) {eprintln(err.msg())
        << false}
    << true
}
fn (m $&Model) overlay_styled(id int, b &layout.Rect, s &widgets.Styles, f $&draw.Frame) bool {
    if id == 16 {control := $&m.scroll
        control.paint_scrollbar(f, s) >>> (err) {eprintln(err.msg())
            << false}}
    if id == 1 &&(m.select_ctrl.is_open() || m.popup_motion.value() > 0.0) {
        m.paint_select_popup(s, f) >>> (err) {eprintln(err.msg())
            << false}
    }
    << true
}
// Root overlay keeps the popup above every sibling and outside the button's box.
fn (m $&Model) paint_select_popup(s &widgets.Styles, f $&draw.Frame) int {
    $control := m.select_ctrl.clone()
    control.set_open(true)
    opacity := m.popup_motion.value()
    if opacity <= 0.0 { << 0}
    base := control.style_or(s)
    appearance := base.with_opacity(opacity) >>>
    control.set_style(&appearance) >>>
    popup := control.popup_bounds(s)
    $offset := - 4.0 *(1.0 - opacity)
    if popup.y < 0.0 {offset = 4.0 *(1.0 - opacity)}
    f.push() >>>
    f.translate(m.select_origin.x, m.select_origin.y + offset) >>>
    control.paint_popup_box_styled(f, s) >>>
    auto_label := $&m.option_auto
    control.paint_option_styled(f, 0, auto_label, s) >>>
    manual_label := $&m.option_manual
    control.paint_option_styled(f, 1, manual_label, s) >>>
    locked_label := $&m.option_locked
    control.paint_option_styled(f, 2, locked_label, s) >>>
    f.pop() >>>
    << 0
}
// The popup is an overlay, so route its pointer sequence before normal tree hits.
fn (m $&Model) dispatch_input(view $&widgets.View, event &ui.InputEvent)[]widgets.Action{
    was_open := m.select_ctrl.is_open()
    pointer := event.kind == ui.EV_POINTER_DOWN || event.kind == ui.EV_POINTER_UP ||
    event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_SCROLL
    if pointer &&(was_open || m.select_popup_armed) {
        local := view.local_input(41, event) >>>
        styles := view.styles_for(41) >>>
        pop := m.select_ctrl.popup_bounds(&styles)
        if pop.contains(local.x, local.y) || m.select_popup_armed{
            if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT{m.select_popup_armed = true}
            control := $&m.select_ctrl
            action := control.input(&local) >>>
            view.set_pointer_cursor(ui.CURSOR_HAND) >>>
            if event.kind == ui.EV_POINTER_UP{m.select_popup_armed = false}
            view.mark_paint(41) >>>
            view.mark_paint(1) >>>
            <<[action]
        }
    }
    if event.kind == ui.EV_POINTER_CANCEL{m.select_popup_armed = false}
    actions := widgets.dispatch(view, event, m) >>>
    if was_open || m.select_ctrl.is_open() {view.mark_paint(1) >>> }
    << actions
}
fn (m $&Model) dispatch_event(view $&widgets.View, event &ui.Event)[]widgets.Action{
    if ui.is_input_event(event.kind) {
        input := ui.input_of(event) >>>
        << m.dispatch_input(view, &input) >>>
    }
    was_open := m.select_ctrl.is_open()
    actions := widgets.dispatch_event(view, event, m) >>>
    m.select_popup_armed = false
    if was_open && !m.select_ctrl.is_open() {view.mark_paint(1) >>> }
    << actions
}
fn (m $&Model) input(id int, kind int, event &ui.InputEvent) widgets.Action{
    if id == 4 {control := $&m.theme
        << control.route(kind, event) >>> }
    if id == 5 {control := $&m.scale
        << control.route(kind, event) >>> }
    if id == 6 {control := $&m.density
        << control.route(kind, event) >>> }
    if id == 8 {control := $&m.brand
        << control.route(kind, event) >>> }
    if id == 9 {control := $&m.disabled
        << control.route(kind, event) >>> }
    if id == 10 {control := $&m.check
        << control.route(kind, event) >>> }
    if id == 12 {control := $&m.input
        << control.route(kind, event) >>> }
    if id == 13 {control := $&m.invalid
        << control.route(kind, event) >>> }
    if id == 14 {control := $&m.read_only
        << control.route(kind, event) >>> }
    if id == 15 {control := $&m.area
        << control.route(kind, event) >>> }
    if id == 16 {control := $&m.scroll
        << control.route(kind, event) >>> }
    if id == 32 {control := $&m.toggle
        << control.route(kind, event) >>> }
    if id == 33 {control := $&m.radio_a
        << control.route(kind, event) >>> }
    if id == 34 {control := $&m.radio_b
        << control.route(kind, event) >>> }
    if id == 35 {control := $&m.slider
        << control.route(kind, event) >>> }
    if id == 36 {control := $&m.stepper
        << control.route(kind, event) >>> }
    if id == 40 {control := $&m.tabs
        << control.route(kind, event) >>> }
    if id == 41 {control := $&m.select_ctrl
        << control.route(kind, event) >>> }
    if id == 43 {control := $&m.list
        << control.route(kind, event) >>> }
    << widgets.Action{kind: 0, id: id, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
}
fn (m $&Model) place(view $&widgets.View) int {
    select_bounds := view.node_bounds(41) >>>
    m.select_origin = select_bounds
    select_styles := view.styles_for(41) >>>
    select_control := $&m.select_ctrl
    select_control.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: select_bounds.width, height: select_bounds.height}) >>>
    select_control.apply_styles(&select_styles) >>>
    popup := select_control.popup_bounds(&select_styles)
    window_bounds := view.node_bounds(1) >>>
    below := window_bounds.y + window_bounds.height - select_bounds.y - select_bounds.height
    above := select_bounds.y - window_bounds.y
    select_control.set_popup_above(below < popup.height + 2.0 * select_styles.density && above > below)
    list_bounds := view.node_bounds(43) >>>
    list_styles := view.styles_for(43) >>>
    list_control := $&m.list
    list_control.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: list_bounds.width, height: list_bounds.height}) >>>
    list_control.apply_styles(&list_styles) >>>
    input := $&m.input
    widgets.place_editor(view, input) >>>
    invalid := $&m.invalid
    widgets.place_editor(view, invalid) >>>
    read_only := $&m.read_only
    widgets.place_editor(view, read_only) >>>
    area := $&m.area
    widgets.place_editor(view, area) >>>
    bounds := view.node_bounds(16) >>>
    styles := view.styles_for(16) >>>
    control := $&m.scroll
    control.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: bounds.width, height: bounds.height}) >>>
    control.apply_styles(&styles) >>>
    view.set_scroll(16, 0.0, control.offset()) >>>
    << 0
}
fn (m $&Model) native_event(view $&widgets.View, event &ui.Event) int {
    input := $&m.input
    action_12 := input.event(event) >>>
    if action_12.needs_paint{view.mark_paint(12) >>> }
    invalid := $&m.invalid
    action_13 := invalid.event(event) >>>
    if action_13.needs_paint{view.mark_paint(13) >>> }
    read_only := $&m.read_only
    action_14 := read_only.event(event) >>>
