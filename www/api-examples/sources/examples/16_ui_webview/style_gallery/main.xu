@main
#ui
#ui/draw
#ui/widgets
#ui/layout
#time
demo #"github.com/xulang-org/examples/ui_demo"

// IDs follow the stable topology created below. All control bounds are local;
// Editor.place receives the separate canvas rectangle for native IME geometry.
struct Model {
    theme widgets.Button
    scale widgets.Button
    density widgets.Button
    brand widgets.Button
    disabled widgets.Button
    check widgets.Checkbox
    toggle widgets.Switch
    radio_a widgets.Radio
    radio_b widgets.Radio
    slider widgets.Slider
    stepper widgets.Stepper
    tabs widgets.Tabs
    select_ctrl widgets.Select
    select_origin layout.Rect
    select_popup_armed bool
    transitions []widgets.PaintTransition
    switch_motion widgets.Tween
    popup_motion widgets.Tween
    clock time.Instant
    reduced_motion bool
    badge widgets.Badge
    divider widgets.Divider
    card widgets.Card
    list widgets.ListBox
    input widgets.Editor
    invalid widgets.Editor
    read_only widgets.Editor
    area widgets.Editor
    progress widgets.Progress
    scroll widgets.Scroll
    context draw.Context
    icon draw.Image
    switcher widgets.StyleSwitcher
    theme_label widgets.StyledLabel
    scale_label widgets.StyledLabel
    density_label widgets.StyledLabel
    brand_label widgets.StyledLabel
    disabled_label widgets.StyledLabel
    check_label widgets.StyledLabel
    toggle_label widgets.StyledLabel
    radio_a_label widgets.StyledLabel
    radio_b_label widgets.StyledLabel
    stepper_label widgets.StyledLabel
    badge_label widgets.StyledLabel
    divider_label widgets.StyledLabel
    card_label widgets.StyledLabel
    tab_label widgets.StyledLabel
    tab_2_label widgets.StyledLabel
    tab_3_label widgets.StyledLabel
    select_label widgets.StyledLabel
    option_auto widgets.StyledLabel
    option_manual widgets.StyledLabel
    option_locked widgets.StyledLabel
    list_label widgets.StyledLabel
    list_2_label widgets.StyledLabel
    list_3_label widgets.StyledLabel
    list_4_label widgets.StyledLabel
}
fn (m &mut Model) motion_style(id int,base &widgets.ControlStyle,state int) widgets.ControlStyle {
    now := m.clock
    reduced := m.reduced_motion
    motion := mut &m.transitions[id]
    << motion.style(base,state,now,reduced) or >>
}
fn (m &mut Model) tick(view &mut widgets.View,now time.Instant) int {
    m.clock = now
    reduced := m.reduced_motion
    for id in 1:m.transitions.len {
        motion := mut &m.transitions[id]
        if reduced && motion.is_animating() { motion.finish()
            view.mark_paint(id) or >> }
        else if motion.advance(now) or >> { view.mark_paint(id) or >> }
    }
    mut selected := 0.0
    if m.toggle.value() { selected = 1.0 }
    switch_motion := mut &m.switch_motion
    before_switch := switch_motion.value()
    switch_motion.retarget(selected,now,time.milliseconds(180) or >>,reduced) or >>
    if before_switch != switch_motion.value() { view.mark_paint(32) or >> }
    mut opened := 0.0
    if m.select_ctrl.is_open() { opened = 1.0 }
    popup_motion := mut &m.popup_motion
    before_popup := popup_motion.value()
    mut popup_duration := time.milliseconds(130) or >>
    if opened == 0.0 { popup_duration = time.milliseconds(95) or >> }
    popup_motion.retarget(opened,now,popup_duration,reduced) or >>
    if before_popup != popup_motion.value() { view.mark_paint(1) or >> }
    input := mut &m.input
    if input.tick(now,reduced) or >> { view.mark_paint(12) or >> }
    invalid := mut &m.invalid
    if invalid.tick(now,reduced) or >> { view.mark_paint(13) or >> }
    read_only := mut &m.read_only
    if read_only.tick(now,reduced) or >> { view.mark_paint(14) or >> }
    area := mut &m.area
    if area.tick(now,reduced) or >> { view.mark_paint(15) or >> }
    << 0
}
fn (m &Model) next_frame(now time.Instant) time.Instant {
    if m.switch_motion.is_animating() || m.popup_motion.is_animating() { << now.add(time.milliseconds(16) or >>) or >> }
    for motion in m.transitions { if motion.is_animating() { << now.add(time.milliseconds(16) or >>) or >> } }
    mut deadline := time.zero_instant()
    for next in [m.input.next_caret_tick(now,m.reduced_motion) or >>,m.invalid.next_caret_tick(now,m.reduced_motion) or >>,
        m.read_only.next_caret_tick(now,m.reduced_motion) or >>,m.area.next_caret_tick(now,m.reduced_motion) or >>] {
        if !next.is_zero() && (deadline.is_zero() || next.before(deadline)) { deadline = next }
    }
    << deadline
}
fn (m &Model) next_event(ech chan ui.Event) ui.Event {
    deadline := m.next_frame(time.instant()) or >>
    while true {
        event := ui.poll_chan(ech)
        if event.kind != ui.EV_NONE { << event }
        if !deadline.is_zero() && !time.instant().before(deadline) { << event }
        pause := time.milliseconds(8) or >>
        pause.sleep()
    }
    << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
}
fn (m &mut Model) measure_node(id int,s &widgets.Styles) layout.Size {
    if id == 4 { control := m.theme.clone()
        label := mut &m.theme_label
        << control.measure_styled(label,s) or >> }
    if id == 5 { control := m.scale.clone()
        label := mut &m.scale_label
        << control.measure_styled(label,s) or >> }
    if id == 6 { control := m.density.clone()
        label := mut &m.density_label
        << control.measure_styled(label,s) or >> }
    if id == 8 { control := m.brand.clone()
        label := mut &m.brand_label
        << control.measure_icon_styled(label,s) or >> }
    if id == 9 { control := m.disabled.clone()
        label := mut &m.disabled_label
        << control.measure_styled(label,s) or >> }
    if id == 10 { control := m.check.clone()
        label := mut &m.check_label
        << control.measure_styled(label,s) or >> }
    if id == 11 { control := m.progress.clone()
        << control.measure_styled(s) or >> }
    if id == 12 { control := mut &m.input
        << control.measure_styled(s) or >> }
    if id == 13 { control := mut &m.invalid
        << control.measure_styled(s) or >> }
    if id == 14 { control := mut &m.read_only
        << control.measure_styled(s) or >> }
    if id == 15 { control := mut &m.area
        << control.measure_styled(s) or >> }
    if id == 32 { control := m.toggle.clone()
        label := mut &m.toggle_label
        << control.measure_styled(label,s) or >> }
    if id == 33 { control := m.radio_a.clone()
        label := mut &m.radio_a_label
        << control.measure_styled(label,s) or >> }
    if id == 34 { control := m.radio_b.clone()
        label := mut &m.radio_b_label
        << control.measure_styled(label,s) or >> }
    if id == 35 { control := m.slider.clone()
        << control.measure_styled(s) or >> }
    if id == 36 { control := m.stepper.clone()
        label := mut &m.stepper_label
        << control.measure_styled(label,s) or >> }
    if id == 37 { control := m.badge.clone()
        label := mut &m.badge_label
        << control.measure_styled(label,s) or >> }
    if id == 38 { control := m.divider.clone()
        label := mut &m.divider_label
        << control.measure_labeled_styled(label,s) or >> }
    if id == 40 { control := m.tabs.clone()
        label := mut &m.tab_label
        << control.measure_styled(label,s) or >> }
    if id == 41 { control := m.select_ctrl.clone()
        label := mut &m.select_label
        << control.measure_styled(label,s) or >> }
    if id == 42 { control := m.card.clone()
        label := mut &m.card_label
        << control.measure_header_styled(label,s) or >> }
    if id == 43 { control := m.list.clone()
        label := mut &m.list_label
        << control.measure_styled(label,s) or >> }
    << layout.Size{width: 0.0,height: 0.0}
}
fn (m &mut Model) measure_styled(id int,s &widgets.Styles) layout.Size {
    << m.measure_node(id,s) or (err) { eprintln(err.msg())
        << layout.Size{width: -1.0,height: -1.0} }
}
fn (m &mut Model) draw_node(id int,b &layout.Rect,s &widgets.Styles,f &mut draw.Frame) int {
    if id == 4 { target := mut &m.theme
        target.set_bounds(b) or >>
        mut control := m.theme.clone()
        base := control.style_or(s)
        appearance := m.motion_style(4,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.theme_label
        control.paint_styled(f,label,s) or >> }
    if id == 5 { target := mut &m.scale
        target.set_bounds(b) or >>
        mut control := m.scale.clone()
        base := control.style_or(s)
        appearance := m.motion_style(5,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.scale_label
        control.paint_styled(f,label,s) or >> }
    if id == 6 { target := mut &m.density
        target.set_bounds(b) or >>
        mut control := m.density.clone()
        base := control.style_or(s)
        appearance := m.motion_style(6,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.density_label
        control.paint_styled(f,label,s) or >> }
    if id == 8 { target := mut &m.brand
        target.set_bounds(b) or >>
        mut control := m.brand.clone()
        base := control.style_or(s)
        appearance := m.motion_style(8,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        icon := m.icon
        label := mut &m.brand_label
        control.paint_icon_styled(f,label,&icon,s) or >> }
    if id == 9 { target := mut &m.disabled
        target.set_bounds(b) or >>
        mut control := m.disabled.clone()
        base := control.style_or(s)
        appearance := m.motion_style(9,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.disabled_label
        control.paint_styled(f,label,s) or >> }
    if id == 10 { target := mut &m.check
        target.set_bounds(b) or >>
        mut control := m.check.clone()
        base := control.style_or(s)
        appearance := m.motion_style(10,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.check_label
        control.paint_styled(f,label,s) or >> }
    if id == 12 {
        now := m.clock
        reduced := m.reduced_motion
        mut motion := m.transitions[12]
        control := mut &m.input
        control.paint_motion_styled(f,s,mut &motion,now,reduced) or >>
        m.transitions[12] = motion }
    if id == 13 {
        now := m.clock
        reduced := m.reduced_motion
        mut motion := m.transitions[13]
        control := mut &m.invalid
        control.paint_motion_styled(f,s,mut &motion,now,reduced) or >>
        m.transitions[13] = motion }
    if id == 14 {
        now := m.clock
        reduced := m.reduced_motion
        mut motion := m.transitions[14]
        control := mut &m.read_only
        control.paint_motion_styled(f,s,mut &motion,now,reduced) or >>
        m.transitions[14] = motion }
    if id == 15 {
        now := m.clock
        reduced := m.reduced_motion
        mut motion := m.transitions[15]
        control := mut &m.area
        control.paint_motion_styled(f,s,mut &motion,now,reduced) or >>
        m.transitions[15] = motion }
    if id == 11 { control := mut &m.progress
        control.set_bounds(b) or >>
        control.paint_styled(f,s) or >> }
    if id == 32 { target := mut &m.toggle
        target.set_bounds(b) or >>
        mut control := m.toggle.clone()
        base := control.style_or(s)
        appearance := m.motion_style(32,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        position := m.switch_motion.value()
        label := mut &m.toggle_label
        control.paint_position_styled(f,label,s,position) or >> }
    if id == 33 { target := mut &m.radio_a
        target.set_bounds(b) or >>
        mut control := m.radio_a.clone()
        base := control.style_or(s)
        appearance := m.motion_style(33,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.radio_a_label
        control.paint_styled(f,label,s) or >> }
    if id == 34 { target := mut &m.radio_b
        target.set_bounds(b) or >>
        mut control := m.radio_b.clone()
        base := control.style_or(s)
        appearance := m.motion_style(34,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.radio_b_label
        control.paint_styled(f,label,s) or >> }
    if id == 35 { target := mut &m.slider
        target.set_bounds(b) or >>
        mut control := m.slider.clone()
        base := control.style_or(s)
        appearance := m.motion_style(35,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        control.paint_styled(f,s) or >> }
    if id == 36 { target := mut &m.stepper
        target.set_bounds(b) or >>
        mut control := m.stepper.clone()
        base := control.style_or(s)
        appearance := m.motion_style(36,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.stepper_label
        control.paint_styled(f,label,s) or >> }
    if id == 37 { target := mut &m.badge
        target.set_bounds(b) or >>
        control := m.badge.clone()
        label := mut &m.badge_label
        control.paint_styled(f,label,s) or >> }
    if id == 38 { target := mut &m.divider
        target.set_bounds(b) or >>
        control := m.divider.clone()
        label := mut &m.divider_label
        control.paint_labeled_styled(f,label,s) or >> }
    if id == 40 { target := mut &m.tabs
        target.set_bounds(b) or >>
        control := m.tabs.clone()
        control.paint_box_styled(f,s) or >>
        l0 := mut &m.tab_label
        control.paint_tab_styled(f,0,l0,s) or >>
        l1 := mut &m.tab_2_label
        control.paint_tab_styled(f,1,l1,s) or >>
        l2 := mut &m.tab_3_label
        control.paint_tab_styled(f,2,l2,s) or >> }
    if id == 41 { target := mut &m.select_ctrl
        target.set_bounds(b) or >>
        mut control := m.select_ctrl.clone()
        base := control.style_or(s)
        appearance := m.motion_style(41,&base,control.visual_state()) or >>
        control.set_style(&appearance) or >>
        label := mut &m.select_label
        control.paint_styled(f,label,s) or >> }
    if id == 42 { target := mut &m.card
        target.set_bounds(b) or >>
        control := m.card.clone()
        label := mut &m.card_label
        control.paint_header_styled(f,label,s) or >>
        demo.text(&m.context,f,14.0 * s.density,42.0 * s.density,11.0 * s.text_scale,s.button.palette.muted,"Card body") or >> }
    if id == 43 { target := mut &m.list
        target.set_bounds(b) or >>
        control := m.list.clone()
        control.paint_box_styled(f,s) or >>
        r0 := mut &m.list_label
        control.paint_item_styled(f,0,r0,s) or >>
        r1 := mut &m.list_2_label
        control.paint_item_styled(f,1,r1,s) or >>
        r2 := mut &m.list_3_label
        control.paint_item_styled(f,2,r2,s) or >>
        r3 := mut &m.list_4_label
        control.paint_item_styled(f,3,r3,s) or >> }
    if id == 2 {
        demo.text(&m.context,f,0.0,0.0,24.0,s.button.palette.foreground,"A theme that reaches every control") or >>
        demo.text(&m.context,f,0.0,33.0,13.0,s.button.palette.muted,"Light / dark / contrast · typography · density · local overrides · no idle redraw") or >>
    }
    if id >= 18 && id <= 29 {
        f.fill_rect(0.0,0.0,b.width,b.height,s.input.palette.normal) or >>
        demo.text(&m.context,f,12.0,5.0,14.0,s.input.palette.foreground,"Scrollable item " + str(id - 17) + "   —   wheel, drag the thumb, or Page Down") or >>
    }
    if id == 30 {
        demo.text(&m.context,f,0.0,0.0,12.0,s.button.palette.muted,"The green button keeps its own font and palette. Error and read-only fields are distinct states.") or >>
        demo.text(&m.context,f,0.0,21.0,12.0,s.button.palette.muted,"Tab / Shift+Tab to move focus · copy from read-only text · Escape to quit") or >>
    }
    << 0
}
fn (m &mut Model) paint_styled(id int,b &layout.Rect,s &widgets.Styles,f &mut draw.Frame) bool {
    m.draw_node(id,b,s,f) or (err) { eprintln(err.msg())
        << false }
    << true
}
fn (m &mut Model) overlay_styled(id int,b &layout.Rect,s &widgets.Styles,f &mut draw.Frame) bool {
    if id == 16 { control := mut &m.scroll
        control.paint_scrollbar(f,s) or (err) { eprintln(err.msg())
            << false } }
    if id == 1 && (m.select_ctrl.is_open() || m.popup_motion.value() > 0.0) {
        m.paint_select_popup(s,f) or (err) { eprintln(err.msg())
            << false }
    }
    << true
}
// Root overlay keeps the popup above every sibling and outside the button's box.
fn (m &mut Model) paint_select_popup(s &widgets.Styles,f &mut draw.Frame) int {
    mut control := m.select_ctrl.clone()
    control.set_open(true)
    opacity := m.popup_motion.value()
    if opacity <= 0.0 { << 0 }
    base := control.style_or(s)
    appearance := base.with_opacity(opacity) or >>
    control.set_style(&appearance) or >>
    popup := control.popup_bounds(s)
    mut offset := -4.0 * (1.0 - opacity)
    if popup.y < 0.0 { offset = 4.0 * (1.0 - opacity) }
    f.push() or >>
    f.translate(m.select_origin.x,m.select_origin.y + offset) or >>
    control.paint_popup_box_styled(f,s) or >>
    auto_label := mut &m.option_auto
    control.paint_option_styled(f,0,auto_label,s) or >>
    manual_label := mut &m.option_manual
    control.paint_option_styled(f,1,manual_label,s) or >>
    locked_label := mut &m.option_locked
    control.paint_option_styled(f,2,locked_label,s) or >>
    f.pop() or >>
    << 0
}
// The popup is an overlay, so route its pointer sequence before normal tree hits.
fn (m &mut Model) dispatch_input(view &mut widgets.View,event &ui.InputEvent) []widgets.Action {
    was_open := m.select_ctrl.is_open()
    pointer := event.kind == ui.EV_POINTER_DOWN || event.kind == ui.EV_POINTER_UP ||
        event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_SCROLL
    if pointer && (was_open || m.select_popup_armed) {
        local := view.local_input(41,event) or >>
        styles := view.styles_for(41) or >>
        pop := m.select_ctrl.popup_bounds(&styles)
        if pop.contains(local.x,local.y) || m.select_popup_armed {
            if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT { m.select_popup_armed = true }
            control := mut &m.select_ctrl
            action := control.input(&local) or >>
            view.set_pointer_cursor(ui.CURSOR_HAND) or >>
            if event.kind == ui.EV_POINTER_UP { m.select_popup_armed = false }
            view.mark_paint(41) or >>
            view.mark_paint(1) or >>
            << [action]
        }
    }
    if event.kind == ui.EV_POINTER_CANCEL { m.select_popup_armed = false }
    actions := widgets.dispatch(view,event,m) or >>
    if was_open || m.select_ctrl.is_open() { view.mark_paint(1) or >> }
    << actions
}
fn (m &mut Model) dispatch_event(view &mut widgets.View,event &ui.Event) []widgets.Action {
    if ui.is_input_event(event.kind) {
        input := ui.input_of(event) or >>
        << m.dispatch_input(view,&input) or >>
    }
    was_open := m.select_ctrl.is_open()
    actions := widgets.dispatch_event(view,event,m) or >>
    m.select_popup_armed = false
    if was_open && !m.select_ctrl.is_open() { view.mark_paint(1) or >> }
    << actions
}
fn (m &mut Model) input(id int,kind int,event &ui.InputEvent) widgets.Action {
    if id == 4 { control := mut &m.theme
        << control.route(kind,event) or >> }
    if id == 5 { control := mut &m.scale
        << control.route(kind,event) or >> }
    if id == 6 { control := mut &m.density
        << control.route(kind,event) or >> }
    if id == 8 { control := mut &m.brand
        << control.route(kind,event) or >> }
    if id == 9 { control := mut &m.disabled
        << control.route(kind,event) or >> }
    if id == 10 { control := mut &m.check
        << control.route(kind,event) or >> }
    if id == 12 { control := mut &m.input
        << control.route(kind,event) or >> }
    if id == 13 { control := mut &m.invalid
        << control.route(kind,event) or >> }
    if id == 14 { control := mut &m.read_only
        << control.route(kind,event) or >> }
    if id == 15 { control := mut &m.area
        << control.route(kind,event) or >> }
    if id == 16 { control := mut &m.scroll
        << control.route(kind,event) or >> }
    if id == 32 { control := mut &m.toggle
        << control.route(kind,event) or >> }
    if id == 33 { control := mut &m.radio_a
        << control.route(kind,event) or >> }
    if id == 34 { control := mut &m.radio_b
        << control.route(kind,event) or >> }
    if id == 35 { control := mut &m.slider
        << control.route(kind,event) or >> }
    if id == 36 { control := mut &m.stepper
        << control.route(kind,event) or >> }
    if id == 40 { control := mut &m.tabs
        << control.route(kind,event) or >> }
    if id == 41 { control := mut &m.select_ctrl
        << control.route(kind,event) or >> }
    if id == 43 { control := mut &m.list
        << control.route(kind,event) or >> }
    << widgets.Action{kind: 0,id: id,needs_paint: false,request_focus: false,consumed: false,value: 0.0}
}
fn (m &mut Model) place(view &mut widgets.View) int {
    select_bounds := view.node_bounds(41) or >>
    m.select_origin = select_bounds
    select_styles := view.styles_for(41) or >>
    select_control := mut &m.select_ctrl
    select_control.set_bounds(&layout.Rect{x: 0.0,y: 0.0,width: select_bounds.width,height: select_bounds.height}) or >>
    select_control.apply_styles(&select_styles) or >>
    popup := select_control.popup_bounds(&select_styles)
    window_bounds := view.node_bounds(1) or >>
    below := window_bounds.y + window_bounds.height - select_bounds.y - select_bounds.height
    above := select_bounds.y - window_bounds.y
    select_control.set_popup_above(below < popup.height + 2.0 * select_styles.density && above > below)
    list_bounds := view.node_bounds(43) or >>
    list_styles := view.styles_for(43) or >>
    list_control := mut &m.list
    list_control.set_bounds(&layout.Rect{x: 0.0,y: 0.0,width: list_bounds.width,height: list_bounds.height}) or >>
    list_control.apply_styles(&list_styles) or >>
    input := mut &m.input
    widgets.place_editor(view,input) or >>
    invalid := mut &m.invalid
    widgets.place_editor(view,invalid) or >>
    read_only := mut &m.read_only
    widgets.place_editor(view,read_only) or >>
    area := mut &m.area
    widgets.place_editor(view,area) or >>
    bounds := view.node_bounds(16) or >>
    styles := view.styles_for(16) or >>
    control := mut &m.scroll
    control.set_bounds(&layout.Rect{x: 0.0,y: 0.0,width: bounds.width,height: bounds.height}) or >>
    control.apply_styles(&styles) or >>
    view.set_scroll(16,0.0,control.offset()) or >>
    << 0
}
fn (m &mut Model) native_event(view &mut widgets.View,event &ui.Event) int {
    input := mut &m.input
    action_12 := input.event(event) or >>
    if action_12.needs_paint { view.mark_paint(12) or >> }
    invalid := mut &m.invalid
    action_13 := invalid.event(event) or >>
    if action_13.needs_paint { view.mark_paint(13) or >> }
    read_only := mut &m.read_only
    action_14 := read_only.event(event) or >>
    if action_14.needs_paint { view.mark_paint(14) or >> }
    area := mut &m.area
    action_15 := area.event(event) or >>
    if action_15.needs_paint { view.mark_paint(15) or >> }
    << 0
}
