fn leaf(view $&widgets.View, parent int, width f64, height f64) int {
    style := layout.box_style(layout.BOX_LEAF)
    << view.add(parent, &style, &layout.Size{width: width, height: height}) >>>
}
fn brand_scope(view $&widgets.View) int {
    $brand := widgets.light_styles()
    brand.button.palette.normal = draw.rgb(10, 91, 69)
    brand.button.palette.hovered = draw.rgb(17, 120, 90)
    brand.button.palette.pressed = draw.rgb(7, 65, 49)
    brand.button.palette.foreground = draw.rgb(255, 255, 255)
    brand.button.font.size = 17.0
    brand.button.font.weight = 600
    brand.button.inherit_font = false
    brand.button.radius = 18.0
    brand.button.icon_size = 22.0
    brand.button.icon_placement = widgets.ICON_TRAILING
    $hover := widgets.state_paint(widgets.STATE_HOVERED)
    hover.unless = widgets.STATE_DISABLED
    hover.fields = widgets.PAINT_FOREGROUND | widgets.PAINT_BORDER
    hover.foreground = draw.rgb(209, 250, 229)
    hover.border = draw.rgb(110, 231, 183)
    brand.button.states =[hover]
    brand.button.shadow = draw.rgba(0, 0, 0, 28)
    brand.button.shadow_y = 2.0
    brand.button.shadow_blur = 6.0
    view.set_style_scope(8, &brand) >>>
    << 0
}
fn scene(ech chan ui.Event) int {
    ready := demo.ready(ech) >>>
    if ready.kind == ui.EV_EXIT{ << 0}
    identity := ui.canvas_of(&ready) >>>
    context := draw.context_of(&ready) >>>
    host := widgets.Host{context: context, identity: identity}
    $column := layout.box_style(layout.BOX_COLUMN)
    column.padding = layout.insets(22.0) >>>
    column.gap = 10.0
    column.cross_alignment = layout.CROSS_STRETCH
    $view := host.view(&column, draw.rgb(20, 25, 34)) >>>
    _ := leaf($&view, 1, 400.0, 56.0) >>>  // 2 header
    $row := layout.box_style(layout.BOX_ROW)
    row.gap = 12.0
    row.cross_alignment = layout.CROSS_CENTER
    _ := view.add(1, &row, &layout.Size{width: 0.0, height: 0.0}) >>>  // 3 toolbar
    for i in 0:3 {_ := leaf($&view, 3, 0.0, 0.0) >>> }  // 4..6
    _ := view.add(1, &row, &layout.Size{width: 0.0, height: 0.0}) >>>  // 7 controls
    for i in 0:3 {_ := leaf($&view, 7, 0.0, 0.0) >>> }  // 8..10
    _ := leaf($&view, 1, 300.0, 12.0) >>>  // 11 progress
    for i in 0:4 {_ := leaf($&view, 1, 300.0, 0.0) >>> }  // 12..15 editors
    $viewport := layout.box_style(layout.BOX_COLUMN)
    viewport.height = 84.0
    viewport.clip = true
    viewport.cross_alignment = layout.CROSS_STRETCH
    _ := view.add(1, &viewport, &layout.Size{width: 0.0, height: 0.0}) >>>  // 16 scroll
    $items := layout.box_style(layout.BOX_COLUMN)
    items.gap = 6.0
    items.cross_alignment = layout.CROSS_STRETCH
    _ := view.add(16, &items, &layout.Size{width: 0.0, height: 0.0}) >>>  // 17 items
    for i in 0:12 {_ := leaf($&view, 17, 300.0, 28.0) >>> }  // 18..29
    _ := leaf($&view, 1, 400.0, 42.0) >>>  // 30 footer
    _ := view.add(1, &row, &layout.Size{width: 0.0, height: 0.0}) >>>  // 31 extended controls row 1
    for i in 0:6 {_ := leaf($&view, 31, 0.0, 0.0) >>> }  // 32..37: switch, radio_a, radio_b, slider, stepper, badge
    _ := leaf($&view, 1, 300.0, 0.0) >>>  // 38 labeled divider
    _ := view.add(1, &row, &layout.Size{width: 0.0, height: 0.0}) >>>  // 39 extended controls row 2
    for i in 0:4 {_ := leaf($&view, 39, 0.0, 0.0) >>> }  // 40..43: tabs, select, card, list_box
    for id in[2, 4, 5, 6, 8, 9, 10, 11, 12, 13, 14, 15, 16, 30, 32, 33, 34, 35, 36, 37, 38, 40, 41, 42, 43] {view.set_boundary(id, true) >>> }
    for id in[4, 5, 6, 8, 10, 12, 13, 14, 15, 16, 32, 33, 34, 35, 36, 40, 41, 43] {view.set_input(id, true, true) >>> }
    view.set_capture_outside(16, true) >>>
    view.set_capture_outside(35, true) >>>
    for id in[4, 5, 6, 8, 9, 10, 11, 12, 13, 14, 15, 32, 33, 34, 35, 36, 37, 38, 40, 41, 42, 43] {view.set_style_measure(id, true) >>> }
    empty := layout.Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}
    $m := Model{theme: widgets.button(&identity, 4, &empty) >>>, scale: widgets.button(&identity, 5, &empty) >>>,
        density: widgets.button(&identity, 6, &empty) >>>, brand: widgets.button(&identity, 8, &empty) >>>,
        disabled: widgets.button(&identity, 9, &empty) >>>, check: widgets.checkbox(&identity, 10, &empty, true) >>>,
        toggle: widgets.switch_control(&identity, 32, &empty, true) >>>,
        radio_a: widgets.radio(&identity, 33, &empty, 0, true) >>>,
        radio_b: widgets.radio(&identity, 34, &empty, 1, false) >>>,
        slider: widgets.slider(&identity, 35, &empty, 0.0, 100.0, 64.0) >>>,
        stepper: widgets.stepper(&identity, 36, &empty, 0.0, 100.0, 5.0, 65.0) >>>,
        tabs: widgets.tabs(&identity, 40, &empty, 3, 0) >>>,
        select_ctrl: widgets.select_box(&identity, 41, &empty, 3, 0) >>>,
        select_origin: empty, select_popup_armed: false,
        transitions:[]widgets.PaintTransition{}, switch_motion: widgets.tween(1.0) >>>, popup_motion: widgets.tween(0.0) >>>,
        clock: time.zero_instant(), reduced_motion: false, theme_index: 0, text_scale: 1.0, density_scale: 1.0, appearance_dirty: true,
        badge: widgets.badge(&empty) >>>,
        divider: widgets.divider(&empty, widgets.AXIS_HORIZONTAL) >>>,
        card: widgets.card(&empty) >>>,
        list: widgets.list_box(&identity, 43, &empty, 4, 0) >>>,
        input: widgets.input(&context, &identity, 12, &empty, &"Editable input · 你好 Xu") >>>,
        invalid: widgets.input(&context, &identity, 13, &empty, &"Invalid value — custom error colors") >>>,
        read_only: widgets.input(&context, &identity, 14, &empty, &"Read-only · select and copy, edits are ignored") >>>,
        area: widgets.text_area(&context, &identity, 15, &empty, &"TextArea uses the same font, padding and selection theme.\nIME, preedit and caret geometry follow typography changes.") >>>,
        progress: widgets.progress(&empty, 0.64) >>>, scroll: widgets.scroll(&identity, 16, &empty, widgets.AXIS_VERTICAL, 402.0) >>>,
        context: context, icon: context.load_embedded_image(&"logo.png") >>>, switcher: widgets.style_switcher(),
        theme_label: widgets.styled_label(&context, &"Theme: dark / light / contrast"),
        scale_label: widgets.styled_label(&context, &"Text: 100% / 140%"),
        density_label: widgets.styled_label(&context, &"Density: normal / compact"),
        brand_label: widgets.styled_label(&context, &"Local green"),
        disabled_label: widgets.styled_label(&context, &"Disabled"),
        check_label: widgets.styled_label(&context, &"Checkbox"),
        toggle_label: widgets.styled_label(&context, &"Switch"),
        radio_a_label: widgets.styled_label(&context, &"Radio A"),
        radio_b_label: widgets.styled_label(&context, &"Radio B"),
        stepper_label: widgets.styled_label(&context, &"65"),
        badge_label: widgets.styled_label(&context, &"Active"),
        divider_label: widgets.styled_label(&context, &"Navigation & Data Components"),
        card_label: widgets.styled_label(&context, &"Card Panel"),
        tab_label: widgets.styled_label(&context, &"Overview"),
        tab_2_label: widgets.styled_label(&context, &"Tokens"),
        tab_3_label: widgets.styled_label(&context, &"Themes"),
        select_label: widgets.styled_label(&context, &"Option: Auto"),
        option_auto: widgets.styled_label(&context, &"Auto"),
        option_manual: widgets.styled_label(&context, &"Manual"),
        option_locked: widgets.styled_label(&context, &"Locked"),
        list_label: widgets.styled_label(&context, &"1 · Buttons"),
        list_2_label: widgets.styled_label(&context, &"2 · Editors"),
        list_3_label: widgets.styled_label(&context, &"3 · Surfaces"),
        list_4_label: widgets.styled_label(&context, &"4 · Controls")}
    for i in 0:44 {m.transitions.push(widgets.paint_transition() >>>)}
    for id in[4, 5, 6, 8, 10, 32, 33, 34, 36, 40, 41, 43] {view.set_cursor(id, ui.CURSOR_HAND) >>> }
    for id in[12, 13, 14, 15] {view.set_cursor(id, ui.CURSOR_TEXT) >>> }
    view.set_cursor(35, ui.CURSOR_RESIZE_HORIZONTAL) >>>
    badge_ref := $&m.badge
    badge_ref.set_selected(true)
    disabled := $&m.disabled
    disabled.set_enabled(false)
    invalid := $&m.invalid
    invalid.set_invalid(true)
    read_only := $&m.read_only
    read_only.set_read_only(true) >>>
    apply_appearance($&m, $&view) >>>
    brand_scope($&view) >>>
    dispatcher := register_actions(&m, &view) >>>
    $width := 960.0
    $height := 820.0
    $event := ui.Event{kind: ui.EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
    // Drain input bursts before painting. Native text snapshots already hold
    // the latest revision; rendering each queued key would fill the frame queue.
    ui.request_canvas_preferences(&identity) >>>
    while true {
        if event.kind == ui.EV_NONE{
            apply_appearance($&m, $&view) >>>
            m.tick($&view, time.instant()) >>>
            constraints := layout.tight(width, height) >>>
            _ := widgets.layout_styled($&view, &constraints, $&m) >>>
            m.place($&view) >>>
            if widgets.present_styled($&view, &constraints, $&m) >>> {m.acknowledge()}
            event = m.next_event(ech)
        }
        if event.kind == ui.EV_EXIT{ <- }
        if event.window_id == identity.window_id{
            if event.kind == ui.EV_CANVAS_CLOSED || event.kind == ui.EV_CLOSED{ <- }
            if event.kind == ui.EV_CANVAS_METRICS{metrics := ui.metrics_of(&event) >>>
                width = metrics.width
                height = metrics.height}
            if event.kind == ui.EV_FOCUSED{ui.request_canvas_preferences(&identity) >>> }
            if event.kind == ui.EV_CANVAS_PREFERENCES{
                preferences := ui.canvas_preferences_of(&event) >>>
                if preferences.identity.canvas_id == identity.canvas_id && preferences.identity.generation == identity.generation{
                    m.reduced_motion = preferences.reduced_motion
                    view.mark_paint(1) >>>
                }
            }
            popup_was_open := m.select_ctrl.is_open()
            actions := m.dispatch_event($&view, &event) >>>
            m.native_event($&view, &event) >>>
            for action in actions{_ := dispatcher.dispatch(&action, $&m, $&view) >>> }
            if ui.is_input_event(event.kind) {input := ui.input_of(&event) >>>
                if input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE && !popup_was_open{
                    view.dispose()
                    if demo.alive(&identity) {m.cleanup()}
                    demo.quit() >>>
                    << 0
                }}
        }
        event = ui.poll_chan(ech)
    }
    view.dispose()
    if demo.alive(&identity) {m.cleanup()}
    << 0
}
fn worker(ech chan ui.Event) {scene(ech) >>> (err) {demo.fail(err.msg())
        << }}
fn main() int {
    $app := demo.app("Xu UI / Style Gallery", 960, 820) >>> (err) {eprintln(err.msg())
        << 1}
    xu worker(app.event_ch)
    << app.run() >>> (err) {eprintln(err.msg())
        << 1}
}
