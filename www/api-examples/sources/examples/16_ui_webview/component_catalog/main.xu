@main
#ui
#ui/widgets
#ui/draw
#time
#math
demo #"github.com/xulang-org/examples/ui_demo"

// The model contains business choices and screen-local handles only.
struct Model{
    page int
    theme int
    text_scale f64
    density f64
    appearance_dirty bool
    nav []int
    settings []int
    pages []int
    headings []int
    captions []int
    table int
    tree int
    pager int
    crumbs int
    combo int
    multi int
    color int
    spinner int
    overlay_buttons []int
    popover int
    modal int
    modal_actions []int
    value_label int
    note int
}
fn (m &Model) fill_table(screen $&widgets.Screen) int {
    names :=["Compiler", "Widgets", "Runtime", "Desktop", "Examples", "Tooling"]
    states :=["Ready", "Review", "Ready", "Draft", "Ready", "Review"]
    clocks :=["10:30", "11:15", "09:40", "12:00", "10:05", "08:50"]
    $order :=[0, 1, 2, 3, 4, 5]
    col := screen.sort_column(m.table) >>>
    if col == 0 {order =[0, 3, 4, 2, 5, 1]}
    if col == 1 {order =[3, 0, 2, 4, 1, 5]}
    if col == 2 {order =[5, 2, 4, 0, 1, 3]}
    desc := screen.sort_descending(m.table) >>>
    page :=(screen.selected(m.pager) >>>) + 1
    for row in 0:6 {
        $slot := row
        if desc{slot = 5 - row}
        i := order[slot]
        screen.set_cell(m.table, row, 0, names[i] + " / " + str(page)) >>>
        screen.set_cell(m.table, row, 1, states[i]) >>>
        screen.set_cell(m.table, row, 2, clocks[i]) >>>
    }
    << 0
}
fn (m $&Model) layout(screen $&widgets.Screen) int {
    width := screen.width()
    height := screen.height()
    row := screen.row_height()
    for i in 0:3 {
        screen.place(m.nav[i], 28.0 + f64(i) * 124.0, 142.0, 112.0, row) >>>
        screen.set_selected_button(m.nav[i], m.page == i) >>>
        screen.set_visible(m.pages[i], m.page == i) >>>
        screen.place(m.settings[i], width - 420.0 + f64(i) * 132.0, 142.0, 120.0, row) >>>
    }
    screen.place(m.headings[0], 28.0, 26.0, width - 56.0, 24.0) >>>
    screen.place(m.headings[1], 28.0, 61.0, width - 56.0, 46.0) >>>
    screen.place(m.headings[2], 28.0, 108.0, width - 56.0, 30.0) >>>
    screen.place(m.crumbs, 28.0, 204.0, width - 56.0, row) >>>
    screen.place(m.note, 28.0, height - 48.0, width - 56.0, 30.0) >>>
    content := math.max(160.0, height - 420.0)
    screen.place(m.captions[0], 28.0, 253.0, width * 0.62 - 40.0, 30.0) >>>
    screen.place(m.captions[1], width * 0.62 + 12.0, 253.0, width * 0.38 - 40.0, 30.0) >>>
    screen.place(m.table, 28.0, 280.0, width * 0.62 - 40.0, content) >>>
    screen.place(m.tree, width * 0.62 + 12.0, 280.0, width * 0.38 - 40.0, content) >>>
    screen.place(m.pager, 28.0, height - 118.0, 380.0, row) >>>
    screen.place(m.captions[2], 28.0, 253.0, 400.0, 30.0) >>>
    screen.place(m.captions[3], 28.0, 363.0, 400.0, 30.0) >>>
    screen.place(m.captions[4], 450.0, 253.0, width - 478.0, 30.0) >>>
    screen.place(m.combo, 28.0, 280.0, 370.0, row) >>>
    screen.place(m.multi, 28.0, 390.0, 370.0, row) >>>
    screen.place(m.color, 450.0, 280.0, width - 478.0, 240.0) >>>
    screen.place(m.spinner, 28.0, 562.0, 28.0, 28.0) >>>
    screen.place(m.captions[5], 70.0, 568.0, width - 98.0, 30.0) >>>
    screen.place(m.value_label, 28.0, 620.0, width - 56.0, 36.0) >>>
    screen.place(m.captions[6], 28.0, 253.0, width - 56.0, 30.0) >>>
    for i in 0:4 {screen.place(m.overlay_buttons[i], 28.0 + f64(i) * 208.0, 280.0, 190.0, row) >>>
        screen.place(m.captions[i + 7], 28.0, 365.0 + f64(i) * 40.0, width - 56.0, 32.0) >>> }
    screen.place(m.modal_actions[0], 24.0, 210.0, 194.0, row) >>>
    screen.place(m.modal_actions[1], 234.0, 210.0, 194.0, row) >>>
    << 0
}
fn new_model(screen $&widgets.Screen) Model{
    $nav :=[]int {}
    for text in["Data", "Inputs", "Overlays"] {nav.push(screen.button(text) >>>)}
    $settings :=[]int {}
    for text in["Theme", "Text size", "Density"] {settings.push(screen.button(text) >>>)}
    $pages :=[]int {}
    for i in 0:3 {pages.push(screen.group() >>>)}
    headings :=[screen.label("XUUI / COMPONENT CATALOG", 12.0, true) >>>,
    screen.label("Native components, working together.", 26.0, false) >>>,
    screen.label("Keyboard, pointer, themes, typography and density — managed by Screen.", 13.0, true) >>>]
    crumbs := screen.breadcrumbs(&["Workspace", "UI", "Component catalog"]) >>>
    note := screen.label("Choose a category · Tab / Shift+Tab · Escape", 13.0, true) >>>
    table := screen.table(&["Module", "State", "Updated"], 6, 0) >>>
    tree := screen.tree() >>>
    pager := screen.pagination(3, 0) >>>
    combo := screen.combo_box(&["Compiler", "Widgets", "Runtime", "Desktop", "Examples", "工具链"], "") >>>
    multi := screen.multi_select(&["Native", "Keyboard", "IME", "Theming", "Motion"]) >>>
    screen.set_checked(multi, 0, true) >>>
    color := screen.color_picker(draw.rgba(59, 130, 246, 220)) >>>
    spinner := screen.spinner() >>>
    value_label := screen.label("Value:    Selected tags: 1", 14.0, false) >>>
    $overlay_buttons :=[]int {}
    for text in["Open popover", "Open modal", "Show toast", "Hover / focus me"] {overlay_buttons.push(screen.button(text) >>>)}
    popover := screen.popover(overlay_buttons[0], "An anchored panel for related actions.") >>>
    modal := screen.modal("Keep focus where it belongs", "Screen owns focus, input isolation and restoration.") >>>
    _ := screen.tooltip(overlay_buttons[3], "Pointer and keyboard share this hint.") >>>
    modal_actions :=[screen.button("Complete action") >>>, screen.button("Close") >>>]
    for id in modal_actions{screen.set_parent(id, modal) >>> }
    $captions :=[]int {}
    for text in["TABLE / sort columns · select rows · scroll", "TREE / expand · navigate",
    "COMBO BOX / type to filter · native IME", "MULTI SELECT / independent choices",
    "COLOR PICKER / red · green · blue · alpha", "Loading indicator · respects reduced motion",
    "OVERLAYS / anchor placement · focus ownership · timed feedback",
    "Popover: anchored to its trigger and constrained to the canvas.",
    "Modal: Tab stays inside; Escape closes; focus returns to the trigger.",
    "Toast: closes automatically; hover or focus pauses its lifetime.",
    "Tooltip: hover or keyboard focus reveals a delayed explanation."] {captions.push(screen.label(text, 13.0, true) >>>)}
    for id in[table, tree, pager, captions[0], captions[1]] {screen.set_parent(id, pages[0]) >>> }
    for id in[combo, multi, color, spinner, value_label, captions[2], captions[3], captions[4], captions[5]] {screen.set_parent(id, pages[1]) >>> }
    for id in overlay_buttons{screen.set_parent(id, pages[2]) >>> }
    screen.set_parent(popover, pages[2]) >>>
    for i in 6:11 {screen.set_parent(captions[i], pages[2]) >>> }
    root := screen.tree_add(tree, - 1, "XU Workspace") >>>
    compiler := screen.tree_add(tree, root, "Compiler") >>>
    _ := screen.tree_add(tree, compiler, "Frontend") >>>
    _ := screen.tree_add(tree, compiler, "Native backend") >>>
    ui_root := screen.tree_add(tree, root, "UI") >>>
    _ := screen.tree_add(tree, ui_root, "Widgets") >>>
    _ := screen.tree_add(tree, ui_root, "Drawing") >>>
    _ := screen.tree_add(tree, root, "Examples") >>>
    for node in[root, compiler, ui_root] {screen.set_expanded(tree, node, true) >>> }
    m := Model{page: 0, theme: 1, text_scale: 1.0, density: 1.0, appearance_dirty: true, nav: nav, settings: settings, pages: pages, headings: headings, captions: captions,
        table: table, tree: tree, pager: pager, crumbs: crumbs, combo: combo, multi: multi, color: color, spinner: spinner,
        overlay_buttons: overlay_buttons, popover: popover, modal: modal, modal_actions: modal_actions, value_label: value_label, note: note}
    m.fill_table(screen) >>>
    << m
}
fn scene(events chan ui.Event) int {
    ready := demo.ready(events) >>>
    if ready.kind == ui.EV_EXIT{ << 0}
    $screen := widgets.screen(&ready) >>>
    screen.resize(1040.0, 820.0) >>>
    screen.set_min_size(1040, 760) >>>
    $model := new_model($&screen) >>> (err) {screen.dispose()
        >> err}
    actions := register_actions(&model, &screen) >>>
    << widgets.run_screen_actions($&screen, events, $&model, layout_action, &actions) >>>
}
fn worker(events chan ui.Event) {scene(events) >>> (err) {demo.fail(err.msg())
        << }}
fn launch() int {$app := demo.app("Xu UI / Component Catalog", 1040, 820) >>>
    xu worker(app.event_ch)
    << app.run() >>> }
fn main() int { << launch() >>> (err) {eprintln(err.msg())
        << 1}}
