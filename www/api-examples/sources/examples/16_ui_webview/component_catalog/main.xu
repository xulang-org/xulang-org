@main
#ui
#ui/widgets
#ui/draw
#time
#math
demo #"github.com/xulang-org/examples/ui_demo"

// The model contains business choices and screen-local handles only.
struct Model {
    page int
    theme int
    nav []int
    settings []int
    pages []int
    headings []int
    captions []int
    table int
    tree int
    pager int
    crumbs int
    combo int
    multi int
    color int
    spinner int
    overlay_buttons []int
    popover int
    modal int
    modal_actions []int
    value_label int
    note int
}
fn (m &Model) fill_table(screen $&widgets.Screen) int {
    names := ["Compiler","Widgets","Runtime","Desktop","Examples","Tooling"]
    states := ["Ready","Review","Ready","Draft","Ready","Review"]
    clocks := ["10:30","11:15","09:40","12:00","10:05","08:50"]
    $order := [0,1,2,3,4,5]
    col := screen.sort_column(m.table) or >>
    if col == 0 { order = [0,3,4,2,5,1] }
    if col == 1 { order = [3,0,2,4,1,5] }
    if col == 2 { order = [5,2,4,0,1,3] }
    desc := screen.sort_descending(m.table) or >>
    page := (screen.selected(m.pager) or >>) + 1
    for row in 0:6 {
        $slot := row
        if desc { slot = 5 - row }
        i := order[slot]
        screen.set_cell(m.table,row,0,names[i] + " / " + str(page)) or >>
        screen.set_cell(m.table,row,1,states[i]) or >>
        screen.set_cell(m.table,row,2,clocks[i]) or >>
    }
    << 0
}
fn (m $&Model) layout(screen $&widgets.Screen) int {
    width := screen.width()
    height := screen.height()
    row := screen.row_height()
    for i in 0:3 {
        screen.place(m.nav[i],28.0 + f64(i) * 124.0,142.0,112.0,row) or >>
        screen.set_selected_button(m.nav[i],m.page == i) or >>
        screen.set_visible(m.pages[i],m.page == i) or >>
        screen.place(m.settings[i],width - 420.0 + f64(i) * 132.0,142.0,120.0,row) or >>
    }
    screen.place(m.headings[0],28.0,26.0,width - 56.0,24.0) or >>
    screen.place(m.headings[1],28.0,61.0,width - 56.0,46.0) or >>
    screen.place(m.headings[2],28.0,108.0,width - 56.0,30.0) or >>
    screen.place(m.crumbs,28.0,204.0,width - 56.0,row) or >>
    screen.place(m.note,28.0,height - 48.0,width - 56.0,30.0) or >>
    content := math.max(160.0,height - 420.0)
    screen.place(m.captions[0],28.0,253.0,width * 0.62 - 40.0,30.0) or >>
    screen.place(m.captions[1],width * 0.62 + 12.0,253.0,width * 0.38 - 40.0,30.0) or >>
    screen.place(m.table,28.0,280.0,width * 0.62 - 40.0,content) or >>
    screen.place(m.tree,width * 0.62 + 12.0,280.0,width * 0.38 - 40.0,content) or >>
    screen.place(m.pager,28.0,height - 118.0,380.0,row) or >>
    screen.place(m.captions[2],28.0,253.0,400.0,30.0) or >>
    screen.place(m.captions[3],28.0,363.0,400.0,30.0) or >>
    screen.place(m.captions[4],450.0,253.0,width - 478.0,30.0) or >>
    screen.place(m.combo,28.0,280.0,370.0,row) or >>
    screen.place(m.multi,28.0,390.0,370.0,row) or >>
    screen.place(m.color,450.0,280.0,width - 478.0,240.0) or >>
    screen.place(m.spinner,28.0,562.0,28.0,28.0) or >>
    screen.place(m.captions[5],70.0,568.0,width - 98.0,30.0) or >>
    screen.place(m.value_label,28.0,620.0,width - 56.0,36.0) or >>
    screen.place(m.captions[6],28.0,253.0,width - 56.0,30.0) or >>
    for i in 0:4 { screen.place(m.overlay_buttons[i],28.0 + f64(i) * 208.0,280.0,190.0,row) or >>
        screen.place(m.captions[i + 7],28.0,365.0 + f64(i) * 40.0,width - 56.0,32.0) or >> }
    screen.place(m.modal_actions[0],24.0,210.0,194.0,row) or >>
    screen.place(m.modal_actions[1],234.0,210.0,194.0,row) or >>
    << 0
}
fn (m $&Model) update(screen $&widgets.Screen,action widgets.Action) int {
    if action.kind == widgets.ACTION_KEY && int(action.value) == ui.KEY_ESCAPE { screen.close() or >> }
    if action.kind == widgets.ACTION_ACTIVATE {
        for i in 0:3 { if action.id == m.nav[i] { m.page = i } }
        if action.id == m.settings[0] { m.theme = (m.theme + 1) % 3
            current := screen.styles()
            $next := widgets.preset_styles(m.theme) or >>
            next.text_scale = current.text_scale
            next.density = current.density
            screen.set_styles(&next) or >> }
        if action.id == m.settings[1] || action.id == m.settings[2] {
            $styles := screen.styles()
            if action.id == m.settings[1] { if styles.text_scale == 1.0 { styles.text_scale = 1.4 }
                else { styles.text_scale = 1.0 } }
            else { if styles.density == 1.0 { styles.density = 0.8 }
                else { styles.density = 1.0 } }
            screen.set_styles(&styles) or >>
        }
        if action.id == m.table { m.fill_table(screen) or >> }
        if action.id == m.overlay_buttons[0] { screen.open(m.popover) or >> }
        if action.id == m.overlay_buttons[1] { screen.open(m.modal) or >> }
        if action.id == m.overlay_buttons[2] { _ := screen.notify("All components share the same theme.") or >> }
        if action.id == m.modal_actions[0] || action.id == m.modal_actions[1] { screen.close_overlay(m.modal) or >>
            if action.id == m.modal_actions[0] { _ := screen.notify("Action completed.") or >> } }
    }
    if action.kind == widgets.ACTION_CHANGE {
        if action.id == m.pager { m.fill_table(screen) or >> }
        if action.id == m.combo || action.id == m.multi {
            value := screen.text_value(m.combo) or >>
            count := (screen.values(m.multi) or >>).len
            screen.set_text(m.value_label,"Value: " + value + "    Selected tags: " + str(count)) or >>
        }
        screen.set_text(m.note,"Value changed · Tab / Shift+Tab · Escape") or >>
    }
    << 0
}
fn new_model(screen $&widgets.Screen) Model {
    $nav := []int{}
    for text in ["Data","Inputs","Overlays"] { nav.push(screen.button(text) or >>) }
    $settings := []int{}
    for text in ["Theme","Text size","Density"] { settings.push(screen.button(text) or >>) }
    $pages := []int{}
    for i in 0:3 { pages.push(screen.group() or >>) }
    headings := [screen.label("XUUI / COMPONENT CATALOG",12.0,true) or >>,
        screen.label("Native components, working together.",26.0,false) or >>,
        screen.label("Keyboard, pointer, themes, typography and density — managed by Screen.",13.0,true) or >>]
    crumbs := screen.breadcrumbs(&["Workspace","UI","Component catalog"]) or >>
    note := screen.label("Choose a category · Tab / Shift+Tab · Escape",13.0,true) or >>
    table := screen.table(&["Module","State","Updated"],6,0) or >>
    tree := screen.tree() or >>
    pager := screen.pagination(3,0) or >>
    combo := screen.combo_box(&["Compiler","Widgets","Runtime","Desktop","Examples","工具链"],"") or >>
    multi := screen.multi_select(&["Native","Keyboard","IME","Theming","Motion"]) or >>
    screen.set_checked(multi,0,true) or >>
    color := screen.color_picker(draw.rgba(59,130,246,220)) or >>
    spinner := screen.spinner() or >>
    value_label := screen.label("Value:    Selected tags: 1",14.0,false) or >>
    $overlay_buttons := []int{}
    for text in ["Open popover","Open modal","Show toast","Hover / focus me"] { overlay_buttons.push(screen.button(text) or >>) }
    popover := screen.popover(overlay_buttons[0],"An anchored panel for related actions.") or >>
    modal := screen.modal("Keep focus where it belongs","Screen owns focus, input isolation and restoration.") or >>
    _ := screen.tooltip(overlay_buttons[3],"Pointer and keyboard share this hint.") or >>
    modal_actions := [screen.button("Complete action") or >>,screen.button("Close") or >>]
    for id in modal_actions { screen.set_parent(id,modal) or >> }
    $captions := []int{}
    for text in ["TABLE / sort columns · select rows · scroll","TREE / expand · navigate",
        "COMBO BOX / type to filter · native IME","MULTI SELECT / independent choices",
        "COLOR PICKER / red · green · blue · alpha","Loading indicator · respects reduced motion",
        "OVERLAYS / anchor placement · focus ownership · timed feedback",
        "Popover: anchored to its trigger and constrained to the canvas.",
        "Modal: Tab stays inside; Escape closes; focus returns to the trigger.",
        "Toast: closes automatically; hover or focus pauses its lifetime.",
        "Tooltip: hover or keyboard focus reveals a delayed explanation."] { captions.push(screen.label(text,13.0,true) or >>) }
    for id in [table,tree,pager,captions[0],captions[1]] { screen.set_parent(id,pages[0]) or >> }
    for id in [combo,multi,color,spinner,value_label,captions[2],captions[3],captions[4],captions[5]] { screen.set_parent(id,pages[1]) or >> }
    for id in overlay_buttons { screen.set_parent(id,pages[2]) or >> }
    screen.set_parent(popover,pages[2]) or >>
    for i in 6:11 { screen.set_parent(captions[i],pages[2]) or >> }
    root := screen.tree_add(tree,-1,"XU Workspace") or >>
    compiler := screen.tree_add(tree,root,"Compiler") or >>
    _ := screen.tree_add(tree,compiler,"Frontend") or >>
    _ := screen.tree_add(tree,compiler,"Native backend") or >>
    ui_root := screen.tree_add(tree,root,"UI") or >>
    _ := screen.tree_add(tree,ui_root,"Widgets") or >>
    _ := screen.tree_add(tree,ui_root,"Drawing") or >>
    _ := screen.tree_add(tree,root,"Examples") or >>
    for node in [root,compiler,ui_root] { screen.set_expanded(tree,node,true) or >> }
    m := Model{page: 0,theme: 1,nav: nav,settings: settings,pages: pages,headings: headings,captions: captions,
        table: table,tree: tree,pager: pager,crumbs: crumbs,combo: combo,multi: multi,color: color,spinner: spinner,
        overlay_buttons: overlay_buttons,popover: popover,modal: modal,modal_actions: modal_actions,value_label: value_label,note: note}
    m.fill_table(screen) or >>
    << m
}
fn scene(events chan ui.Event) int {
    ready := demo.ready(events) or >>
    if ready.kind == ui.EV_EXIT { << 0 }
    $screen := widgets.screen(&ready) or >>
    screen.resize(1040.0,820.0) or >>
    screen.set_min_size(1040,760) or >>
    $model := new_model($&screen) or (err) { screen.dispose()
        >> err }
    << widgets.run_screen($&screen,events,$&model) or >>
}
fn worker(events chan ui.Event) { scene(events) or (err) { demo.fail(err.msg())
    << } }
fn launch() int { $app := demo.app("Xu UI / Component Catalog",1040,820) or >>
    xu worker(app.event_ch)
    << app.run() or >> }
fn main() int { << launch() or (err) { eprintln(err.msg())
    << 1 } }
