fn sample_action_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    if a.kind == widgets.ACTION_COMMIT{s.set_text(m.status, "Committed value · " + str(int(a.value))) or >> }
    if a.kind == widgets.ACTION_ACTIVATE{s.set_text(m.status, "Activated / 已激活 · control " + str(a.id)) or >> }
    << 0
}
fn navigate_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    old := m.page_snapshot(m.selected)
    if m.selected == 33 || m.selected == 36 {s.close_overlay(old.ids[1]) or >> }
    m.controls_dirty = true
    m.selected = s.selected(m.navigation) or >>
    s.set_scroll_offset(m.preview, 0.0) or >>
    m.appearance_dirty = true
    << 0
}
fn language_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int { << m.apply_locale(s) or >> }
fn appearance_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {m.appearance_dirty = true
    << 0}
fn custom_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {m.customized = !m.customized
    m.controls_dirty = true
    m.appearance_dirty = true
    << 0}
fn motion_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {m.slow = !m.slow
    m.controls_dirty = true
    m.appearance_dirty = true
    << 0}
fn focus_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    page := m.page_snapshot(m.selected)
    $target := page.ids[0]
    if m.selected == 31 {target = page.ids[6]}
    s.focus(target) or >>
    << 0
}
fn tree_filter_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    s.set_tree_filter(m.pages[7].ids[0], s.text_value(a.id) or >>) or >>
    << 0
}
fn multi_filter_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    s.set_multi_filter(m.pages[17].ids[0], s.text_value(a.id) or >>) or >>
    << 0
}
fn slider_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    s.set_value(m.pages[13].ids[1], str(int(a.value))) or >>
    << sample_action_update(m, s, a) or >>
}
fn color_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    s.set_value(m.pages[20].ids[1], s.color_hex(a.id) or >>) or >>
    s.set_field_invalid(m.pages[20].ids[1], false) or >>
    << sample_action_update(m, s, a) or >>
}
fn pagination_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int { << m.update_pagination(s, true) or >> }
fn page_size_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    page := m.page_snapshot(25)
    data := s.pagination_data(page.ids[0]) or >>
    sizes :=[10, 20, 50, 100]
    s.set_pagination_data(page.ids[0], max_int_local(0, data.total), sizes[s.selected(a.id) or >>]) or >>
    << m.update_pagination(s, true) or >>
}
fn page_submitted_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int { << tool_25_update(m, s, 0) or >> }
fn task_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    if m.running{ << 0}
    m.revision += 1
    m.completed = 0
    m.checksum = 0
    m.running = true
    m.deadline = time.instant()
    s.begin_task(a.id, m.revision) or >>
    << 0
}
fn inbox_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {m.unread = 0
    << m.update_badges(s) or >> }
fn online_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {m.online = !m.online
    << m.update_badges(s) or >> }
fn preferences_open_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int { << m.open_preferences(s) or >> }
fn preferences_cancel_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.close_overlay(m.pages[33].ids[1]) or >>
    << 0}
fn preferences_apply_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    page := m.page_snapshot(33)
    name := s.text_value(page.ids[4]) or >>
    if name.len == 0 {s.set_field_invalid(page.ids[4], true) or >>
        << 0}
    s.set_field_invalid(page.ids[4], false) or >>
    $history := "off"
    if s.toggle_value(page.ids[5]) or >> {history = "on"}
    m.preferences_name = name
    m.preferences_history = s.toggle_value(page.ids[5]) or >>
    s.set_text(page.ids[8], "Current: " + m.preferences_name + " · history " + history) or >>
    s.close_overlay(page.ids[1]) or >>
    << 0
}
fn notice_clicked_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int { << tool_35_update(m, s, 0) or >> }
fn notice_action_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.set_text(m.status, "Undo requested · business state can now be restored.") or >>
    << 0}
fn modal_open_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.open(m.pages[36].ids[1]) or >>
    << 0}
fn modal_close_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.close_overlay(m.pages[36].ids[1]) or >>
    << 0}
fn group_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    values := s.button_group_values(a.id) or >>
    s.set_text(m.status, "ButtonGroup · key " + str(int(a.value)) + " · selected " + str(values.len)) or >>
    << 0
}
fn chart_kind_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    m.controls_dirty = true
    m.chart_kind = int(a.value) - 1
    series := chart_data(m.chart_kind, m.revision)
    s.set_chart_series(m.pages[39].ids[0], &series) or >>
    s.reset_chart_viewport(m.pages[39].ids[0]) or >>
    m.appearance_dirty = true
    << 0
}
fn chart_hit_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    $hit := s.chart_hovered(a.id) or >>
    if a.kind == widgets.ACTION_CHART_SELECT{hit = s.chart_selection(a.id) or >> }
    if hit.valid{s.set_text(m.status, "Series " + str(hit.series_id) + " / point " + str(hit.point_id) + " · " + str(int(hit.y))) or >> }
    << 0
}
fn chart_viewport_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.set_text(m.status, "Viewport updated · Double click / Home to reset") or >>
    << 0}
fn range_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int { << m.range_summary(s, a.kind == widgets.ACTION_COMMIT) or >> }
fn split_committed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.set_text(m.status, "Split ratio / 分栏比例 · " + str(int(math.round(a.value * 100.0))) + "%") or >>
    << 0}
fn menu_action_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    for index in 42:45 {page := m.page_snapshot(index)
        if page.ids[0] == a.id{s.set_text(page.ids[1], "Action / 操作 · " + str(int(a.value))) or >> }}
    << 0
}
fn password_visibility_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.set_password_visible(m.pages[45].ids[0], s.toggle_value(a.id) or >>) or >>
    << 0}
fn table_sorted_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    $direction := "ascending / 升序"
    if s.sort_descending(a.id) or >> {direction = "descending / 降序"}
    selected := s.table_selected_row(a.id) or >>
    s.set_text(m.status, "Sorted / 已排序 · " + direction + " · source row " + str(selected)) or >>
    << 0
}
fn node_action_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {s.set_text(m.status, "Node action · " + str(int(a.value))) or >>
    << 0}
fn webview_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    if m.selected != 37 { << 0}s.set_text(m.status, "WebView · event " + str(a.kind) + " · " + str(int(a.value))) or >>
    << 0}

fn state_changed_update(m $&Workshop, s $&widgets.Screen, a &widgets.Action) int {
    m.controls_dirty = true
    << 0
}
