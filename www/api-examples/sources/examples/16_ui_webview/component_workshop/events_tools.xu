    page := m.page_snapshot(28)
    id := page.ids[0]
    if option < 2 {s.set_running(id, option == 0) or >> }
    else {m.spinner_options_dirty = true}
    << 0
}

fn tool_30_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(30)
    id := page.ids[0]
    if option == 0 {m.unread += 1}
    if option == 1 {m.unread = 0}
    if option == 2 {m.unread = 123}
    m.update_badges(s) or >>
    << 0
}

fn tool_32_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(32)
    id := page.ids[0]
    if option == 0 {s.set_scroll_offset(id, 0.0) or >> }
    if option == 1 {s.set_scroll_offset(id, 100000.0) or >> }
    if option == 2 {s.focus(page.ids[page.ids.len - 1]) or >> }
    << 0
}

fn tool_33_update(m $&Workshop, s $&widgets.Screen, option int) int {
    index := 33
    page := m.page_snapshot(33)
    id := page.ids[0]
    if option == 2 {m.variant =(m.variant + 1) % 4
        m.popover_options_dirty = true}
    if option == 0 {if index == 33 {m.open_preferences(s) or >> } else {s.open(page.ids[1]) or >> }}
    else if option == 1 {s.close_overlay(page.ids[1]) or >> }
    << 0
}

fn tool_34_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(34)
    id := page.ids[0]
    if option == 2 {m.tooltip_side =(m.tooltip_side + 1) % 4
        m.appearance_dirty = true
        s.focus(id) or >>
        s.set_text(m.status, "Tooltip · " +["Bottom 下", "Top 上", "Left 左", "Right 右"][m.tooltip_side] + " · flips at the viewport edge") or >> }
    if option == 0 {s.focus(id) or >> }
    else if option == 1 {s.focus(0) or >> }
    << 0
}

fn tool_35_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(35)
    id := page.ids[0]
    $notice := widgets.notice(&"Workspace saved · 工作区已保存")
    notice.action = "Undo"
    notice.key = "workspace-save"
    if option == 1 {notice.text = "Changes restored · 已撤销"
        notice.key = "workspace-undo"}
    $count := 1
    if option == 2 {count = 3}
    for i in 0:count{if count > 1 {notice.key = "notice-" + str(i)
            notice.text = "Queued notice " + str(i + 1)}
        _ := s.enqueue_notice(&notice) or >> }
    << 0
}

fn tool_36_update(m $&Workshop, s $&widgets.Screen, option int) int {
    index := 36
    page := m.page_snapshot(36)
    id := page.ids[0]
    if option == 0 {if index == 33 {m.open_preferences(s) or >> } else {s.open(page.ids[1]) or >> }}
    else if option == 1 {s.close_overlay(page.ids[1]) or >> }
    << 0
}

fn tool_37_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(37)
    id := page.ids[0]
    if option == 0 {native := s.webview_native(id) or >>
        client := webview.bind_native(&native) or >>
        client.command("reload") or >> }
    else {s.set_visible(id, option == 2) or >> }
    << 0
}

fn tool_38_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(38)
    id := page.ids[0]
    if option == 0 {m.group_disabled = !m.group_disabled
        m.controls_dirty = true}
    if option == 1 {m.group_vertical = !m.group_vertical}
    if option == 2 {m.group_joined = !m.group_joined}
    m.appearance_dirty = true
    << 0
}

fn tool_39_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(39)
    id := page.ids[0]
    if option == 0 {m.revision += 1
        series := chart_data(m.chart_kind, m.revision)
        s.set_chart_series(id, &series) or >>
        m.chart_paused = false}
    if option == 1 {s.reset_chart_viewport(id) or >> }
    if option == 2 {m.chart_paused = !m.chart_paused
        if m.chart_paused{s.pause_chart_animation(id) or >> }
        else {s.resume_chart_animation(id) or >> }}
    << 0
}

fn tool_40_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(40)
    id := page.ids[0]
    if option == 0 {m.range_push = !m.range_push}
    if option == 1 {m.range_commit = !m.range_commit}
    if option == 2 {m.range_vertical = !m.range_vertical}
    m.appearance_dirty = true
    m.range_summary(s, false) or >>
    << 0
}

fn tool_41_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(41)
    id := page.ids[0]
    if option == 0 {m.split_vertical = !m.split_vertical
        m.appearance_dirty = true}
    if option == 1 {m.split_collapsed =(s.split_layout(id) or >>).collapsed == 0
        s.set_split_collapsed(id, 0, m.split_collapsed) or >> }
    if option == 2 {m.split_collapsed = false
        s.set_split_ratio(id, 0.4) or >> }
    << 0
}

