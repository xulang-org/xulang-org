        s.set_value(id, value) or >> }
    if option == 2 && index >= 5 {m.field_options_dirty = true
        m.field_options_page = index
        m.variant += 1}
    << 0
}

fn tool_6_update(m $&Workshop, s $&widgets.Screen, option int) int {
