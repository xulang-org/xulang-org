@main

#ui/widgets
#ui/webview
#time
#math
#errors
#strconv

fn tool_0_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(0)
    id := page.ids[0]
    $text := "精密 · 清晰 · 可靠。"
    if option == 0 {text = "长中文：输入、选择、复制与原生排版保持一致。Long English text wraps inside its content width. Family 👨‍👩‍👧‍👦 and developer 👩🏽‍💻 remain intact."}
    s.set_text(id, text) or >>
    << 0
}

