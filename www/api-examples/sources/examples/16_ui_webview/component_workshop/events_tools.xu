}

fn tool_7_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(7)
    id := page.ids[0]
    if option == 0 {m.guided = !m.guided
        m.tree_options_dirty = true}
    if option == 1 {s.set_selected(id, 7) or >>
        s.focus(id) or >> }
    if option == 2 {s.set_value(page.ids[1], "") or >>
        s.set_tree_filter(id, "") or >> }
    << 0
}

fn tool_8_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(8)
    id := page.ids[0]
    if option == 0 {m.variant += 1
        s.set_task_progress_mode(id, m.variant % 3) or >> }
    if option == 1 {m.failure = !m.failure
        s.set_selected_button(m.tools[1], m.failure) or >> }
    if option == 2 && m.running{_ := s.complete_task(id, m.revision, widgets.TASK_CANCELLED) or >>
        m.running = false}
    << 0
}

fn tool_9_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(9)
    id := page.ids[0]
    s.set_checkbox_indeterminate(id, option == 0) or >>
    if option > 0 {s.set_toggle_value(id, option == 1) or >> }
    << 0
}

fn tool_10_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(10)
    id := page.ids[0]
    if option == 0 {m.pending_before = s.toggle_value(id) or >>
        s.set_switch_pending(id, true) or >>
        s.set_text(id, "Live preview · Saving…") or >> }
    else {s.set_switch_pending(id, false) or >>
        s.set_toggle_value(id, option == 1 || m.pending_before) or >>
        s.set_invalid(id, option == 2) or >>
        s.set_text(id, "Live preview 实时预览") or >> }
    << 0
}

fn tool_11_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(11)
    id := page.ids[0]
    s.set_toggle_value(id, option == 0) or >>
    << 0
}

fn tool_13_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(13)
    id := page.ids[0]
    if option > 0 {s.set_slider_commit_only(id, option == 1) or >> }
    else {text := s.text_value(page.ids[1]) or >>
        value := strconv.parse_float(&text) or(err) {s.set_field_invalid(page.ids[1], true) or >>
            << 0}
        if math.is_nan(value) || math.is_inf(value) || value < 0.0 || value > 100.0 {s.set_field_invalid(page.ids[1], true) or >>
            << 0}
        s.set_number_value(id, value) or >>
        s.set_field_invalid(page.ids[1], false) or >> }
    << 0
}

fn tool_15_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(15)
    id := page.ids[0]
    if option == 0 {s.set_candidate_open(id, true) or >> }
    else {s.set_select_option_enabled(id, 2, false) or >> }
    << 0
}

fn tool_16_update(m $&Workshop, s $&widgets.Screen, option int) int {
    page := m.page_snapshot(16)
    id := page.ids[0]
    if option < 2 {s.set_combo_custom_values(id, option == 0) or >> }
    else {s.set_value(id, "") or >> }
    << 0
}

