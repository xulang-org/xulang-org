@main

#errors
#os
#strings

fn env_or(name string, fallback string) string {
    v := os.getenv(name)
    if v.len > 0 {
        << v
    }
    << fallback
}

fn site_root() string {
    env := os.getenv("XU_SITE_ROOT")
    if env.len > 0 {
        << env
    }
    << "."
}

fn content_dir() string {
    << site_root() + "/content"
}

fn www_dir() string {
    << site_root() + "/www"
}

fn cut_query(p string) string {
    mut i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[0:i]
        }
        i = i + 1
    }
    << p + ""
}

fn is_safe_rel(p string) bool {
    if p.len == 0 {
        << false
    }
    if strings.contains(&p, "..") {
        << false
    }
    mut i := 0
    while i < p.len {
        c := p[i] & 255
        mut ok := false
        if c >= 97 && c <= 122 {
            ok = true
        }
        if c >= 65 && c <= 90 {
            ok = true
        }
        if c >= 48 && c <= 57 {
            ok = true
        }
        if c == 47 || c == 45 || c == 95 || c == 46 {
            ok = true
        }
        if !ok {
            << false
        }
        i = i + 1
    }
    << true
}

fn strip_slash(p string) string {
    if p.len <= 1 {
        << p + ""
    }
    last := p[p.len - 1] & 255
    if last == 47 {
        << p[0:(p.len - 1)]
    }
    << p + ""
}

fn is_en_path(p string) bool {
    if p == "/en" {
        << true
    }
    << strings.has_prefix(&p, "/en/")
}

fn lang_of(p string) string {
    if is_en_path(p + "") {
        << "en"
    }
    << "zh"
}

fn rest_path(p string) string {
    if p == "/en" {
        << "/"
    }
    if strings.has_prefix(&p, "/en/") {
        << p[3:p.len]
    }
    << p + ""
}

fn other_lang_href(p string) string {
    if is_en_path(p + "") {
        r := rest_path(p + "")
        if r == "/" {
            << "/"
        }
        << r
    }
    if p == "/" {
        << "/en"
    }
    << "/en" + p
}

fn ctype_of(name string) string {
    if strings.has_suffix(&name, ".css") {
        << "text/css; charset=utf-8"
    }
    if strings.has_suffix(&name, ".svg") {
        << "image/svg+xml"
    }
    if strings.has_suffix(&name, ".js") {
        << "text/javascript; charset=utf-8"
    }
    if strings.has_suffix(&name, ".wasm") {
        << "application/wasm"
    }
    if strings.has_suffix(&name, ".png") {
        << "image/png"
    }
    if strings.has_suffix(&name, ".jpg") || strings.has_suffix(&name, ".jpeg") {
        << "image/jpeg"
    }
    if strings.has_suffix(&name, ".html") {
        << "text/html; charset=utf-8"
    }
    if strings.has_suffix(&name, ".woff") {
        << "font/woff"
    }
    if strings.has_suffix(&name, ".woff2") {
        << "font/woff2"
    }
    if strings.has_suffix(&name, ".ttf") {
        << "font/ttf"
    }
    if strings.has_suffix(&name, ".exe") {
        << "application/vnd.microsoft.portable-executable"
    }
    << "application/octet-stream"
}
