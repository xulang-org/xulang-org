@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := playground.light_theme()
    styles := playground.light_styles()
    bounds := box(48.0,114.0,200.0,42.0)
    $btn := widgets.button(&identity,1,&bounds) or >>
    $lbl := widgets.styled_label(&context,&"Enqueue notification")
    $focus := widgets.focus_group(&identity,[1]) or >>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        nav := focus.input(&event)
        btn.set_focus(focus.current() == 1)
        if nav.consumed { -> }
        act := btn.input(&event)
        if act.request_focus { focus.focus(1) or >> }
    }
    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  ToastHost") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"最多三条可见通知；队列、去重、优先级与撤销动作。") or >>
    btn.paint_styled($&frame,$&lbl,&styles) or >>
    frame.fill_rect(280.0,96.0,300.0,44.0,draw.rgb(255,255,255)) or >>
    frame.stroke_rect(280.0,96.0,300.0,44.0,draw.rgb(4,120,87),1.5) or >>
    demo_center_text($&frame,&context,296,96.0,44.0,13,draw.rgb(4,120,87),"✓ Workspace saved 已成功保存") or >>
    frame.fill_rect(280.0,148.0,300.0,44.0,draw.rgb(255,255,255)) or >>
    frame.stroke_rect(280.0,148.0,300.0,44.0,draw.rgb(0,95,158),1.5) or >>
    demo_center_text($&frame,&context,296,148.0,44.0,13,draw.rgb(0,95,158),"ℹ Syncing remote changes 同步中…") or >>
    demo_text($&frame,&context,48,174,12,draw.rgb(109,98,110),"支持去重、优先级与撤销动作 · 最多 3 条同时可见") or >>
    message := "Active toasts: 2"
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message + "") or >>
    println(message)
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
