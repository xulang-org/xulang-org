@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn char_from_key(key int, shift bool) string {
    if key == 32 { << " " }
    if key >= 65 && key <= 90 {
        lower := "abcdefghijklmnopqrstuvwxyz"
        upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx := key - 65
        if !shift { << lower[idx:idx + 1] }
        << upper[idx:idx + 1]
    }
    if key >= 48 && key <= 57 {
        digits := "0123456789"
        symbols := ")!@#\$%^&*("
        idx := key - 48
        if shift { << symbols[idx:idx + 1] }
        << digits[idx:idx + 1]
    }
    if key == 45 { if shift { << "_" } << "-" }
    if key == 61 { if shift { << "+" } << "=" }
    if key == 46 { if shift { << ">" } << "." }
    if key == 44 { if shift { << "<" } << "," }
    if key == 47 { if shift { << "?" } << "/" }
    if key == 58 || key == 59 { if shift { << ":" } << ";" }
    if key == 64 { << "@" }
    << ""
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    styles := playground.light_styles()
    bounds := box(48.0,114.0,360.0,42.0)
    $check := widgets.checkbox(&identity,2,&box(428.0,114.0,140.0,42.0),false) or >>
    $check_lbl := widgets.styled_label(&context,&"显示密码")
    $focus := widgets.focus_group(&identity,[2]) or >>
    $show_pwd := false
    $text := "Xu-Secret-2026!"
    $focused := false

    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == 72 {
            px := event.x
            py := event.y
            if px >= bounds.x && px <= bounds.x + bounds.width && py >= bounds.y && py <= bounds.y + bounds.height {
                focused = true
            } else {
                focused = false
            }
        }
        if event.kind == 78 {
            if event.key == 257 { focused = !focused }
            if focused {
                if event.key == 259 {
                    if text.len > 0 { text = text[0:text.len - 1] }
                } else if event.key == 256 {
                    focused = false
                } else if text.len < 32 {
                    shift := (event.modifiers & 1) != 0
                    ch := char_from_key(event.key, shift)
                    if ch.len > 0 { text = text + ch }
                }
            }
        }
        nav := focus.input(&event)
        check.set_focus(focus.current() == 2)
        if nav.consumed { -> }
        act := check.input(&event)
        if act.request_focus { focus.focus(2) or >> }
        if act.kind == widgets.ACTION_CHANGE { show_pwd = check.value() }
    }

    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  PasswordInput") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"按 Unicode 字素掩码；显隐切换、原生编辑、只读与禁用，禁止复制或剪切密码。") or >>

    bx := int(bounds.x)
    by := int(bounds.y)
    demo_text($&frame,&context,bx,by - 24,14,draw.rgb(40,35,41),"Password 密码 *") or >>

    frame.fill_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(255,255,255)) or >>
    if focused {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(40,35,41),2.0) or >>
    } else {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(133,121,135),1.0) or >>
    }

    if show_pwd {
        demo_center_text($&frame,&context,bx + 12,bounds.y,bounds.height,15,draw.rgb(40,35,41),text + "") or >>
    } else {
        $bullets := ""
        for i in 0:text.len { bullets = bullets + "•" }
        demo_center_text($&frame,&context,bx + 12,bounds.y,bounds.height,15,draw.rgb(40,35,41),bullets + "") or >>
    }
    if focused {
        caret_x := bx + 12 + int(f64(text.len) * 8.6)
        frame.line(f64(caret_x),bounds.y+(bounds.height-16.0)*0.5,f64(caret_x),bounds.y+(bounds.height+16.0)*0.5,draw.rgb(190,18,60),1.5) or >>
    }

    check.paint_styled($&frame,$&check_lbl,&styles) or >>
    demo_text($&frame,&context,bx,by + int(bounds.height) + 8,12,draw.rgb(109,98,110),"显隐切换保留内容与光标 · 禁止复制剪切密码") or >>
    $message := "Password: masked (" + str(text.len) + " chars)"
    if show_pwd {
        message = "Password: plain (" + str(text.len) + " chars)"
    }
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message + "") or >>
    println(message)
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
