@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := widgets.default_theme()
    styles := widgets.dark_styles()
    bounds := box(32.0,86.0,550.0,160.0)
    $control := widgets.card(&bounds) or >>
    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(draw.rgb(16,24,39)) or >>
    draw.text(32,24,24,"#f8fafc","Card")
    control.paint($&frame,&theme) or >>
    draw.text(48,110,20,"#f8fafc","Xu workspace")
    draw.text(48,146,16,"#cbd5e1","A place for your next idea.")
    draw.text(32,320,16,"#e2e8f0","Card rendered.")
    println("Card rendered.")
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
