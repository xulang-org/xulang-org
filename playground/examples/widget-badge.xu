@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := playground.light_theme()
    styles := playground.light_styles()
    bounds := box(48.0,116.0,100.0,36.0)
    $control := widgets.badge(&bounds) or >>
    $count := 0
    $trigger := widgets.button(&identity,2,&box(48.0,260.0,240.0,40.0)) or >>
    $trigger_label := widgets.styled_label(&context,&"Add count / 增加计数")
    $focus := widgets.focus_group(&identity,[2]) or >>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        navigation := focus.input(&event)
        trigger.set_focus(focus.current() == 2)
        if navigation.consumed { -> }
        action := trigger.input(&event)
        if action.request_focus { focus.focus(2) or >> }
        if action.kind == widgets.ACTION_ACTIVATE { count += 1 }
    }
    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  Badge") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"为内容补充数量或状态") or >>
    badge_label := context.layout_text(&str(count),&draw.text_options(16.0)) or >>
    control.paint($&frame,&badge_label,&theme) or >>
    trigger.paint_styled($&frame,$&trigger_label,&styles) or >>
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),"Count: " + str(count)) or >>
    println("Count: " + str(count))
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
