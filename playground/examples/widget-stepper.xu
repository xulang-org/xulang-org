@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground
#time

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := playground.light_theme()
    styles := playground.light_styles()
    options := ["Design","Develop","Review"]
    headers := ["Workspace","Members"]
    bounds := box(32.0,86.0,550.0,44.0)
    $control := widgets.stepper(&identity,1,&bounds,0.0,100.0,5.0,40.0) or >>
    $last := 0
    $focus := widgets.focus_group(&identity,[1]) or >>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        navigation := focus.input(&event)
        control.set_focus(focus.current() == 1)
        if navigation.consumed { -> }
        action := control.input(&event) or >>
        if action.request_focus { focus.focus(1) or >> }
        if action.kind == widgets.ACTION_ACTIVATE { last = int(action.value) }
    }
    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) or >>
    draw.text(32,22,20,"#282329","XUUI  /  Stepper")
    draw.text(32,48,12,"#6d626e","按固定步长增减数值")
    value := str(int(control.value()))
    label := context.layout_text(&value,&draw.text_options(16.0)) or >>
    control.paint($&frame,&label,&theme) or >>
    message := "Value: " + str(int(control.value()))
    draw.text(32,326,13,"#6d626e",message + "")
    println(message)
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
