@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground
#time

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x:x,y:y,width:w,height:h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    styles := playground.light_styles()
    $btn := widgets.date_picker(&context,&identity,1,&box(48.0,88.0,220.0,44.0),time.date(2026,10,31,0,0,0,0)) or >>
    btn.set_clearable(true)
    btn.apply_styles(&styles) or >>
    $reset := widgets.button(&identity,2,&box(288.0,88.0,120.0,44.0)) or >>
    $clear := widgets.button(&identity,3,&box(424.0,88.0,120.0,44.0)) or >>
    $opened := false
    $focus := widgets.focus_group(&identity,[1,2,3]) or >>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == ui.EV_POINTER_CANCEL { focus.clear() }
        nav := focus.input(&event)
        btn.set_focus(focus.current() == 1)
        reset.set_focus(focus.current() == 2)
        clear.set_focus(focus.current() == 3)
        if nav.consumed { -> }
        act := btn.input(&event)
        if act.request_focus { focus.focus(1) or >> }
        if act.kind == widgets.ACTION_ACTIVATE {
            opened = !opened
            btn.set_open(opened)
        }
        if act.kind == widgets.ACTION_CHANGE {
            opened = btn.is_open()
        }
        reset_action := reset.input(&event)
        clear_action := clear.input(&event)
        if reset_action.request_focus { focus.focus(2) or >> }
        if clear_action.request_focus { focus.focus(3) or >> }
        if reset_action.kind == widgets.ACTION_ACTIVATE {
            btn.set_value(time.date(2026,10,31,0,0,0,0)) or >>
        }
        if clear_action.kind == widgets.ACTION_ACTIVATE {
            btn.clear() or >>
        }
        if opened && event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ESCAPE {
            opened = false
            btn.set_open(false)
            focus.focus(1) or >>
        }
    }
    $frame := context.new_frame(16384)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,styles.input.palette.normal) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,styles.button.palette.border,1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  DatePicker") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"标准日期拾取组件：支持日期展示、弹出日历网格选择与清空重置。") or >>
    $value := "Choose date 选择日期"
    if btn.has_value() { value = btn.display_text() or >> }
    btn.paint_styled($&frame,&styles) or >>
    $reset_label := widgets.styled_label(&context,&"Reset 重置")
    $clear_label := widgets.styled_label(&context,&"Clear 清空")
    reset.paint_styled($&frame,$&reset_label,&styles) or >>
    clear.paint_styled($&frame,$&clear_label,&styles) or >>
    demo_text($&frame,&context,48,150,14,draw.rgb(40,35,41),"选择日期：点击展开日历网格 · 支持月份切换与日期点选") or >>
    demo_text($&frame,&context,48,172,12,draw.rgb(109,98,110),"顶部操作：Reset 恢复 2026-10-31 · Clear 清空选择 · Escape 关闭") or >>
    if opened {
        btn.paint_popup_styled($&frame,&styles) or >>
    }
    message := "Date: "+value
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message+"") or >>
    println(message)
    frame.present() or >>
    << 0
}
fn main() int { << demo() or (err) { eprintln(err.msg())
    << 1 } }
