@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground
#time

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := playground.light_theme()
    styles := playground.light_styles()
    options := ["Design","Develop","Review"]
    headers := ["Workspace","Members"]
    bounds := box(32.0,86.0,550.0,180.0)
    $control := widgets.chart(&context,&identity,1,&bounds) >>>
    $last := 0
    $series := widgets.chart_series(1,"Workspace",widgets.CHART_BAR)
    series.points = [widgets.chart_point(1,1.0,12.0),widgets.chart_point(2,2.0,8.0),widgets.chart_point(3,3.0,5.0)]
    control.set_series(&[series]) >>>
    _ := control.tick(&styles,time.instant_from_ns(1) >>>,true) >>>
    control.apply_styles(&styles) >>>
    $focus := widgets.focus_group(&identity,[1]) >>>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        navigation := focus.input(&event)
        control.set_focus(focus.current() == 1)
        if navigation.consumed { -> }
        action := control.input(&event) >>>
        if action.request_focus { focus.focus(1) >>> }
        if action.kind == widgets.ACTION_ACTIVATE { last = int(action.value) }
    }
    $frame := context.new_frame(8192)
    frame.begin() >>>
    frame.clear(styles.background) >>>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) >>>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) >>>
    draw.text(32,22,20,"#282329","XUUI  /  Chart")
    draw.text(32,48,12,"#6d626e","将一组数据转为图形")
    control.paint_styled($&frame,&styles) >>>
    message := "Selected point: " + str(control.selection().point_id)
    draw.text(32,326,13,"#6d626e",message + "")
    println(message)
    frame.present() >>>
    << 0
}
fn main() int {
    << demo() >>> (err) { eprintln(err.msg())
        << 1 }
}
