@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := widgets.default_theme()
    styles := widgets.dark_styles()
    bounds := box(32.0,86.0,550.0,160.0)
    mut control := widgets.scroll(&identity,1,&bounds,widgets.AXIS_VERTICAL,400.0) or >>
    mut count := 0
    label := context.layout_text(&"Value / 数值",&draw.text_options(16.0)) or >>
    mut labels := []draw.TextLayout{}
    for value in ["Overview","Activity","Settings"] { shaped := context.layout_text(&value,&draw.text_options(16.0)) or >>
        labels.push(shaped) }
    mut focus := widgets.focus_group(&identity,[1]) or >>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        navigation := focus.input(&event)
        control.set_focus(focus.current() == 1)
        if navigation.consumed { -> }
        action := control.input(&event) or >>
        if action.request_focus { focus.focus(1) or >> }
        if action.kind == widgets.ACTION_ACTIVATE { count += 1 }
    }
    mut frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(draw.rgb(16,24,39)) or >>
    draw.text(32,24,24,"#f8fafc","Scroll")
    control.begin(mut &frame) or >>
    for i in 0:9 { text := labels[i % 3]
        frame.text_layout(&text,12.0,12.0 + f64(i) * 42.0,theme.foreground) or >> }
    control.end(mut &frame) or >>
    draw.text(32,320,16,"#e2e8f0","Offset: " + str(int(control.offset())))
    println("Offset: " + str(int(control.offset())))
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
