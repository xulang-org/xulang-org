@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) >>>
    << frame.text_layout(&label,f64(x),f64(y),ink) >>>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) >>>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) >>>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    theme := playground.light_theme()
    styles := playground.light_styles()
    bounds := box(48.0,96.0,544.0,180.0)
    $control := widgets.scroll(&identity,1,&bounds,widgets.AXIS_VERTICAL,400.0) >>>
    $count := 0
    $labels := []draw.TextLayout{}
    for value in ["Overview","Activity","Settings"] { shaped := context.layout_text(&value,&draw.text_options(16.0)) >>>
        labels.push(shaped) }
    $focus := widgets.focus_group(&identity,[1]) >>>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        navigation := focus.input(&event)
        control.set_focus(focus.current() == 1)
        if navigation.consumed { -> }
        action := control.input(&event) >>>
        if action.request_focus { focus.focus(1) >>> }
        if action.kind == widgets.ACTION_ACTIVATE { count += 1 }
    }
    $frame := context.new_frame(8192)
    frame.begin() >>>
    frame.clear(styles.background) >>>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) >>>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) >>>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  Scroll") >>>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"让受限区域容纳更多内容") >>>
    control.begin($&frame) >>>
    for i in 0:9 { text := labels[i % 3]
        frame.text_layout(&text,12.0,12.0 + f64(i) * 42.0,theme.foreground) >>> }
    control.end($&frame) >>>
    if focus.current() == 1 { frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,theme.focus,2.0) >>> }
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),"Offset: " + str(int(control.offset()))) >>>
    println("Offset: " + str(int(control.offset())))
    frame.present() >>>
    << 0
}
fn main() int {
    << demo() >>> (err) { eprintln(err.msg())
        << 1 }
}
