@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn remove_last(value &string) string {
    if value.len == 0 { << "" }
    $end := value.len-1
    while end > 0 && (value[end] & 192) == 128 { end -= 1 }
    << value[0:end]
}
fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn char_from_key(key int, shift bool) string {
    if key == 32 { << " " }
    if key >= 65 && key <= 90 {
        lower := "abcdefghijklmnopqrstuvwxyz"
        upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx := key - 65
        if !shift { << lower[idx:idx + 1] }
        << upper[idx:idx + 1]
    }
    if key >= 48 && key <= 57 {
        digits := "0123456789"
        symbols := ")!@#\$%^&*("
        idx := key - 48
        if shift { << symbols[idx:idx + 1] }
        << digits[idx:idx + 1]
    }
    if key == 45 { if shift { << "_" } << "-" }
    if key == 61 { if shift { << "+" } << "=" }
    if key == 46 { if shift { << ">" } << "." }
    if key == 44 { if shift { << "<" } << "," }
    if key == 47 { if shift { << "?" } << "/" }
    if key == 58 || key == 59 { if shift { << ":" } << ";" }
    if key == 64 { << "@" }
    << ""
}
fn demo() int {
    context := draw.default_context()
    styles := playground.light_styles()
    bounds := box(48.0,114.0,500.0,44.0)
    $text := "developer@xulang.org"
    $focused := false
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == 77 { focused = false }
        if event.kind == 72 {
            px := event.x
            py := event.y
            if px >= bounds.x && px <= bounds.x + bounds.width && py >= bounds.y && py <= bounds.y + bounds.height {
                focused = true
            } else {
                focused = false
            }
        }
        if event.kind == 78 {
            if event.key == 257 { focused = !focused }
            if focused {
                if event.key == 259 {
                    if text.len > 0 { text = remove_last(&text) }
                } else if event.key == 256 {
                    focused = false
                } else if text.len < 64 {
                    shift := (event.modifiers & 1) != 0
                    ch := char_from_key(event.key, shift)
                    if ch.len > 0 { text = text + ch }
                }
            }
        }
    }
    $caret := ""
    if focused { caret = "│" }
    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  Input") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"浏览器输入预览：末尾输入、退格删除；Escape 离开。") or >>

    bx := int(bounds.x)
    by := int(bounds.y)
    demo_text($&frame,&context,bx,by - 24,14,draw.rgb(40,35,41),"User email 用户邮箱 *") or >>

    frame.fill_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(255,255,255)) or >>
    if focused {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,styles.input.palette.focus,2.0) or >>
    } else {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(133,121,135),1.0) or >>
    }

    if text.len > 0 {
        demo_center_text($&frame,&context,bx + 14,bounds.y,bounds.height,15,draw.rgb(40,35,41),text + caret) or >>
    } else {
        if focused { demo_center_text($&frame,&context,bx + 14,bounds.y,bounds.height,15,draw.rgb(190,18,60),caret) or >> }
        else { demo_center_text($&frame,&context,bx + 14,bounds.y,bounds.height,15,draw.rgb(133,121,135),"you@domain.com") or >> }
    }

    demo_text($&frame,&context,bx,by + int(bounds.height) + 8,12,draw.rgb(109,98,110),"Basic key input · Native IME requires the desktop SDK") or >>
    message := "Value: " + text
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message + "") or >>
    println(message)
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
