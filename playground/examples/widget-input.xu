@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn remove_last(value &string) string {
    if value.len == 0 { << "" }
    $end := value.len-1
    while end > 0 && (value[end] & 192) == 128 { end -= 1 }
    << value[0:end]
}
fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn char_from_key(key int, shift bool) string {
    if key == 32 { << " " }
    if key >= 65 && key <= 90 {
        lower := "abcdefghijklmnopqrstuvwxyz"
        upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx := key - 65
        if !shift { << lower[idx:idx + 1] }
        << upper[idx:idx + 1]
    }
    if key >= 48 && key <= 57 {
        digits := "0123456789"
        symbols := ")!@#\\$%^&*("
        idx := key - 48
        if shift { << symbols[idx:idx + 1] }
        << digits[idx:idx + 1]
    }
    if key == 45 { if shift { << "_" } << "-" }
    if key == 61 { if shift { << "+" } << "=" }
    if key == 46 { if shift { << ">" } << "." }
    if key == 44 { if shift { << "<" } << "," }
    if key == 47 { if shift { << "?" } << "/" }
    if key == 58 || key == 59 { if shift { << ":" } << ";" }
    if key == 64 { << "@" }
    << ""
}

fn hit_pos(text &string, rel_x f64) int {
    if rel_x <= 0.0 || text.len == 0 { << 0 }
    cell := 15.0 * 0.6
    idx := int((rel_x + cell * 0.5) / cell)
    if idx < 0 { << 0 }
    if idx > text.len { << text.len }
    << idx
}

fn demo() int {
    context := draw.default_context()
    styles := playground.light_styles()
    bounds := box(48.0,114.0,500.0,44.0)
    $text := "developer@xulang.org"
    $focused := false
    $anchor := 0
    $head := 0
    $dragging := false

    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == 77 { focused = false; dragging = false }
        if event.kind == 72 {
            px := event.x
            py := event.y
            if px >= bounds.x && px <= bounds.x + bounds.width && py >= bounds.y && py <= bounds.y + bounds.height {
                focused = true
                dragging = true
                pos := hit_pos(&text, px - (bounds.x + 14.0))
                if (event.modifiers & ui.MOD_SHIFT) != 0 {
                    head = pos
                } else {
                    anchor = pos
                    head = pos
                }
            } else {
                focused = false
                dragging = false
            }
        } else if event.kind == 74 && dragging {
            head = hit_pos(&text, event.x - (bounds.x + 14.0))
        } else if event.kind == 73 {
            dragging = false
        }
        if event.kind == 78 {
            if event.key == 257 {
                focused = !focused
                if focused { anchor = 0; head = text.len }
            }
            if focused {
                mod_cmd := (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META)) != 0
                $lo := anchor
                $hi := head
                if lo > hi {
                    tmp := lo
                    lo = hi
                    hi = tmp
                }
                if mod_cmd && (event.key == 65 || event.key == 97) {
                    anchor = 0
                    head = text.len
                } else if event.key == 259 {
                    if hi > lo {
                        text = text[0:lo] + text[hi:text.len]
                        anchor = lo
                        head = lo
                    } else if head > 0 && text.len > 0 {
                        text = text[0:head - 1] + text[head:text.len]
                        head -= 1
                        anchor = head
                    }
                } else if event.key == 260 {
                    if hi > lo {
                        text = text[0:lo] + text[hi:text.len]
                        anchor = lo
                        head = lo
                    } else if head < text.len {
                        text = text[0:head] + text[head + 1:text.len]
                        anchor = head
                    }
                } else if event.key == 256 {
                    focused = false
                    anchor = head
                } else if event.key == ui.KEY_LEFT {
                    if head > 0 { head -= 1 }
                    if (event.modifiers & ui.MOD_SHIFT) == 0 { anchor = head }
                } else if event.key == ui.KEY_RIGHT {
                    if head < text.len { head += 1 }
                    if (event.modifiers & ui.MOD_SHIFT) == 0 { anchor = head }
                } else if event.key == ui.KEY_HOME {
                    head = 0
                    if (event.modifiers & ui.MOD_SHIFT) == 0 { anchor = head }
                } else if event.key == ui.KEY_END {
                    head = text.len
                    if (event.modifiers & ui.MOD_SHIFT) == 0 { anchor = head }
                } else if !mod_cmd && text.len < 64 {
                    shift := (event.modifiers & 1) != 0
                    ch := char_from_key(event.key, shift)
                    if ch.len > 0 {
                        if hi > lo {
                            text = text[0:lo] + ch + text[hi:text.len]
                            anchor = lo + ch.len
                            head = lo + ch.len
                        } else {
                            text = text[0:head] + ch + text[head:text.len]
                            head += ch.len
                            anchor = head
                        }
                    }
                }
            }
        }
    }
    $caret := ""
    if focused { caret = "│" }
    $frame := context.new_frame(8192)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  Input") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"浏览器输入预览：支持选区拖拽、Ctrl+A 全选、退格删除。") or >>

    bx := int(bounds.x)
    by := int(bounds.y)
    demo_text($&frame,&context,bx,by - 24,14,draw.rgb(40,35,41),"User email 用户邮箱 *") or >>

    frame.fill_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(255,255,255)) or >>
    if focused {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,styles.input.palette.focus,2.0) or >>
    } else {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(133,121,135),1.0) or >>
    }

    $lo := anchor
    $hi := head
    if lo > hi {
        tmp := lo
        lo = hi
        hi = tmp
    }

    text_x := f64(bx + 14)
    if focused && hi > lo {
        x0 := text_x + f64(lo) * 15.0 * 0.6
        x1 := text_x + f64(hi) * 15.0 * 0.6
        frame.fill_rect(x0, bounds.y + 8.0, x1 - x0, bounds.height - 16.0, draw.rgba(225, 29, 72, 56)) or >>
    }

    if text.len > 0 {
        demo_center_text($&frame,&context,bx + 14,bounds.y,bounds.height,15,draw.rgb(40,35,41),text + "") or >>
        if focused {
            cx := text_x + f64(head) * 15.0 * 0.6
            frame.line(cx, bounds.y + 10.0, cx, bounds.y + bounds.height - 10.0, draw.rgb(225, 29, 72), 1.5) or >>
        }
    } else {
        if focused {
            frame.line(text_x, bounds.y + 10.0, text_x, bounds.y + bounds.height - 10.0, draw.rgb(225, 29, 72), 1.5) or >>
        } else {
            demo_center_text($&frame,&context,bx + 14,bounds.y,bounds.height,15,draw.rgb(133,121,135),"you@domain.com") or >>
        }
    }

    demo_text($&frame,&context,bx,by + int(bounds.height) + 8,12,draw.rgb(109,98,110),"Basic key input · Native IME requires the desktop SDK") or >>
    message := "Value: " + text
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message + "") or >>
    println(message)
    frame.present() or >>
    << 0
}
fn main() int {
    << demo() or (err) { eprintln(err.msg())
        << 1 }
}
