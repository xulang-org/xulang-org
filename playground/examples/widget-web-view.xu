@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),f64(y),ink) or >>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) or >>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) or >>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x:x,y:y,width:w,height:h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    styles := playground.light_styles()
    $btn := widgets.button(&identity,1,&box(424.0,88.0,156.0,44.0)) or >>
    $refreshes := 0
    $focus := widgets.focus_group(&identity,[1]) or >>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == ui.EV_POINTER_CANCEL { focus.clear() }
        nav := focus.input(&event)
        btn.set_focus(focus.current() == 1)
        if nav.consumed { -> }
        act := btn.input(&event)
        if act.request_focus { focus.focus(1) or >> }
        if act.kind == widgets.ACTION_ACTIVATE { refreshes += 1 }
    }
    $frame := context.new_frame(16384)
    frame.begin() or >>
    frame.clear(styles.background) or >>
    frame.fill_rect(28.0,70.0,584.0,240.0,styles.input.palette.normal) or >>
    frame.stroke_rect(28.0,70.0,584.0,240.0,styles.button.palette.border,1.0) or >>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  WebView") or >>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"静态子视图示意；原生网页加载、导航请在桌面 SDK 运行。") or >>
    demo_text($&frame,&context,48,102,14,draw.rgb(40,35,41),"xulang.org/docs/ · Preview") or >>
    $label := widgets.styled_label(&context,&"Refresh preview")
    btn.paint_styled($&frame,$&label,&styles) or >>
    frame.stroke_rect(48.0,144.0,532.0,112.0,styles.button.palette.border,1.0) or >>
    demo_text($&frame,&context,64,160,16,draw.rgb(40,35,41),"WebView content preview") or >>
    demo_text($&frame,&context,64,192,13,draw.rgb(109,98,110),"Native webpage embedding requires the desktop SDK.") or >>
    demo_text($&frame,&context,64,224,13,draw.rgb(109,98,110),"Preview refreshes: "+str(refreshes)) or >>
    message := "WebView preview refreshes: "+str(refreshes)
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message+"") or >>
    println(message)
    frame.present() or >>
    << 0
}
fn main() int { << demo() or (err) { eprintln(err.msg())
    << 1 } }
