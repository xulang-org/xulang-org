@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) >>>
    << frame.text_layout(&label,f64(x),f64(y),ink) >>>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) >>>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) >>>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: w,height: h}
}
fn mono_options(size f64) draw.TextOptions {
    $opts := draw.text_options(size)
    opts.family = "mono"
    << opts
}
fn utf8_next(s &string,pos int) int {
    if pos >= s.len { << s.len }
    b := s[pos] & 255
    $w := 1
    if b >= 240 { w = 4 }
    else if b >= 224 { w = 3 }
    else if b >= 194 { w = 2 }
    if pos + w > s.len { << s.len }
    << pos + w
}
fn utf8_prev(s &string,pos int) int {
    if pos <= 0 { << 0 }
    $p := pos - 1
    while p > 0 && (s[p] & 192) == 128 { p -= 1 }
    << p
}
fn snap_pos(s &string,pos int) int {
    if pos <= 0 { << 0 }
    if pos >= s.len { << s.len }
    $p := pos
    while p > 0 && (s[p] & 192) == 128 { p -= 1 }
    << p
}
fn count_cps(s &string) int {
    $n := 0
    for i in 0:s.len { if (s[i] & 192) != 128 { n += 1 } }
    << n
}
fn is_word_byte(b int) bool {
    if b >= 48 && b <= 57 { << true }
    if b >= 65 && b <= 90 { << true }
    if b >= 97 && b <= 122 { << true }
    if b == 95 || b >= 128 { << true }
    << false
}
fn prev_word_start(text &string,pos int) int {
    if pos <= 0 { << 0 }
    $p := pos
    while p > 0 {
        prev := utf8_prev(text,p)
        if is_word_byte(text[prev] & 255) { <- }
        p = prev
    }
    while p > 0 {
        prev := utf8_prev(text,p)
        if !is_word_byte(text[prev] & 255) { <- }
        p = prev
    }
    << p
}
fn next_word_end(text &string,pos int) int {
    if pos >= text.len { << text.len }
    $p := pos
    while p < text.len && !is_word_byte(text[p] & 255) { p = utf8_next(text,p) }
    while p < text.len && is_word_byte(text[p] & 255) { p = utf8_next(text,p) }
    << p
}
fn select_word_at(text &string,pos int) []int {
    if text.len == 0 { << [0,0] }
    $idx := pos
    if idx >= text.len { idx = utf8_prev(text,text.len) }
    $lo := idx
    $hi := utf8_next(text,idx)
    target := is_word_byte(text[idx] & 255)
    while lo > 0 {
        prev := utf8_prev(text,lo)
        if is_word_byte(text[prev] & 255) != target { <- }
        lo = prev
    }
    while hi < text.len {
        if is_word_byte(text[hi] & 255) != target { <- }
        hi = utf8_next(text,hi)
    }
    << [lo,hi]
}
fn char_from_key(key int,mods int,shift bool) string {
    if (mods & 16) != 0 {
        if key < 32 || (key >= 0xD800 && key <= 0xDFFF) || key > 0x10FFFF { << "" }
        if key < 0x80 { << string_from_byte(key) }
        if key < 0x800 { << string_from_bytes([0xC0 | (key >> 6),0x80 | (key & 0x3F)]) }
        if key < 0x10000 { << string_from_bytes([0xE0 | (key >> 12),0x80 | ((key >> 6) & 0x3F),0x80 | (key & 0x3F)]) }
        << string_from_bytes([0xF0 | (key >> 18),0x80 | ((key >> 12) & 0x3F),0x80 | ((key >> 6) & 0x3F),0x80 | (key & 0x3F)])
    }
    if key == 32 { << " " }
    if key >= 65 && key <= 90 {
        lower := "abcdefghijklmnopqrstuvwxyz"
        upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx := key - 65
        if !shift { << lower[idx:idx + 1] }
        << upper[idx:idx + 1]
    }
    if key >= 48 && key <= 57 {
        digits := "0123456789"
        symbols := ")!@#\$%^&*("
        idx := key - 48
        if shift { << symbols[idx:idx + 1] }
        << digits[idx:idx + 1]
    }
    if key == 39 { if shift { << "\"" } << "'" }
    if key == 44 { if shift { << "<" } << "," }
    if key == 45 { if shift { << "_" } << "-" }
    if key == 46 { if shift { << ">" } << "." }
    if key == 47 { if shift { << "?" } << "/" }
    if key == 59 { if shift { << ":" } << ";" }
    if key == 61 { if shift { << "+" } << "=" }
    if key == 91 { if shift { << "{" } << "[" }
    if key == 92 { if shift { << "|" } << "\\" }
    if key == 93 { if shift { << "}" } << "]" }
    if key == 96 { if shift { << "~" } << "`" }
    if key >= 33 && key <= 126 { << string_from_byte(key) }
    << ""
}
fn measure_prefix(context &draw.Context,options &draw.TextOptions,text &string,pos int) f64 {
    if pos <= 0 { << 0.0 }
    $n := pos
    if n > text.len { n = text.len }
    n = snap_pos(text,n)
    if n <= 0 { << 0.0 }
    sub := text[0:n]
    shaped := context.layout_text(&sub,options) >>>
    << shaped.metrics.width
}
fn hit_pos(context &draw.Context,options &draw.TextOptions,text &string,rel_x f64) int {
    if rel_x <= 0.0 || text.len == 0 { << 0 }
    $prev_pos := 0
    $prev_w := 0.0
    while prev_pos < text.len {
        next_pos := utf8_next(text,prev_pos)
        w := measure_prefix(context,options,text,next_pos) >>>
        if rel_x < (prev_w + w) * 0.5 { << prev_pos }
        prev_pos = next_pos
        prev_w = w
    }
    << text.len
}
fn compute_scroll(context &draw.Context,options &draw.TextOptions,text &string,head int,view_w f64,cur_scroll f64) f64 {
    caret_px := measure_prefix(context,options,text,head) >>>
    $sx := cur_scroll
    if caret_px - sx > view_w - 6.0 { sx = caret_px - (view_w - 6.0) }
    if caret_px - sx < 0.0 { sx = caret_px }
    if sx < 0.0 { sx = 0.0 }
    << sx
}
fn handle_edit_key(event &ui.InputEvent,text $&string,anchor $&int,head $&int,clipboard $&string,clip_seq $&int,just_copied $&bool,focused $&bool,max_bytes int,max_cps int,allow_copy bool) int {
    mod_cmd := (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META)) != 0
    mod_word := (event.modifiers & (ui.MOD_CONTROL | ui.MOD_ALT)) != 0
    mod_line := (event.modifiers & ui.MOD_META) != 0
    mod_shift := (event.modifiers & ui.MOD_SHIFT) != 0
    mod_text := (event.modifiers & 16) != 0
    $lo := *anchor
    $hi := *head
    if lo > hi {
        tmp := lo
        lo = hi
        hi = tmp
    }
    *just_copied = false
    if !mod_text && mod_cmd && (event.key == 65 || event.key == 97) {
        *anchor = 0
        *head = text.len
    } else if !mod_text && allow_copy && mod_cmd && (event.key == 67 || event.key == 99) {
        if hi > lo {
            *clipboard = (*text)[lo:hi]
            *clip_seq += 1
            *just_copied = true
        }
    } else if !mod_text && allow_copy && mod_cmd && (event.key == 88 || event.key == 120) {
        if hi > lo {
            *clipboard = (*text)[lo:hi]
            *clip_seq += 1
            *just_copied = true
            *text = (*text)[0:lo] + (*text)[hi:text.len]
            *anchor = lo
            *head = lo
        }
    } else if !mod_text && event.key == ui.KEY_BACKSPACE {
        if hi > lo {
            *text = (*text)[0:lo] + (*text)[hi:text.len]
            *anchor = lo
            *head = lo
        } else if *head > 0 && text.len > 0 {
            $from := utf8_prev(text,*head)
            if mod_line { from = 0 }
            else if mod_word { from = prev_word_start(text,*head) }
            *text = (*text)[0:from] + (*text)[*head:text.len]
            *head = from
            *anchor = from
        }
    } else if !mod_text && event.key == ui.KEY_DELETE {
        if hi > lo {
            *text = (*text)[0:lo] + (*text)[hi:text.len]
            *anchor = lo
            *head = lo
        } else if *head < text.len {
            $to := utf8_next(text,*head)
            if mod_line { to = text.len }
            else if mod_word { to = next_word_end(text,*head) }
            *text = (*text)[0:*head] + (*text)[to:text.len]
            *anchor = *head
        }
    } else if !mod_text && event.key == ui.KEY_ESCAPE {
        *focused = false
        *anchor = *head
    } else if !mod_text && event.key == ui.KEY_LEFT {
        if !mod_shift && hi > lo {
            *head = lo
            *anchor = lo
        } else {
            if mod_line { *head = 0 }
            else if mod_word { *head = prev_word_start(text,*head) }
            else if *head > 0 { *head = utf8_prev(text,*head) }
            if !mod_shift { *anchor = *head }
        }
    } else if !mod_text && event.key == ui.KEY_RIGHT {
        if !mod_shift && hi > lo {
            *head = hi
            *anchor = hi
        } else {
            if mod_line { *head = text.len }
            else if mod_word { *head = next_word_end(text,*head) }
            else if *head < text.len { *head = utf8_next(text,*head) }
            if !mod_shift { *anchor = *head }
        }
    } else if !mod_text && event.key == ui.KEY_HOME {
        *head = 0
        if !mod_shift { *anchor = *head }
    } else if !mod_text && event.key == ui.KEY_END {
        *head = text.len
        if !mod_shift { *anchor = *head }
    } else if mod_text || !mod_cmd {
        ch := char_from_key(event.key,event.modifiers,mod_shift)
        if ch.len > 0 {
            replaced := (*text)[0:lo] + ch + (*text)[hi:text.len]
            $within := replaced.len <= max_bytes
            if within && max_cps > 0 { within = count_cps(&replaced) <= max_cps }
            if within {
                *text = replaced
                *anchor = lo + ch.len
                *head = lo + ch.len
            }
        }
    }
    << 0
}
fn paint_edit_line(frame $&draw.Frame,context &draw.Context,options &draw.TextOptions,text &string,text_x f64,top f64,line_h f64,clip_x f64,clip_y f64,clip_w f64,clip_h f64,scroll_x f64,anchor int,head int,focused bool,ink draw.Color) int {
    $lo := anchor
    $hi := head
    if lo > hi {
        tmp := lo
        lo = hi
        hi = tmp
    }
    $sel_pad := (line_h - 24.0) * 0.5
    if sel_pad < 2.0 { sel_pad = 2.0 }
    $caret_pad := (line_h - 20.0) * 0.5
    if caret_pad < 2.0 { caret_pad = 2.0 }
    frame.push() >>>
    frame.clip_rect(clip_x,clip_y,clip_w,clip_h) >>>
    if focused && hi > lo {
        x0 := text_x - scroll_x + (measure_prefix(context,options,text,lo) >>>)
        x1 := text_x - scroll_x + (measure_prefix(context,options,text,hi) >>>)
        frame.fill_rect(x0,top + sel_pad,x1 - x0,line_h - sel_pad * 2.0,draw.rgba(225,29,72,56)) >>>
    }
    if text.len > 0 {
        shaped := context.layout_text(text,options) >>>
        frame.text_layout(&shaped,text_x - scroll_x,top + (line_h - shaped.metrics.height) * 0.5,ink) >>>
    }
    if focused {
        cx := text_x - scroll_x + (measure_prefix(context,options,text,head) >>>)
        frame.line(cx,top + caret_pad,cx,top + line_h - caret_pad,draw.rgb(225,29,72),1.5) >>>
    }
    frame.pop() >>>
    << 0
}
fn demo() int {
    context := draw.default_context()
    styles := playground.light_styles()
    edit_opts := mono_options(15.0)
    bounds := box(48.0,110.0,440.0,48.0)
    clear_box := box(446.0,117.0,32.0,32.0)
    text_x := bounds.x + 52.0
    view_w := clear_box.x - text_x - 6.0
    $text := "xulang-workspace"
    $focused := false
    $anchor := 0
    $head := 0
    $dragging := false
    $clipboard := ""
    $clip_seq := 0
    $just_copied := false
    $scroll_x := 0.0
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == 77 {
            focused = false
            dragging = false
        }
        if event.kind == 72 {
            px := event.x
            py := event.y
            just_copied = false
            if px >= clear_box.x && px <= clear_box.x + clear_box.width && py >= clear_box.y && py <= clear_box.y + clear_box.height {
                text = ""
                anchor = 0
                head = 0
                scroll_x = 0.0
                focused = true
                dragging = false
            } else if px >= bounds.x && px <= bounds.x + bounds.width && py >= bounds.y && py <= bounds.y + bounds.height {
                focused = true
                pos := hit_pos(&context,&edit_opts,&text,px - text_x + scroll_x) >>>
                if event.repeat >= 3 {
                    anchor = 0
                    head = text.len
                    dragging = false
                } else if event.repeat == 2 {
                    span := select_word_at(&text,pos)
                    anchor = span[0]
                    head = span[1]
                    dragging = false
                } else {
                    dragging = true
                    if (event.modifiers & ui.MOD_SHIFT) != 0 {
                        head = pos
                    } else {
                        anchor = pos
                        head = pos
                    }
                }
                scroll_x = compute_scroll(&context,&edit_opts,&text,head,view_w,scroll_x) >>>
            } else {
                focused = false
                dragging = false
            }
        } else if event.kind == 74 && dragging {
            head = hit_pos(&context,&edit_opts,&text,event.x - text_x + scroll_x) >>>
            scroll_x = compute_scroll(&context,&edit_opts,&text,head,view_w,scroll_x) >>>
        } else if event.kind == 73 {
            dragging = false
        }
        if event.kind == 78 {
            if event.key == 257 {
                focused = !focused
                just_copied = false
                if focused {
                    anchor = 0
                    head = text.len
                    scroll_x = compute_scroll(&context,&edit_opts,&text,head,view_w,scroll_x) >>>
                }
            } else if focused {
                handle_edit_key(&event,$&text,$&anchor,$&head,$&clipboard,$&clip_seq,$&just_copied,$&focused,96,32,true) >>>
                scroll_x = compute_scroll(&context,&edit_opts,&text,head,view_w,scroll_x) >>>
            }
        }
    }
    $frame := context.new_frame(8192)
    frame.begin() >>>
    frame.clear(styles.background) >>>
    if text.len > 0 {
        frame.cursor_rect(bounds.x,bounds.y,clear_box.x - bounds.x,bounds.height,"text") >>>
        frame.cursor_rect(clear_box.x,clear_box.y,clear_box.width,clear_box.height,"pointer") >>>
    } else {
        frame.cursor_rect(bounds.x,bounds.y,bounds.width,bounds.height,"text") >>>
    }
    if clip_seq > 0 { frame.copy_text(clip_seq,&clipboard) >>> }
    frame.fill_rect(28.0,70.0,584.0,240.0,draw.rgb(255,253,251)) >>>
    frame.stroke_rect(28.0,70.0,584.0,240.0,draw.rgb(217,208,217),1.0) >>>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  Field") >>>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"单行字段预览：支持光标定位、选区复制粘贴、词级删除及空值校验。") >>>

    frame.fill_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(255,255,255)) >>>
    is_invalid := text.len == 0
    if is_invalid {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(184,33,56),1.5) >>>
    } else if focused {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,styles.input.palette.focus,2.0) >>>
    } else {
        frame.stroke_rect(bounds.x,bounds.y,bounds.width,bounds.height,draw.rgb(133,121,135),1.0) >>>
    }

    bx := int(bounds.x)
    by := int(bounds.y)
    bw := int(bounds.width)
    bh := int(bounds.height)

    // Floating notch and label sized dynamically to label text
    notch_text := "Project name 项目名称 *"
    notch_lbl := context.layout_text(&notch_text,&draw.text_options(12.0)) >>>
    frame.fill_rect(bounds.x + 12.0,bounds.y - 7.0,notch_lbl.metrics.width + 8.0,14.0,draw.rgb(255,253,251)) >>>
    if is_invalid {
        demo_center_text($&frame,&context,bx + 16,bounds.y-7.0,14.0,12,draw.rgb(184,33,56),"Project name 项目名称 *") >>>
    } else if focused {
        demo_center_text($&frame,&context,bx + 16,bounds.y-7.0,14.0,12,draw.rgb(40,35,41),"Project name 项目名称 *") >>>
    } else {
        demo_center_text($&frame,&context,bx + 16,bounds.y-7.0,14.0,12,draw.rgb(109,98,110),"Project name 项目名称 *") >>>
    }

    // Inside box: prefix, value, selection, caret, clear icon
    demo_center_text($&frame,&context,bx + 16,bounds.y,bounds.height,15,draw.rgb(109,98,110),"xu / ") >>>
    if text.len > 0 || focused {
        paint_edit_line($&frame,&context,&edit_opts,&text,text_x,bounds.y,bounds.height,text_x - 2.0,bounds.y + 2.0,view_w + 8.0,bounds.height - 4.0,scroll_x,anchor,head,focused,draw.rgb(40,35,41)) >>>
    } else {
        demo_center_text($&frame,&context,bx + 52,bounds.y,bounds.height,15,draw.rgb(133,121,135),"输入项目名称...") >>>
    }
    if text.len > 0 {
        cx := clear_box.x + 16.0
        cy := clear_box.y + 16.0
        frame.line(cx - 5.0,cy - 5.0,cx + 5.0,cy + 5.0,draw.rgb(133,121,135),1.5) >>>
        frame.line(cx + 5.0,cy - 5.0,cx - 5.0,cy + 5.0,draw.rgb(133,121,135),1.5) >>>
    }

    // Helper text & counter below
    if is_invalid {
        demo_text($&frame,&context,bx,by + bh + 8,12,draw.rgb(184,33,56),"名称不能为空。Please enter a project name.") >>>
        demo_text($&frame,&context,bx + bw - 50,by + bh + 8,12,draw.rgb(184,33,56),"0 / 32") >>>
    } else if just_copied {
        demo_text($&frame,&context,bx,by + bh + 8,12,draw.rgb(20,103,71),"Copied to clipboard · 已复制到剪贴板") >>>
        demo_text($&frame,&context,bx + bw - 50,by + bh + 8,12,draw.rgb(109,98,110),str(count_cps(&text)) + " / 32") >>>
    } else {
        demo_text($&frame,&context,bx,by + bh + 8,12,draw.rgb(109,98,110),"Browser key input · Native IME requires the desktop SDK") >>>
        demo_text($&frame,&context,bx + bw - 50,by + bh + 8,12,draw.rgb(109,98,110),str(count_cps(&text)) + " / 32") >>>
    }

    $message := "Field: " + text
    if is_invalid { message = "Field: empty (invalid)" }
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message + "") >>>
    println(message)
    frame.present() >>>
    << 0
}
fn main() int {
    << demo() >>> (err) { eprintln(err.msg())
        << 1 }
}
