@main
#ui
#ui/draw
#ui/layout
#ui/widgets
#playground
#time

fn demo_text(frame $&draw.Frame,context &draw.Context,x int,y int,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) >>>
    << frame.text_layout(&label,f64(x),f64(y),ink) >>>
}
fn demo_center_text(frame $&draw.Frame,context &draw.Context,x int,top f64,height f64,size int,ink draw.Color,text string) int {
    label := context.layout_text(&text,&draw.text_options(f64(size))) >>>
    << frame.text_layout(&label,f64(x),top+(height-label.metrics.height)*0.5,ink) >>>
}

fn box(x f64,y f64,w f64,h f64) layout.Rect {
    << layout.Rect{x:x,y:y,width:w,height:h}
}
fn demo() int {
    identity := playground.canvas_identity()
    context := draw.default_context()
    styles := playground.light_styles()
    $btn := widgets.time_picker(&context,&identity,1,&box(48.0,110.0,260.0,44.0),time.date(2026,10,25,14,30,0,0)) >>>
    btn.set_show_seconds(true)
    btn.apply_styles(&styles) >>>
    $mode := widgets.button(&identity,2,&box(320.0,110.0,120.0,44.0)) >>>
    $twelve := false
    $focus := widgets.focus_group(&identity,[1,2]) >>>
    while true {
        event := playground.next_input()
        if event.kind == 0 { <- }
        if event.kind == ui.EV_POINTER_CANCEL { focus.clear() }
        nav := focus.input(&event)
        btn.set_focus(focus.current() == 1)
        mode.set_focus(focus.current() == 2)
        if nav.consumed { -> }
        act := btn.input(&event)
        if act.request_focus { focus.focus(1) >>> }
        mode_action := mode.input(&event)
        if mode_action.request_focus { focus.focus(2) >>> }
        if mode_action.kind == widgets.ACTION_ACTIVATE {
            twelve = !twelve
            btn.set_12_hour(twelve)
        }
    }
    $frame := context.new_frame(16384)
    frame.begin() >>>
    frame.clear(styles.background) >>>
    frame.fill_rect(28.0,70.0,584.0,240.0,styles.input.palette.normal) >>>
    frame.stroke_rect(28.0,70.0,584.0,240.0,styles.button.palette.border,1.0) >>>
    demo_text($&frame,&context,32,22,20,draw.rgb(40,35,41),"XUUI  /  TimePicker") >>>
    demo_text($&frame,&context,32,48,12,draw.rgb(109,98,110),"标准时间拾取组件：支持分秒滚轮调整、12/24小时制切换。") >>>
    t := btn.value()
    h := t.hour()
    m := t.minute()
    s := t.second()
    $mm := str(m)
    if m < 10 { mm = "0"+mm }
    $hh := str(h)
    if h < 10 { hh = "0"+hh }
    $ss := str(s)
    if s < 10 { ss = "0"+ss }
    stored := hh+":"+mm+":"+ss
    $display := stored+""
    $mode_text := "24-Hour"
    if twelve {
        $h12 := h%12
        if h12 == 0 { h12 = 12 }
        $suffix := " AM"
        if h >= 12 { suffix = " PM" }
        display = str(h12)+":"+mm+":"+ss+suffix
        mode_text = "12-Hour"
    }
    $mode_label := widgets.styled_label(&context,&mode_text)
    btn.paint_styled($&frame,&styles) >>>
    mode.paint_styled($&frame,$&mode_label,&styles) >>>
    demo_text($&frame,&context,48,180,14,draw.rgb(40,35,41),display) >>>
    demo_text($&frame,&context,48,202,12,draw.rgb(109,98,110),"点击分段聚焦 · ↑ / ↓ 或右侧箭头调整 · 键盘直接输入数字") >>>
    message := "Time: "+stored
    demo_text($&frame,&context,32,326,13,draw.rgb(109,98,110),message+"") >>>
    println(message)
    frame.present() >>>
    << 0
}
fn main() int { << demo() >>> (err) { eprintln(err.msg())
    << 1 } }
