@main
#xu/types

// Bounded VM map storage, independent of native container pointers. Keys and
// scalar values retain the checked MIR descriptor/scalar calling ABI.
fn vm_map(e &mut Eval,m &types.Mir,fp int,ii int,args &[]int) {
    fi := wasm_mem_load(fp)
    kind := types.mir_ib(m,fi,ii)
    dest := types.mir_ia(m,fi,ii)
    if kind == 84 {
        packed := types.mir_id(m,fi,ii)
        slots := packed >> 16
        if slots != 1 || ((packed >> 8) & 255) != 0 { vm_error(e,"playground maps support int and bool values")
            << }
        if args.len > 0 { capacity := vm_value(m,fp,args[0],0)
            if capacity < 0 || capacity > 4096 { vm_error(e,"playground map capacity exceeds 4096")
                << } }
        handle := wasm_rt_alloc(32)
        wasm_mem_store(handle,0)
        wasm_mem_store(handle + 8,packed & 255)
        wasm_mem_store(handle + 16,slots)
        wasm_mem_store(handle + 24,0)
        vm_put(m,fp,dest,0,handle)
        <<
    }
    handle := vm_value(m,fp,args[0],0)
    if handle == 0 { vm_error(e,"invalid playground map")
        << }
    if kind == 88 { vm_put(m,fp,dest,0,wasm_mem_load(handle))
        << }
    if kind != 85 && kind != 86 && kind != 87 && kind != 89 && kind != 91 {
        vm_error(e,"unsupported playground map operation: " + str(kind))
        << }
    scalar := types.mir_id(m,fi,ii) != 0
    mut key := vm_value(m,fp,args[1],0)
    if !scalar { key = wasm_mem_load(key) }
    string_key := wasm_mem_load(handle + 8) == 1
    slots := wasm_mem_load(handle + 16)
    mut entry := wasm_mem_load(handle + 24)
    mut found := 0
    while entry != 0 {
        if wasm_mem_load(entry + 16) != 0 {
            stored := wasm_mem_load(entry + 8)
            mut equal := key == stored
            if string_key { equal = vm_text(&*e,key) == vm_text(&*e,stored) }
            if equal { found = entry
                <- }
        }
        entry = wasm_mem_load(entry)
    }
    if kind == 87 { mut present := 0
        if found != 0 { present = 1 }
        vm_put(m,fp,dest,0,present)
        << }
    if kind == 89 {
        if found != 0 { wasm_mem_store(found + 16,0)
            wasm_mem_store(handle,wasm_mem_load(handle) - 1) }
        << }
    if kind == 86 {
        if found == 0 {
            if wasm_mem_load(handle) >= 4096 { vm_error(e,"playground map entry limit exceeded (4096)")
                << }
            found = wasm_rt_alloc(24 + slots * 8)
            wasm_mem_store(found,wasm_mem_load(handle + 24))
            wasm_mem_store(found + 8,key)
            wasm_mem_store(found + 16,1)
            wasm_mem_store(handle + 24,found)
            wasm_mem_store(handle,wasm_mem_load(handle) + 1)
        }
        value := vm_value(m,fp,args[2],0)
        for s in 0:slots {
            mut word := value
            if !scalar { word = wasm_mem_load(value - s * 8) }
            wasm_mem_store(found + 24 + s * 8,word)
        }
        <<
    }
    if found == 0 && kind == 85 { vm_error(e,"map key not found")
        << }
    mut fallback := 0
    if found == 0 { fallback = vm_value(m,fp,args[2],0) }
    for s in 0:slots {
        mut word := fallback
        if found != 0 { word = wasm_mem_load(found + 24 + s * 8) }
        else if !scalar { word = wasm_mem_load(fallback - s * 8) }
        vm_put(m,fp,dest,s,word)
    }
}
