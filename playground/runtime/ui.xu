@main

#xu/types

// Browser ABI, separate from stdout/stderr. See playground/README.md.
// These two site-owned shim functions are VM intrinsics, never JS evaluation.
fn vm_ui_call(e $&Eval, m &types.Mir, fp int, ii int) bool {
    fi := wasm_mem_load(fp)
    // Borrow the label: mir_isval() clones and would grow an idle checkpoint
    // on every attempt to read its exhausted input.
    label := m.fns[fi].instrs[ii].sval
    dest := types.mir_ia(m, fi, ii)
    if label == "_xu_time_now_ns" {
        if dest >= 0 { vm_put(m,fp,dest,0,(wasm_mem_load(1072) + 1) * 16000000) }
        << true
    }
    // Host formatting shims, identical to draw.xu/frame.xu. Run their byte
    // loops in the AOT runtime rather than dispatching MIR per character.
    if label == "_xu_ui_draw_clean" {
        arg := types.mir_ic(m, fi, ii)
        descriptor := vm_value(m, fp, types.mir_marg_v(m, fi, arg), 0)
        value := vm_text(&*e, wasm_mem_load(descriptor))
        $out := make_string(value.len)
        for i in 0:value.len {
            c := value[i] & 255
            if c == 9 || c == 10 || c == 13 { out[i] = 32 }
            else { out[i] = c }
        }
        vm_string(e, m, fp, dest, out)
        << true
    }
    if label == "_xu_ui_draw_color_text" {
        arg := types.mir_ic(m, fi, ii)
        descriptor := vm_value(m, fp, types.mir_marg_v(m, fi, arg), 0)
        packed := wasm_mem_load(descriptor)
        digits := "0123456789abcdef"
        $out := make_string(9)
        out[0] = 35
        for i in 0:8 { out[i + 1] = digits[(packed >> ((7 - i) * 4)) & 15] }
        vm_string(e, m, fp, dest, out)
        << true
    }
    if (label == "_xu_playground_next_input" || label == "_xu_playground_next_click") && wasm_mem_load(1112) == 0 && wasm_mem_load(1072) >= wasm_mem_load(1064) && e.tasks.len == 1 && e.channels.len == 0 {
        // Pause before modifying the exhausted read. The host snapshots just
        // the execution arena, then resumes with exhaustion to paint. Only
        // single-task programs qualify; channel scheduling keeps full replay.
        e.waiting = true
        << true
    }
    if label == "_xu_ui_draw_retain" {
        arg := types.mir_ic(m, fi, ii)
        descriptor := vm_value(m, fp, types.mir_marg_v(m, fi, arg), 0)
        value := vm_text(&*e,wasm_mem_load(descriptor))
        e.strings.push(value)
        vm_put(m, fp, dest, 0, e.strings.len)
        << true
    }
    if label == "_xu_ui_draw_lookup" {
        arg := types.mir_ic(m, fi, ii)
        id := vm_value(m, fp, types.mir_marg_v(m, fi, arg), 0)
        value := vm_text(&*e,id - 1)
        vm_string(e, m, fp, dest, value)
        << true
    }
    if label == "_xu_ui_draw_scalar" {
        arg := types.mir_ic(m, fi, ii)
        bits := vm_value(m, fp, types.mir_marg_v(m, fi, arg), 0)
        vm_string(e, m, fp, dest, vm_float_text(bits))
        << true
    }
    if label == "_xu_ui_draw_emit" {
        arg := types.mir_ic(m, fi, ii)
        // By-value strings use the Xu pointer ABI, pointing at the descriptor.
        descriptor := vm_value(m, fp, types.mir_marg_v(m, fi, arg), 0)
        line := vm_text(&*e, wasm_mem_load(descriptor))
        n := wasm_mem_load(1056)
        if n + line.len + 1 > 262144 {
            vm_error(e, "UI command buffer limit exceeded")
            << true
        }
        for i in 0:line.len { wasm_mem_store8(720000 + n + i, line[i]) }
        wasm_mem_store8(720000 + n + line.len, 10)
        wasm_mem_store(1056, n + line.len + 1)
        if dest >= 0 { vm_put(m, fp, dest, 0, 0) }
        << true
    }
    if label == "_xu_playground_next_input" {
        wasm_mem_store(1080, 1)
        wasm_mem_store(1088, 1)
        index := wasm_mem_load(1072)
        if dest >= 0 {
            for s in 0:16 { vm_put(m, fp, dest, s, 0) }
            if index < wasm_mem_load(1064) {
                base := 1000000 + index * 80
                vm_put(m, fp, dest, 0, wasm_mem_load(base))
                vm_put(m, fp, dest, 1, 1)
                vm_put(m, fp, dest, 2, 1)
                vm_put(m, fp, dest, 3, 1)
                vm_put(m, fp, dest, 4, vm_fp_from_int(wasm_mem_load(base + 8)))
                vm_put(m, fp, dest, 5, vm_fp_from_int(wasm_mem_load(base + 16)))
                vm_put(m, fp, dest, 6, wasm_mem_load(base + 64))
                vm_put(m, fp, dest, 7, wasm_mem_load(base + 72))
                vm_put(m, fp, dest, 11, wasm_mem_load(base + 24))
                vm_put(m, fp, dest, 10, wasm_mem_load(base + 32))
                vm_put(m, fp, dest, 13, wasm_mem_load(base + 40))
                vm_put(m, fp, dest, 8, wasm_mem_load(base + 48))
                vm_put(m, fp, dest, 9, wasm_mem_load(base + 56))
                vm_put(m, fp, dest, 15, (index + 1) * 16000000)
                wasm_mem_store(1072, index + 1)
            }
        }
        << true
    }
    if label == "_xu_playground_next_click" {
        wasm_mem_store(1080, 1)
        index := wasm_mem_load(1072)
        $x := 0
        $y := 0
        $ok := 0
        if index < wasm_mem_load(1064) {
            x = wasm_mem_load(1000008 + index * 80)
            y = wasm_mem_load(1000016 + index * 80)
            ok = 1
            wasm_mem_store(1072, index + 1)
        }
        if dest >= 0 {
            vm_put(m, fp, dest, 0, x)
            vm_put(m, fp, dest, 1, y)
            vm_put(m, fp, dest, 2, ok)
        }
        << true
    }
    << false
}
