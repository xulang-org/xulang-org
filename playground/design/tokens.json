{
  "version": "0.1.0",
  "description": "XU UI flat token contract. CSS names are --xu- followed by the key. Values are CSS strings.",
  "base": {
    "font-sans": "\"Avenir Next\", \"Noto Sans CJK SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "font-display": "\"Iowan Old Style\", \"Songti SC\", \"Noto Serif CJK SC\", serif",
    "font-mono": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace",
    "space-1": "4px", "space-2": "8px", "space-3": "12px", "space-4": "16px",
    "space-5": "20px", "space-6": "24px", "space-8": "32px", "space-10": "40px",
    "space-12": "48px", "space-16": "64px", "space-24": "96px",
    "radius-sm": "4px", "radius-md": "8px", "radius-lg": "12px", "radius-full": "999px",
    "text-xs": ".75rem", "text-sm": ".875rem", "text-md": "1rem", "text-lg": "1.25rem",
    "text-xl": "1.75rem", "text-2xl": "2.5rem", "leading-body": "1.65", "leading-heading": "1.15",
    "control-sm": "32px", "control-md": "40px", "control-lg": "48px", "target-min": "44px",
    "duration-fast": "120ms", "duration-normal": "200ms", "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "z-sticky": "10", "z-menu": "20", "z-toast": "40"
  },
  "themes": {
    "dark": {
      "canvas": "#100e12", "surface": "#19161c", "elevated": "#231f27", "subtle": "#2c2731",
      "text": "#f5f0ed", "muted": "#b3aab6", "border": "#3e3645", "control-border": "#8a7e90",
      "brand": "#ff5274", "brand-hover": "#ff7690", "brand-soft": "#3c1d2a", "on-brand": "#190c12",
      "success": "#6fdbac", "success-soft": "#153328", "warning": "#f5c56d", "warning-soft": "#3c301a",
      "danger": "#ff8e9d", "danger-soft": "#3c2028", "info": "#85c9f4", "info-soft": "#1a2d3d",
      "focus": "#a8d9ff", "overlay": "#08060bc9"
    },
    "light": {
      "canvas": "#f6f3ef", "surface": "#fffdfb", "elevated": "#eeebe7", "subtle": "#e8e3df",
      "text": "#282329", "muted": "#6d626e", "border": "#d9d0d9", "control-border": "#857987",
      "brand": "#be123c", "brand-hover": "#9f1239", "brand-soft": "#fce4eb", "on-brand": "#fff8fa",
      "success": "#146747", "success-soft": "#e1f2e9", "warning": "#855008", "warning-soft": "#fcf0d6",
      "danger": "#b82138", "danger-soft": "#fbe6e9", "info": "#1b648f", "info-soft": "#e3f1fa",
      "focus": "#005f9e", "overlay": "#20152280"
    }
  }
}
