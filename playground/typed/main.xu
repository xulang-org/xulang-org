@main

#os
#xu/ast
#xu/lexer
#xu/token
#xu/parser
#xu/types
#xu/mir

// Compile user code for the Linux ARM64 runtime ABI inside the sandbox.
// This gives the interpreter the cooperative runtime's task-switch calls.
const USER_TARGET = 12
const USER_OS = 1
const USER_ARCH = 0

fn parse_source(source string, name string) parser.Parser {
    $tokens := []token.Token{}
    lexer.lex(source, $&tokens, name + "")
    $ast_tokens := []ast.Token{}
    for i in 0:tokens.len {
        t := &tokens[i]
        ast_tokens.push(ast.Token{kind: t.kind, line: t.line, col: t.col, ival: t.ival, sval: ~t.sval})
    }
    $file := parser.new_parser(ast_tokens)
    file.file_name = name + ""
    file.parse_module()
    << file
}

fn add_source(p $&parser.Parser, source string, name string) {
    file := parse_source(source, name + "")
    if parser.compile_tags_match(&file.compile_tags, "linux", "arm64") {
        p.merge_from(&file)
        p.file_names.push(name)
    }
}

fn prepare_source(source string, program $&mir.Mir) int {
    if source.len > 131072 {
        eprintln("error: playground source exceeds 128 KiB")
        << 1
    }
    $start := 0
    if source.len >= 3 && source[0] == 239 && source[1] == 187 && source[2] == 191 { start = 3 }
    while start < source.len && (source[start] == 32 || source[start] == 10 ||
        source[start] == 13 || source[start] == 9) { start += 1 }
    $text := source[start:source.len]
    if start == source.len || source[start] != 64 { text = "@main\n" + text }
    $p := parser.new_parser([]ast.Token{})
    file := parse_source(text, "playground.xu")
    if file.module_id != "main" {
        eprintln("error: playground projects must use @main")
        << 1
    }
    p.merge_from(&file)
    p.file_names.push("playground.xu")
    $draw := false
    $widgets := false
    for i in 0:p.imp_path.len {
        import_path := &p.imp_path[i]
        if *import_path == "playground" { draw = true }
        if *import_path == "ui" || *import_path == "ui/draw" || *import_path == "ui/widgets" ||
            *import_path == "ui/layout" || *import_path == "ui/internal/codec" ||
            *import_path == "math" || *import_path == "time" || *import_path == "unicode/utf8" ||
            *import_path == "unicode" || *import_path == "strings" || *import_path == "strconv" {
            widgets = true
        }
    }
    add_core($&p)
    if draw || widgets { add_browser_ui($&p, widgets) }
    if widgets {
        flags := playground_widget_flags(&file.tokens)
        playground_merge_widget_extensions($&p, &flags)
    }
    $checker := types.Checker{}
    $typed := types.typed_program_new()
    types.check_typed(&p, USER_TARGET, 0, $&checker, $&typed)
    << mir.lower_typed(&p, $&typed, USER_OS, USER_ARCH, false, false, program)
}

pub fn playground_prepare(program $&mir.Mir) int {
    source := os.read("/program.xu") or (err) {
        eprintln(err.msg())
        << 1
    }
    << prepare_source(source, program)
}

pub fn playground_execute(program &mir.Mir) int {
    events := os.read("/events.bin") or (err) {
        eprintln(err.msg())
        << 1
    }
    if events.len % 80 != 0 || events.len > 8000000 {
        eprintln("error: invalid playground events")
        << 2
    }
    << run_machine(program, events)
}

fn main() int {
    $program := mir.mir_new()
    status := playground_prepare($&program)
    if status != 0 { << status }
    << playground_execute(&program)
}
