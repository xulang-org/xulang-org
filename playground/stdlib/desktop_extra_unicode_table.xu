// Upstream: src/unicode/mod.xu
fn classification_mask(r int) int {
    if !valid_rune(r) { << 0 }
    index := (r >> 8) * 2
    page := ((CLASSIFICATION_INDEX[index] - 32) << 6) | (CLASSIFICATION_INDEX[index + 1] - 32)
    if page == 0 { << 0 }
    off := page * 512 + (r & 255) * 2
    << ((CLASSIFICATION_PAGES[off] - 32) << 6) | (CLASSIFICATION_PAGES[off + 1] - 32)
}

// Upstream: src/unicode/mod.xu
pub fn is_space(r int) bool {
    if r < 0 || r > MAX_RUNE {
        << false
    }
    // ASCII whitespace uses a direct check; pages cover non-ASCII spaces.
    if r < 128 {
        if r == 32 {
            << true
        }
        << r >= 9 && r <= 13
    }
    << (classification_mask(r) & 4) != 0
}

