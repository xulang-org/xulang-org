pub struct Table {
    locale Locale
    rows ListBox
    outer layout.Rect
    headers []string
    cells []string
    order []int
    sort_kinds []int
    local_sort bool
    sort_key_armed int
    labels TextCache
    header_h f64
    sort_col int
    header_cursor int
    descending bool
    hot_header int
    armed_header int
    minima []f64
    widths []f64
    alignments []f64
    density f64
    scroll_x f64
    resize_column int
    resize_x f64
    resize_width f64
    horizontal_drag bool
    horizontal_grab f64
    status_text string

}

