            if row == t.rows.selected_val || row == t.rows.hovered_idx { rounded_fill(frame,&r,4.0 * d,c.resolve(state).background) or >> }
            for column in 0:cols {
                source := t.row_at(row) or >>
                text := t.cells[source * cols + column] + ""
                grid := t.header_bounds(column)
                cell := layout.Rect{x: grid.x,y: r.y,width: grid.width,height: r.height}
                mut text_style := c.clone()
                text_style.align_x = t.alignments[column]
                slot := 16 + (row - first) * cols + column
                cache := mut &t.labels
                cache.paint_text(slot,&text,frame,&cell,styles,&text_style,state) or >>
            }
        }
    }
    frame.pop() or >>
    t.rows.paint_data_scrollbar(frame,&c) or >>
    if t.content_width() > outer.width {
        thumb := t.horizontal_thumb() or >>
        rounded_fill(frame,&thumb,3.0 * d,fade_color(c.palette.muted,0.65)) or >>
    }
    frame.pop() or >>
    << 0
}

// Upstream: src/ui/widgets/table_sort.xu
pub fn (t &mut Table) refresh_sort() int {
    if t.local_sort && t.sort_col >= 0 { column := t.sort_col
        descending := t.descending
        t.apply_sort(column,descending,false) or >> }
    << 0
}

// Upstream: src/ui/widgets/table.xu
pub fn (t &mut Table) set_bounds(bounds &layout.Rect) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    validate_bounds(bounds) or >>
    if t.outer.x != bounds.x || t.outer.y != bounds.y || t.outer.width != bounds.width || t.outer.height != bounds.height {
        t.hot_header = -1
        t.armed_header = -1
    }
    t.outer = copy_rect(bounds)
    header := math.min(t.header_h,bounds.height)
    mut bottom := 0.0
    if t.content_width() > bounds.width { bottom = 16.0 * t.density }
    body := layout.Rect{x: bounds.x,y: bounds.y + header,width: bounds.width,height: math.max(0.0,bounds.height - header - bottom)}
    rows := mut &t.rows
    << rows.set_bounds(&body) or >>
}

// Upstream: src/ui/widgets/table.xu
pub fn (t &mut Table) set_cell(row int,column int,text &string) int {
    if t.rows.closed || row < 0 || row >= t.count() || column < 0 || column >= t.column_count() { >> errors.new("widgets: invalid table cell") }
    validate_table_text(text) or >>
    index := row * t.column_count() + column
    if t.cells[index] != text + "" { t.cells[index] = text + ""
        t.rows.dirty = true
        if column == t.sort_col { t.refresh_sort() or >> } }
    << 0
}

// Upstream: src/ui/widgets/table_appearance.xu
pub fn (t &mut Table) set_column_width(column int,width f64) int {
    if t.rows.closed || column < 0 || column >= t.column_count() || !finite_metric(width,4096.0) || (width > 0.0 && width < t.minima[column]) {
        >> errors.new("widgets: invalid table column width")
    }
    t.widths[column] = width
    b := t.bounds()
    t.set_bounds(&b) or >>
    t.set_horizontal_offset(t.scroll_x) or >>
    t.rows.dirty = true
    << 0
}

// Upstream: src/ui/widgets/table.xu
pub fn (t &mut Table) set_focus(focused bool) { if !focused { t.sort_key_armed = 0
        t.armed_header = -1 }
    rows := mut &t.rows
    rows.set_focus(focused) }

// Upstream: src/ui/widgets/table_appearance.xu
pub fn (t &mut Table) set_horizontal_offset(offset f64) int {
    if math.is_nan(offset) || math.is_inf(offset) { >> errors.new("widgets: invalid table scroll offset") }
    next := math.max(0.0,math.min(math.max(0.0,t.content_width() - t.outer.width),offset))
    if t.scroll_x != next { t.scroll_x = next
        t.rows.dirty = true }
    << 0
}

// Upstream: src/ui/widgets/table_sort.xu
pub fn (t &mut Table) set_local_sort(enabled bool) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    if t.local_sort == enabled { << 0 }
    t.local_sort = enabled
    column := t.sort_col
    descending := t.descending
    << t.apply_sort(column,descending,false) or >>
}

// Upstream: src/ui/widgets/table_sort.xu
pub fn (t &mut Table) set_sort_kind(column int,kind int) int {
    if t.rows.closed || column < 0 || column >= t.column_count() || kind < TABLE_SORT_TEXT || kind > TABLE_SORT_NUMBER { >> errors.new("widgets: invalid table sort kind") }
    if t.sort_kinds[column] != kind { t.sort_kinds[column] = kind
        if column == t.sort_col { t.refresh_sort() or >> } }
    << 0
}

// Upstream: src/ui/widgets/table_sort.xu
pub fn (t &mut Table) sort_by(column int,descending bool) int { << t.apply_sort(column,descending,true) or >> }

// Upstream: src/ui/widgets/table.xu
pub fn table(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,headers &[]string,rows int,selected int) Table {
    if headers.len < 1 || headers.len > 16 || rows < 0 || rows > 512 || rows * headers.len > 768 || (rows == 0 && selected != -1) {
        >> errors.new("widgets: table exceeds 16 columns, 512 rows or 768 cells")
    }
    if !context.matches_canvas(identity) { >> errors.new("widgets: table context mismatch") }
    mut titles := []string{}
    for title in headers { validate_table_text(&title) or >>
        titles.push(title + "") }
    mut cells := []string{}
    for i in 0:rows * headers.len { cells.push("") }
    control := list_box(identity,id,bounds,rows,selected) or >>
    mut result := Table{locale: locale_default(),rows: control,outer: copy_rect(bounds),headers: titles,cells: cells,order: []int{},sort_kinds: []int{},local_sort: true,sort_key_armed: 0,labels: text_cache(context),
        header_h: 32.0,sort_col: -1,header_cursor: 0,descending: false,hot_header: -1,armed_header: -1,minima: []f64{},widths: []f64{},alignments: []f64{},density: 1.0,scroll_x: 0.0,
        resize_column: -1,resize_x: 0.0,resize_width: 0.0,horizontal_drag: false,horizontal_grab: 0.0,status_text: ""}
    for i in 0:rows { result.order.push(i) }
    for i in 0:headers.len { result.sort_kinds.push(TABLE_SORT_TEXT)
        result.minima.push(48.0)
        result.widths.push(0.0)
        result.alignments.push(0.0) }
    result.set_bounds(bounds) or >>
    << result
}

