// Upstream: src/ui/widgets/multi_select.xu
fn validate_choices(options &[]string) int {
    if options.len < 1 || options.len > 64 { >> errors.new("widgets: expected 1..64 choices") }
    for text in options {
        if text.len > 4096 || !utf8.valid(&text) { >> errors.new("widgets: invalid choice text") }
        for i in 0:text.len { if (text[i] & 255) == 0 || (text[i] & 255) == 10 || (text[i] & 255) == 13 { >> errors.new("widgets: choice must be a single line") } }
    }
    << 0
}

