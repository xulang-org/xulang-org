@ui/draw

#ui
#unicode/utf8
#errors
#math

// Browser host adapter only. Widget geometry, state, and paint calls live in
// desktop_widgets.xu, copied verbatim from the desktop library.
fn scalar(value f64) string { <<< 1 }
fn color_text(color Color) string {
    digits := "0123456789abcdef"
    $out := make_string(9)
    out[0] = 35
    packed := color.value()
    for i in 0:8 { out[i + 1] = digits[(packed >> ((7 - i) * 4)) & 15] }
    << out
}
pub struct Context { canvas_id int
    generation int }
pub fn default_context() Context { << Context{canvas_id: 1,generation: 1} }
pub struct Frame { active bool }
pub fn (context &Context) new_frame(capacity int) Frame { << Frame{active: false} }
pub fn (frame $&Frame) begin() int { frame.active = true
    << begin() }
pub fn (frame $&Frame) present() int { frame.active = false
    << present() }
pub fn (frame $&Frame) cancel() { frame.active = false
    cancel() }
fn (frame &Frame) writable() int {
    if !frame.active { >> errors.new("draw: frame is not writable") }
    << 0
}
pub fn (frame $&Frame) clear(color Color) int { frame.writable() or >>
    << set_bg(color_text(color)) }
pub fn (frame $&Frame) push() int { frame.writable() or >>
    << push() }
pub fn (frame $&Frame) pop() int { frame.writable() or >>
    << pop() }
pub fn (frame $&Frame) clip_rect(x f64,y f64,w f64,h f64) int {
    frame.writable() or >>
    << cmd("clip_rect\t" + scalar(x) + "\t" + scalar(y) + "\t" + scalar(w) + "\t" + scalar(h))
}
pub fn (frame $&Frame) fill_rect(x f64,y f64,w f64,h f64,color Color) int {
    frame.writable() or >>
    << cmd("fill_rect\t" + scalar(x) + "\t" + scalar(y) + "\t" + scalar(w) + "\t" + scalar(h) + "\t" + color_text(color))
}
pub fn (frame $&Frame) stroke_rect(x f64,y f64,w f64,h f64,color Color,width f64) int {
    frame.writable() or >>
    << cmd("stroke_rect\t" + scalar(x) + "\t" + scalar(y) + "\t" + scalar(w) + "\t" + scalar(h) + "\t" + color_text(color) + "\t" + scalar(width))
}
pub fn (frame $&Frame) line(x1 f64,y1 f64,x2 f64,y2 f64,color Color,width f64) int {
    frame.writable() or >>
    << cmd("line\t" + scalar(x1) + "\t" + scalar(y1) + "\t" + scalar(x2) + "\t" + scalar(y2) + "\t" + color_text(color) + "\t" + scalar(width))
}

// Browser text host: deterministic single-line metrics with East Asian Wide
// handling (2 cells) and opt-in monospace runs via TextOptions.family == "mono".
// VM resources use scalar handles, matching native TextLayout value semantics.
const LAYOUT_MONO_BIT = 1073741824

fn retain(value &string) int { <<< 1 }
fn lookup(id int) string { <<< 1 }

fn codepoint_cells(cp int) int {
    if cp == 0x200D || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x0300 && cp <= 0x036F) { << 0 }
    if (cp >= 0x1100 && cp <= 0x115F) || cp == 0x2329 || cp == 0x232A ||
       (cp >= 0x2E80 && cp <= 0x303E) || (cp >= 0x3041 && cp <= 0x33FF) ||
       (cp >= 0x3400 && cp <= 0x4DBF) || (cp >= 0x4E00 && cp <= 0x9FFF) ||
       (cp >= 0xA000 && cp <= 0xA4CF) || (cp >= 0xAC00 && cp <= 0xD7AF) ||
       (cp >= 0xF900 && cp <= 0xFAFF) || (cp >= 0xFE10 && cp <= 0xFE19) ||
       (cp >= 0xFE30 && cp <= 0xFE6F) || (cp >= 0xFF01 && cp <= 0xFF60) ||
       (cp >= 0xFFE0 && cp <= 0xFFE6) || (cp >= 0x1F300 && cp <= 0x1FAFF) ||
       (cp >= 0x20000 && cp <= 0x3FFFD) { << 2 }
    << 1
}

fn measure_cells_until(value &string, limit int, masked bool) int {
    $cells := 0
    $pos := 0
    while pos < limit {
        w := utf8.decode_width(value,pos) or >>
        if masked {
            cells += 1
        } else {
            cp := utf8.decode(value,pos) or >>
            cells += codepoint_cells(cp)
        }
        pos += w
    }
    << cells
}

fn escape_cmd_text(value &string) string {
    $out := ""
    $start := 0
    for i in 0:value.len {
        b := value[i] & 255
        if b == 92 || b == 9 || b == 10 || b == 13 {
            if i > start { out = out + value[start:i] }
            if b == 92 { out = out + "\\\\" }
            else if b == 9 { out = out + "\\t" }
            else if b == 10 { out = out + "\\n" }
            else { out = out + "\\r" }
            start = i + 1
        }
    }
    if start < value.len { out = out + value[start:value.len] }
    << out
}

pub fn (context &Context) layout_text(value &string,options &TextOptions) TextLayout {
    << context.layout_text_mode(value,options,false) or >>
}
pub fn (context &Context) layout_masked_text(value &string,options &TextOptions) TextLayout {
    << context.layout_text_mode(value,options,true) or >>
}
fn (context &Context) layout_text_mode(value &string,options &TextOptions,masked bool) TextLayout {
    if options.size < 1.0 || options.size > 256.0 || math.is_nan(options.size) { >> errors.new("draw: invalid browser text size") }
    cells := measure_cells_until(value,value.len,masked) or >>
    width := f64(cells) * options.size * 0.6
    height := options.size * 1.25
    metrics := TextMetrics{width: width,height: height,baseline: options.size,lines: 1,ink_x: 0.0,ink_y: 0.0,ink_width: width,ink_height: height}
    // A negative handle marks concealed text; keep the original UTF-8 bytes
    // for caret/selection queries and mask only the emitted paint command.
    $id := retain(value)
    if options.family == "mono" || options.family == "monospace" { id = id | LAYOUT_MONO_BIT }
    if masked { id = 0 - id }
    << TextLayout{metrics: metrics,id: id,canvas_id: context.canvas_id,generation: context.generation}
}
fn layout_raw_id(layout &TextLayout) int {
    $id := layout.id
    if id < 0 { id = 0 - id }
    << id
}
fn layout_is_mono(layout &TextLayout) bool {
    << (layout_raw_id(layout) & LAYOUT_MONO_BIT) != 0
}
fn layout_source(layout &TextLayout) string {
    raw := layout_raw_id(layout) & (LAYOUT_MONO_BIT - 1)
    << lookup(raw)
}
fn layout_display(layout &TextLayout) string {
    value := layout_source(layout)
    if layout.id >= 0 { << value }
    $masked := ""
    for i in 0:value.len {
        c := value[i] & 255
        if c < 128 || c >= 192 { masked = masked + "*" }
    }
    << masked
}
pub fn (layout $&TextLayout) dispose() int { << 0 }
pub fn (frame $&Frame) text_layout(label &TextLayout,x f64,y f64,color Color) int {
    frame.writable() or >>
    line := "layout_text\t" + scalar(x) + "\t" + scalar(y) + "\t" + scalar(label.metrics.baseline) + "\t" + color_text(color) + "\t" + scalar(label.metrics.width) + "\t" + clean(layout_display(label))
    if layout_is_mono(label) {
        cmd("font\tmono") or >>
        cmd(line) or >>
        << cmd("font\tsans")
    }
    << cmd(line)
}

pub fn (frame $&Frame) cursor_rect(x f64,y f64,w f64,h f64,cursor string) int {
    frame.writable() or >>
    if w < 0.0 || h < 0.0 || math.is_nan(w) || math.is_nan(h) { >> errors.new("draw: invalid cursor rect") }
    << cmd("cursor_rect\t" + scalar(x) + "\t" + scalar(y) + "\t" + scalar(w) + "\t" + scalar(h) + "\t" + clean(cursor))
}

pub fn (frame $&Frame) copy_text(seq int,value &string) int {
    frame.writable() or >>
    if seq < 0 { >> errors.new("draw: invalid clipboard sequence") }
    << cmd("clipboard\t" + str(seq) + "\t" + escape_cmd_text(value))
}

// Paths carry only validated geometric commands; Canvas never sees executable
// code or widget identities. Desktop rounded_path builds these same cubics.
pub const FILL_NONZERO = 0
pub struct Path { commands string }
pub fn new_path(capacity int) Path { << Path{commands: ""} }
pub fn (path $&Path) move_to(x f64,y f64) int {
    commands := $&path.commands
    commands.push_str("path_move\t" + scalar(x) + "\t" + scalar(y) + "\n")
    << 0
}
pub fn (path $&Path) line_to(x f64,y f64) int {
    commands := $&path.commands
    commands.push_str("path_line\t" + scalar(x) + "\t" + scalar(y) + "\n")
    << 0
}
pub fn (path $&Path) cubic_to(x1 f64,y1 f64,x2 f64,y2 f64,x f64,y f64) int {
    commands := $&path.commands
    commands.push_str("path_cubic\t" + scalar(x1) + "\t" + scalar(y1) + "\t" + scalar(x2) + "\t" + scalar(y2) + "\t" + scalar(x) + "\t" + scalar(y) + "\n")
    << 0
}
pub fn (path $&Path) close() int {
    commands := $&path.commands
    commands.push_str("path_close\n")
    << 0 }
pub fn (frame $&Frame) fill_path(path &Path,color Color,rule int) int {
    frame.writable() or >>
    cmd("path_begin")
    // cmd adds a newline; trim the path's final newline before transport.
    if path.commands.len > 0 { cmd(path.commands[0:path.commands.len - 1]) }
    << cmd("path_fill\t" + color_text(color))
}

pub fn (frame $&Frame) stroke_path(path &Path,color Color,options &StrokeOptions) int {
    frame.writable() or >>
    if options.cap < CAP_BUTT || options.cap > CAP_SQUARE || options.join < JOIN_MITER || options.join > JOIN_BEVEL || options.dashes.len > 0 {
        >> errors.new("draw: unsupported browser stroke options")
    }
    cmd("path_begin")
    if path.commands.len > 0 { cmd(path.commands[0:path.commands.len - 1]) }
    $stroke := "path_stroke\t" + color_text(color) + "\t" + scalar(options.width)
    if options.cap != CAP_BUTT || options.join != JOIN_MITER || options.miter_limit != 10.0 {
        stroke = stroke + "\t" + str(options.cap) + "\t" + str(options.join) + "\t" + scalar(options.miter_limit)
    }
    << cmd(stroke)
}


pub fn (context &Context) clone() Context { << Context{canvas_id: context.canvas_id,generation: context.generation} }
pub fn (frame $&Frame) translate(x f64,y f64) int {
    frame.writable() or >>
    << cmd("translate\t" + scalar(x) + "\t" + scalar(y))
}
pub fn (frame $&Frame) scale(x f64,y f64) int { frame.writable() or >>
    << cmd("scale\t" + scalar(x * 100.0) + "\t" + scalar(y * 100.0)) }
pub fn (frame $&Frame) rotate(degrees f64) int { frame.writable() or >>
    << cmd("rotate\t" + scalar(degrees)) }
pub fn (frame $&Frame) set_fill(color Color) int { frame.writable() or >>
    << cmd("fill\t" + color_text(color)) }
pub fn (frame $&Frame) set_stroke(color Color,width f64) int { frame.writable() or >>
    cmd("stroke\t" + color_text(color))
    << cmd("width\t" + scalar(width)) }
pub fn (frame $&Frame) circle(x f64,y f64,radius f64) int { frame.writable() or >>
    << cmd("circle\t" + scalar(x) + "\t" + scalar(y) + "\t" + scalar(radius)) }

pub fn (context &Context) matches_canvas(identity &ui.CanvasEvent) bool {
    << identity.window_id == 1 && identity.canvas_id == context.canvas_id && identity.generation == context.generation
}
pub fn (context &Context) start_text_input(options &ui.TextInputOptions) ui.TextInput {
    >> errors.new("browser: native text input unavailable; use read-only Editor")
}
pub fn (layout &TextLayout) bind_input_transform(input &ui.TextInput,revision int,transform &ui.TextInputTransform,upstream bool) int {
    >> errors.new("browser: native text input geometry unavailable")
}
// Single-line code-point grid, with UTF-8 byte indices matching desktop APIs.
// This supports display-only Editor.paint(), not grapheme or bidi shaping.
pub fn (layout &TextLayout) caret(index int,trailing bool) TextHit {
    value := layout_source(layout)
    if index < 0 || index > value.len { >> errors.new("draw: invalid browser caret index") }
    masked := layout.id < 0
    $cells := 0
    $position := 0
    while position < index {
        step := utf8.decode_width(&value,position) or >>
        if masked {
            cells += 1
        } else {
            cells += codepoint_cells(utf8.decode(&value,position) or >>)
        }
        position += step
    }
    if position != index { >> errors.new("draw: caret index must be a UTF-8 boundary") }
    $length := 0
    if index < value.len { length = utf8.decode_width(&value,index) or >> }
    if trailing && length > 0 {
        if masked {
            cells += 1
        } else {
            cells += codepoint_cells(utf8.decode(&value,index) or >>)
        }
    }
    << TextHit{index: index,length: length,trailing: trailing,inside: true,x: f64(cells) * layout.metrics.baseline * 0.6,y: 0.0,height: layout.metrics.height}
}
pub fn (layout &TextLayout) selection_rects(start int,end int) []TextSelectionRect {
    if end < start { >> errors.new("draw: invalid browser selection") }
    left := layout.caret(start,false) or >>
    right := layout.caret(end,false) or >>
    $rects := []TextSelectionRect{}
    if end > start { rects.push(TextSelectionRect{x: left.x,y: 0.0,width: right.x - left.x,height: layout.metrics.height}) }
    << rects
}
