@ui
#errors

// Native edit sessions are deliberately unavailable. Read-only Editor painting
// keeps session.id == 0 and never enters these operations. Fail loudly otherwise.
pub fn (input &TextInput) snapshot() TextInputState { >> errors.new("browser: native text input unavailable") }
pub fn (input $&TextInput) stop() int { >> errors.new("browser: native text input unavailable") }
pub fn (request &Request) cancel() { if request.id != 0 { <<< 1 } }
