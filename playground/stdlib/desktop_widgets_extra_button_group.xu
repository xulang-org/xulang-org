        mut ink := c.palette.accent
        if variant == BUTTON_DANGER { ink = c.palette.invalid }
        c.palette.normal = ink
        c.palette.hovered = mix_color(ink,c.palette.foreground,0.12)
        c.palette.pressed = mix_color(ink,styles.background,0.18)
        c.palette.foreground = c.palette.on_accent
        c.palette.border = ink
        mut read_only := state_paint(STATE_READ_ONLY)
        read_only.unless = STATE_DISABLED | STATE_INVALID
        read_only.fields = PAINT_FOREGROUND
        read_only.foreground = styles.button.palette.foreground
        c.states = [read_only]
    } else if variant == BUTTON_OUTLINE || variant == BUTTON_GHOST {
        c.palette.normal = draw.rgba(0,0,0,0)
        if variant == BUTTON_GHOST { c.border_width = 0.0 }
    } else if variant == BUTTON_SUBTLE {
        c.border_width = 0.0
        c.palette.normal = mix_color(styles.background,c.palette.accent,0.08)
        c.palette.hovered = mix_color(styles.background,c.palette.accent,0.14)
    }
    << c
}

