// Upstream: src/ui/widgets/styled_controls.xu
pub fn (progress &Progress) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    mut c := progress.style_or(styles)
    b := progress.bounds
    d := styles.density
    state := progress.visual_state()
    c.palette.foreground = c.palette.accent
    if progress.invalid { c.palette.foreground = c.palette.invalid }
    radius := c.radius * d
    if (c.shadow.value() & 255) > 0 {
        mut steps := 1
        if c.shadow_blur > 0.0 { steps = 8 }
        for i in 0:steps {
            spread := (c.shadow_spread + c.shadow_blur * f64(steps - i) / f64(steps)) * d
            box := layout.Rect{x: b.x + c.shadow_x * d - spread,y: b.y + c.shadow_y * d - spread,
                width: b.width + spread * 2.0,height: b.height + spread * 2.0}
            alpha := int(f64(c.shadow.value() & 255) / f64(steps))
            rounded_fill(frame,&box,radius + spread,c.shadow.with_alpha(alpha)) or >>
        }
    }
    resolved := c.resolve(state)
    rounded_fill(frame,&b,radius,resolved.background) or >>
    left := c.padding.left * d
    top := c.padding.top * d
    inner := layout.Rect{x: b.x + left,y: b.y + top,
        width: math.max(0.0,b.width - left - c.padding.right * d),
        height: math.max(0.0,b.height - top - c.padding.bottom * d)}
    inner_radius := math.max(0.0,radius - math.max(left,top))
    if progress.buffered {
        frame.push() or >>
        frame.clip_rect(inner.x,inner.y,inner.width*progress.buffer,inner.height) or >>
        rounded_fill(frame,&inner,inner_radius,fade_color(resolved.foreground,0.22)) or >>
        frame.pop() or >>
    }
    // Reveal the fully rounded indicator by clipping its fractional extent.
    frame.push() or >>
    frame.clip_rect(inner.x,inner.y,inner.width * progress.value,inner.height) or >>
    rounded_fill(frame,&inner,inner_radius,resolved.foreground) or >>
    frame.pop() or >>
    rounded_stroke(frame,&b,radius,resolved.border,c.border_width * d) or >>
    if (state & STATE_FOCUSED) != 0 && (state & STATE_DISABLED) == 0 {
        inset := c.focus_inset * d
        focus := layout.Rect{x: b.x + inset,y: b.y + inset,width: math.max(0.0,b.width - 2.0 * inset),height: math.max(0.0,b.height - 2.0 * inset)}
        rounded_stroke(frame,&focus,math.max(0.0,radius - inset),resolved.focus,c.focus_width * d) or >>
    }
    << 0
}

