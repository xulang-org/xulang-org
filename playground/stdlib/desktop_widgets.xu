    for i in 0:ids.len {
        if ids[i] <= 0 { >> errors.new("widgets: invalid focus id") }
        for j in 0:i { if ids[i] == ids[j] { >> errors.new("widgets: duplicate focus id") } }
    }
    << FocusGroup{identity: copy_identity(identity),ids: ids,current: 0,closed: false}
}

// Upstream: src/ui/widgets/scroll.xu
