// Upstream: src/ui/widgets/data_scrollbar.xu
fn (lb &ListBox) scrollbar_contains(x f64,y f64) bool {
    if lb.max_scroll() <= 0.0 { << false }
    b := lb.bounds
    width := math.min(24.0,b.width * 0.25)
    << x >= b.x + b.width - lb.padding.right - width && x < b.x + b.width - lb.padding.right &&
        y >= b.y + lb.padding.top && y < b.y + b.height - lb.padding.bottom
}

// Upstream: src/ui/widgets/data_scrollbar.xu
fn (lb &ListBox) scrollbar_thumb() layout.Rect {
    b := lb.bounds
    height := math.max(0.0,b.height - lb.padding.top - lb.padding.bottom)
    content := f64(lb.count_val) * lb.row_h
    thumb := math.min(height,math.max(24.0,height * height / math.max(1.0,content)))
    travel := math.max(0.0,height - thumb)
    y := b.y + lb.padding.top + travel * lb.scroll_y / math.max(1.0,lb.max_scroll())
    << layout.Rect{x: b.x + b.width - lb.padding.right - 6.0,y: y,width: 6.0,height: thumb}
}

// Upstream: src/ui/widgets/data_scrollbar.xu
fn (lb &mut ListBox) scrollbar_input(input &ui.InputEvent) Action {
    mut consumed := false
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && lb.scrollbar_contains(input.x,input.y) {
        thumb := lb.scrollbar_thumb()
        if input.y >= thumb.y && input.y < thumb.y + thumb.height {
            lb.scroll_dragging = true
            lb.scroll_grab = input.y - thumb.y
        } else {
            mut direction := 1.0
            if input.y < thumb.y { direction = -1.0 }
            page := math.max(lb.row_h,lb.bounds.height - lb.padding.top - lb.padding.bottom)
            lb.set_scroll_offset(lb.scroll_y + direction * page) or >>
        }
        lb.armed_idx = -1
        lb.hovered_idx = -1
        lb.dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_MOVE && lb.scroll_dragging {
        thumb := lb.scrollbar_thumb()
        height := math.max(0.0,lb.bounds.height - lb.padding.top - lb.padding.bottom)
        travel := math.max(1.0,height - thumb.height)
        ratio := (input.y - lb.bounds.y - lb.padding.top - lb.scroll_grab) / travel
        lb.set_scroll_offset(math.max(0.0,math.min(1.0,ratio)) * lb.max_scroll()) or >>
        consumed = true
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && lb.scroll_dragging {
        lb.scroll_dragging = false
        lb.dirty = true
        consumed = true
    }
    mut action := no_action(lb.id,lb.dirty)
    if consumed { action.kind = ACTION_SCROLL
        action.value = lb.scroll_y
        action.consumed = true
        action.request_focus = input.kind == ui.EV_POINTER_DOWN }
    << action
}

