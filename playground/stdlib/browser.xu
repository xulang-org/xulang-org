@playground

#ui/draw
#ui

// Browser-only driver: consume the next replayed click, or ok=0 at the end.
// The VM implements this intrinsic; desktop UI programs use App.event_ch.
pub fn next_click() draw.Click { <<< 1 }

// Widget driver: real ui.InputEvent, kind=0 marks replay exhaustion.
pub fn next_input() ui.InputEvent { <<< 1 }
pub fn canvas_identity() ui.CanvasEvent {
    << ui.CanvasEvent{window_id: 1,canvas_id: 1,generation: 1}
}
