        $delta := 0
        if event.dy > 0.0 { delta = max_int(1,int(event.dy / list.row_h)) }
        if event.dy < 0.0 { delta = min_int(-1,int(event.dy / list.row_h)) }
        list.first = max_int(0,min_int(max_int(0,list.shown.len - 8),list.first + delta))
        list.armed = -1
        list.dirty = true
        consumed = true
    } else if event.kind == ui.EV_KEY_DOWN && focused {
        $cursor := list.cursor
        if event.key == ui.KEY_ESCAPE { list.set_open(false)
            consumed = true }
        else if event.key == ui.KEY_UP { cursor = cursor - 1
            consumed = true }
        else if event.key == ui.KEY_DOWN { cursor = cursor + 1
            consumed = true }
        else if event.key == ui.KEY_PAGE_UP { cursor = cursor - 8
            consumed = true }
        else if event.key == ui.KEY_PAGE_DOWN { cursor = cursor + 8
            consumed = true }
        else if event.key == ui.KEY_HOME { cursor = 0
            consumed = true }
        else if event.key == ui.KEY_END { cursor = list.shown.len - 1
            consumed = true }
        else if event.key == ui.KEY_ENTER || (multiple && event.key == 32) {
            consumed = true
            if event.repeat == 0 && list.shown.len > 0 { chosen = list.shown[list.cursor] }
