}

// Upstream: src/ui/widgets/chart.xu
pub fn (c &Chart) viewport() ChartDomain { << chart_copy_domain(&c.viewport) }

// Upstream: src/ui/widgets/chart.xu
pub fn (c &Chart) visible_domain() ChartDomain {
    << ChartDomain{x_min: motion_lerp(c.domain.x_min,c.domain.x_max,c.viewport.x_min),x_max: motion_lerp(c.domain.x_min,c.domain.x_max,c.viewport.x_max),
        y_min: motion_lerp(c.domain.y_min,c.domain.y_max,c.viewport.y_min),y_max: motion_lerp(c.domain.y_min,c.domain.y_max,c.viewport.y_max)}
}

// Upstream: src/ui/widgets/chart_data.xu
pub fn (d &ChartDomain) validate() int {
    if !chart_number(d.x_min) || !chart_number(d.x_max) || !chart_number(d.y_min) || !chart_number(d.y_max) ||
       d.x_max - d.x_min < 0.000000001 || d.y_max - d.y_min < 0.000000001 { >> errors.new("widgets: invalid chart domain") }
    << 0
}

// Upstream: src/ui/widgets/locale.xu
pub fn (locale &Locale) clone() Locale {
    $values := []string{}
    for value in locale.values { values.push(value + "") }
    << Locale{values: values}
}

// Upstream: src/ui/widgets/animation.xu
pub fn (options &AnimationOptions) validate() int {
    if options.duration.nanoseconds() <= 0 || options.duration.nanoseconds() > 3600 * time.second() ||
       options.delay.is_negative() || options.delay.nanoseconds() > 3600 * time.second() ||
       options.iterations < 0 || options.iterations > 10000 || (math.is_nan(options.rate) || math.is_inf(options.rate)) || options.rate <= 0.0 || options.rate > 16.0 ||
       options.curve < EASE_LINEAR || options.curve > EASE_IN_QUINT { >> errors.new("widgets: invalid animation options") }
    << 0
}

// Upstream: src/ui/widgets/chart_data.xu
pub fn (s &ChartSeries) clone() ChartSeries {
    $points := []ChartPoint{}
    for p in s.points { points.push(ChartPoint{id: p.id,x: p.x,y: p.y,label: p.label + ""}) }
    << ChartSeries{id: s.id,name: s.name + "",kind: s.kind,points: points,color: s.color,custom_color: s.custom_color,
        visible: s.visible,line_width: s.line_width,symbol_size: s.symbol_size,smooth: s.smooth}
}

// Upstream: src/ui/widgets/animation.xu
pub fn animation_controller(options &AnimationOptions) AnimationController {
    options.validate() or >>
    << AnimationController{options: AnimationOptions{duration: options.duration,delay: options.delay,
        iterations: options.iterations,alternate: options.alternate,curve: options.curve,rate: options.rate},
        state: ANIMATION_IDLE,phase: 0.0,delay_left: 0.0,direction: 1.0,stamp: time.zero_instant()}
}

// Upstream: src/ui/widgets/animation.xu
pub fn animation_options() AnimationOptions {
    << AnimationOptions{duration: time.duration(240 * time.millisecond()),delay: time.duration(0),iterations: 1,
        alternate: false,curve: EASE_OUT_QUART,rate: 1.0}
}

// Upstream: src/ui/widgets/chart.xu
pub fn chart(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect) Chart {
    control := button(identity,id,bounds) or >>
    domain := chart_domain(0.0,1.0,0.0,1.0) or >>
    options := animation_options()
    << Chart{control: control,series: []ChartSeries{},disabled_series: 0,data: []ChartDatum{},bar_steps: []f64{},appearance: chart_appearance(),locale: locale_default(),
        labels: text_cache(context),animation: animation_controller(&options) or >>,motion: motion_spec(),emphasis: tween(0.0) or >>,
        domain: domain,from_domain: domain,target_domain: domain,fixed_domain: false,viewport: domain,plot: copy_rect(bounds),
        legend_boxes: []layout.Rect{},hot: -1,selected: -1,armed: -1,dragging: false,moved: false,drag_x: 0.0,drag_y: 0.0,
        drag_view: domain,now: time.zero_instant(),reduced: false}
}

