// Upstream: src/ui/widgets/tree_view.xu
pub fn (t &TreeView) selected() int {
    if t.update_depth > 0 { << t.pending_selected }
    index := t.rows.selected_val
    if index < 0 || index >= t.visible.len { << -1 }
    << t.visible[index]
}

// Upstream: src/ui/widgets/tree_view.xu
pub fn (t &TreeView) style_or(styles &Styles) ControlStyle {
    if t.rows.has_style() { << t.rows.style_or(styles) }
    << styles.tree_style()
}

// Upstream: src/ui/widgets/tree_view.xu
pub fn (t &TreeView) text(node int) string {
    if node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    << t.values[node] + ""
}

// Upstream: src/ui/widgets/tree_view.xu
pub fn (t &TreeView) visible_count() int { << t.visible.len }

// Upstream: src/ui/widgets/appearance.xu
pub fn tree_appearance() TreeAppearance {
    << TreeAppearance{indent: 20.0,row_height: 32.0,guides: false,icons: true,
        selection_mark: true,guide_opacity: 0.4,action_width: 28.0}
}

// Upstream: src/ui/widgets/tree_view.xu
pub fn tree_view(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect) TreeView {
    if !context.matches_canvas(identity) { >> errors.new("widgets: tree context mismatch") }
    rows := list_box(identity,id,bounds,0,-1) >>>
    labels := text_cache(context)
    secondary := text_cache(context)
    appearance := tree_appearance()
    motion := motion_spec()
    << TreeView{rows: rows,parents: []int{},depths: []int{},expanded: []bool{},values: []string{},visible: []int{},
        labels: labels,density: 1.0,indent: 20.0,armed_node: -1,armed_action: -1,appearance: appearance,
        first_children: []int{},last_children: []int{},next_nodes: []int{},root_first: -1,root_last: -1,
        metadata: []string{},icons: []int{},actions: []bool{},secondary: secondary,filter_text: "",
        update_depth: 0,pending_selected: -1,rotations: []Tween{},motion_ready: false,motion: motion}
}

// Upstream: src/ui/widgets/appearance.xu
pub struct TreeAppearance {
    pub indent f64
    pub row_height f64
    pub guides bool
    pub icons bool
    pub selection_mark bool
    pub guide_opacity f64
    pub action_width f64
}

// Upstream: src/ui/widgets/tree_view.xu
pub struct TreeView {
    rows ListBox
    parents []int
    depths []int
    expanded []bool
    values []string
    visible []int
    labels TextCache
    density f64
    indent f64
    armed_node int
    armed_action int
    appearance TreeAppearance
    first_children []int
    last_children []int
    next_nodes []int
    root_first int
    root_last int
    metadata []string
    icons []int
    actions []bool
    secondary TextCache
    filter_text string
    update_depth int
    pending_selected int
    rotations []Tween
    motion_ready bool
    motion MotionSpec
}

