@main

#net
#net/http
#os
#strings

struct Reply {
    status int
    ctype string
    body string
}

fn ok_html(body string) Reply {
    << Reply{status: 200, ctype: "text/html; charset=utf-8", body: body}
}

fn not_found_page(path string) Reply {
    en := is_en_path(path + "")
    mut title := "未找到"
    mut body := "<h1>没有这一页</h1><p>路径 <code>" + esc_text(path + "") + "</code> 没有对应文档。</p><p><a href=\"/\">回首页</a></p>"
    if en {
        title = "Not found"
        body = "<h1>Not found</h1><p>No page at <code>" + esc_text(path + "") + "</code>.</p><p><a href=\"/en\">Home</a></p>"
    }
    html := render_doc(title, path, body)
    << Reply{status: 404, ctype: "text/html; charset=utf-8", body: html}
}

fn take_title(raw string) string {
    pre := "<!--title:"
    if !strings.has_prefix(&raw, pre) {
        << ""
    }
    rest := raw[pre.len:raw.len]
    mut i := 0
    while i + 2 < rest.len {
        if (rest[i] & 255) == 45 && (rest[i + 1] & 255) == 45 && (rest[i + 2] & 255) == 62 {
            t := rest[0:i]
            << strings.trim_space(&t)
        }
        i = i + 1
    }
    << ""
}

fn take_body(raw string) string {
    pre := "<!--title:"
    if !strings.has_prefix(&raw, pre) {
        << raw + ""
    }
    mut i := 0
    while i + 2 < raw.len {
        if (raw[i] & 255) == 45 && (raw[i + 1] & 255) == 45 && (raw[i + 2] & 255) == 62 {
            << raw[(i + 3):raw.len]
        }
        i = i + 1
    }
    << raw + ""
}

fn file_for(path string) string {
    p := strip_slash(path + "")
    lang := lang_of(p + "")
    rest := rest_path(p)
    if rest == "/" || rest.len == 0 {
        << content_dir() + "/" + lang + "/home.html"
    }
    rel := rest[1:rest.len]
    if !is_safe_rel(rel + "") {
        << ""
    }
    a := content_dir() + "/" + lang + "/" + rel + ".html"
    os.stat(a + "") or (err) {
        << content_dir() + "/" + lang + "/" + rel + "/index.html"
    }
    << a
}

fn is_home(path string) bool {
    p := strip_slash(path)
    if p == "/" {
        << true
    }
    if p == "/en" {
        << true
    }
    << false
}

fn is_static(path string) bool {
    if path == "/site.css" {
        << true
    }
    if path == "/xu_classic.svg" {
        << true
    }
    if path == "/xu-play.wasm" {
        << true
    }
    if path == "/xu-play.js" {
        << true
    }
    if strings.has_prefix(&path, "/releases/") {
        << true
    }
    if strings.has_prefix(&path, "/fonts/") {
        << true
    }
    << false
}

fn serve_static(path string) Reply {
    mut name := path[1:path.len]
    if !is_safe_rel(name + "") {
        << Reply{status: 403, ctype: "text/plain; charset=utf-8", body: "forbidden\n"}
    }
    full := www_dir() + "/" + name
    raw := os.read(full) or (err) {
        << Reply{status: 404, ctype: "text/plain; charset=utf-8", body: "missing\n"}
    }
    << Reply{status: 200, ctype: ctype_of(name), body: raw}
}

fn serve_page(path0 string) Reply {
    path := path0 + ""
    f := file_for(path + "")
    if f.len == 0 {
        << not_found_page(path)
    }
    raw := os.read(f) or (err) {
        << not_found_page(path + "")
    }
    mut title := take_title(raw + "")
    body := take_body(raw)
    if title.len == 0 {
        title = "Xu"
    }
    mut html := ""
    if is_home(path + "") {
        html = render_home(title, path + "", body)
    } else {
        html = render_doc(title, path, body)
    }
    << ok_html(html)
}

fn dispatch(method string, path string) Reply {
    if method != "GET" && method != "HEAD" {
        << Reply{status: 405, ctype: "text/plain; charset=utf-8", body: "method not allowed\n"}
    }
    if is_static(path + "") {
        << serve_static(path)
    }
    << serve_page(path)
}

fn handle_http(fd int) {
    mut req := http.new_request()
    req.read(fd) or (err) {
        msg := err.msg()
        http.write(fd, 400, "text/plain; charset=utf-8", &msg) or (e2) { << }
        net.conn_close(fd) or (e3) { << }
        <<
    }
    qraw := req.path()
    method := req.method()
    path := cut_query(qraw[0:qraw.len])
    out := dispatch(method, path)
    http.write(fd, out.status, out.ctype, &out.body) or (err) { << }
    net.conn_close(fd) or (err) { << }
}
